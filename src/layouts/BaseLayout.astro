---
import "../styles/global.css";
import "../styles/consent.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  lang?: string;
  dir?: "ltr" | "rtl";
  canonicalPath?: string;
  image?: string;
  noindex?: boolean;
  hasLocalizedVersions?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  lang = "en",
  dir = lang === "ar" ? "rtl" : "ltr",
  canonicalPath = Astro.url.pathname,
  image = "/og-default.svg",
  noindex = false,
  hasLocalizedVersions = false,
  schema,
} = Astro.props;

const site = "https://blutech.io";
const canonical = new URL(canonicalPath, site).toString();
const cleanPath = canonicalPath.replace(/^\/(zh-hk|zh-cn|ar)(?=\/|$)/, "") || "/";
const localePath = (locale: string) => locale === "en" ? cleanPath : `/${locale}${cleanPath === "/" ? "/" : cleanPath}`;
const alternateLocales = ["en", "zh-HK", "zh-CN", "ar"] as const;
const localizedCoreRoutes = new Set(["/","/solutions","/products","/software","/projects","/technology","/company","/resources","/contact"]);
const emitHreflang = hasLocalizedVersions || localizedCoreRoutes.has(cleanPath.replace(/\/$/,"") || "/");

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "Corporation"],
  name: "Blutech IoT Limited",
  alternateName: "Blutech",
  url: site,
  email: "enquiry@blutech.io",
  foundingDate: "2019",
  slogan: "Building AI and IoT for real buildings.",
  description: "Building technology company founded in Hong Kong in 2019, connecting sensors, Bluetooth edge control, LoRaWAN, 4G/IP, Blutech Halo, Blutech Core and building-system integrations.",
  areaServed: ["Hong Kong", "Greater Bay Area", "Qatar", "Middle East"],
  knowsAbout: ["Building AI", "Building IoT", "Smart washroom", "Privacy-preserving occupancy sensing", "LoRaWAN", "Bluetooth edge control", "Indoor air quality", "Water leakage monitoring", "Smart lighting", "Building management system integration"],
  location: [
    { "@type": "Place", name: "Hong Kong headquarters", address: { "@type": "PostalAddress", addressLocality: "Hong Kong", addressCountry: "HK" } },
    { "@type": "Place", name: "Dongguan R&D office", address: { "@type": "PostalAddress", addressLocality: "Dongguan", addressCountry: "CN" } },
    { "@type": "Place", name: "Qatar office", address: { "@type": "PostalAddress", addressCountry: "QA" } }
  ],
  award: ["Hong Kong ICT Awards 2020 recognition", "APICTA 2021 recognition", "iF DESIGN AWARD 2024 — BLUTECH.IO Smart Washroom AIoT Solution", "Smart Living Partnership Awards 2023/24 recognition"],
  brand: [
    { "@type": "Brand", name: "Blutech Halo" },
    { "@type": "Brand", name: "Blutech Core" },
    { "@type": "Brand", name: "BLUTA", slogan: "For fire safety", url: "https://bluta.io" }
  ]
};
const websiteSchema = { "@context":"https://schema.org", "@type":"WebSite", name:"Blutech", url:site, inLanguage:["en","zh-HK","zh-CN","ar"] };
const schemas = Array.isArray(schema) ? [organizationSchema, websiteSchema, ...schema] : schema ? [organizationSchema, websiteSchema, schema] : [organizationSchema, websiteSchema];
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const consentCopy:Record<string,{text:string,accept:string,decline:string}> = {
  en:{text:"We use optional analytics to understand website performance and enquiries. No advertising tracking.",accept:"Allow analytics",decline:"Decline"},
  "zh-hk":{text:"我們只使用可選的網站分析來了解網站表現及查詢轉換，不使用廣告追蹤。",accept:"允許分析",decline:"拒絕"},
  "zh-cn":{text:"我们只使用可选的网站分析来了解网站表现及咨询转化，不使用广告追踪。",accept:"允许分析",decline:"拒绝"},
  ar:{text:"نستخدم تحليلات اختيارية لفهم أداء الموقع والاستفسارات، من دون تتبع إعلاني.",accept:"السماح بالتحليلات",decline:"رفض"}
};
const cc = consentCopy[lang] || consentCopy.en;
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07131f" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    {emitHreflang && alternateLocales.map((locale) => {
      const key = locale === "zh-HK" ? "zh-hk" : locale === "zh-CN" ? "zh-cn" : locale;
      return <link rel="alternate" hreflang={locale} href={new URL(localePath(key), site).toString()} />;
    })}
    {emitHreflang && <link rel="alternate" hreflang="x-default" href={new URL(cleanPath, site).toString()} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Blutech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "zh-hk" ? "zh_HK" : lang === "zh-cn" ? "zh_CN" : lang === "ar" ? "ar_QA" : "en_HK"} />
    <meta property="og:image" content={new URL(image, site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site).toString()} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader lang={lang} path={Astro.url.pathname} />
    <main id="main"><slot /></main>
    <SiteFooter lang={lang} />
    {gaId && <aside id="analytics-consent" class="consent-banner" hidden aria-label="Analytics preference"><p>{cc.text} <a href="/privacy">Privacy</a></p><div><button class="button small" id="analytics-accept" type="button">{cc.accept}</button><button class="button secondary small" id="analytics-decline" type="button">{cc.decline}</button></div></aside>}
    {gaId && <script is:inline define:vars={{ gaId }}>
      (() => {
        const consentKey = 'blutech_analytics_consent';
        const banner = document.getElementById('analytics-consent');
        let loaded = false;
        function loadAnalytics(){
          if (loaded) return;
          loaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', gaId, { anonymize_ip:true, allow_google_signals:false, allow_ad_personalization_signals:false });
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
          document.head.appendChild(script);
        }
        window.blutechTrack = function(eventName, params={}){
          if (localStorage.getItem(consentKey) === 'granted') {
            loadAnalytics();
            window.gtag?.('event', eventName, params);
          }
        };
        const preference = localStorage.getItem(consentKey);
        if (preference === 'granted') loadAnalytics();
        else if (!preference && banner) banner.hidden = false;
        document.getElementById('analytics-accept')?.addEventListener('click',()=>{
          localStorage.setItem(consentKey,'granted'); loadAnalytics(); if (banner) banner.hidden = true;
        });
        document.getElementById('analytics-decline')?.addEventListener('click',()=>{
          localStorage.setItem(consentKey,'denied'); if (banner) banner.hidden = true;
        });
        document.addEventListener('click',(event)=>{
          const target = event.target instanceof Element ? event.target.closest('a') : null;
          if (!(target instanceof HTMLAnchorElement)) return;
          const url = new URL(target.href, location.href);
          if (url.hostname !== location.hostname) window.blutechTrack?.('outbound_click',{destination:url.hostname,path:url.pathname});
          if (/\.(pdf|docx?|xlsx?|pptx?|zip)$/i.test(url.pathname)) window.blutechTrack?.('file_download',{file_name:url.pathname.split('/').pop()});
        });
      })();
    </script>}
  </body>
</html>
