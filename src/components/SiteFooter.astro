---
interface Props { lang?: string; }
const { lang = "en" } = Astro.props;
const prefix = lang === "en" ? "" : `/${lang}`;
const copy = {
  en: { intro:"Building AI and IoT for real buildings.", bluta:"BLUTA is Blutech's dedicated brand for fire safety.", privacy:"Privacy", terms:"Terms", software:"Software", explore:"Explore", solutions:"Solutions", products:"Products", projects:"Projects", company:"Company", visit:"Visit bluta.io", rights:"All rights reserved." },
  "zh-hk": { intro:"為真實樓宇而設的建築人工智能與物聯網。", bluta:"BLUTA 是 Blutech 專注消防安全的品牌。", privacy:"私隱政策", terms:"條款", software:"軟件", explore:"瀏覽", solutions:"解決方案", products:"產品", projects:"項目", company:"公司", visit:"前往 bluta.io", rights:"版權所有。" },
  "zh-cn": { intro:"为真实楼宇而设的建筑人工智能与物联网。", bluta:"BLUTA 是 Blutech 专注消防安全的品牌。", privacy:"隐私政策", terms:"条款", software:"软件", explore:"浏览", solutions:"解决方案", products:"产品", projects:"项目", company:"公司", visit:"前往 bluta.io", rights:"版权所有。" },
  ar: { intro:"الذكاء الاصطناعي وإنترنت الأشياء للمباني الحقيقية.", bluta:"BLUTA هي علامة Blutech المتخصصة في السلامة من الحريق.", privacy:"الخصوصية", terms:"الشروط", software:"البرمجيات", explore:"استكشف", solutions:"الحلول", products:"المنتجات", projects:"المشاريع", company:"الشركة", visit:"زيارة bluta.io", rights:"جميع الحقوق محفوظة." }
}[lang] || null;
const t = copy || { intro:"Building AI and IoT for real buildings.", bluta:"BLUTA is Blutech's dedicated brand for fire safety.", privacy:"Privacy", terms:"Terms", software:"Software", explore:"Explore", solutions:"Solutions", products:"Products", projects:"Projects", company:"Company", visit:"Visit bluta.io", rights:"All rights reserved." };
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand brand-image" href={prefix || "/"} aria-label="Blutech"><img src="/blutech-logo.svg" alt="Blutech" width="151" height="31" /></a>
      <p>{t.intro}</p>
      <p class="muted">© {new Date().getFullYear()} Blutech IoT Limited. {t.rights}</p>
    </div>
    <div>
      <strong>{t.software}</strong>
      <a href={`${prefix}/software#halo`}>Blutech Halo</a>
      <a href={`${prefix}/software#core`}>Blutech Core</a>
    </div>
    <div>
      <strong>{t.explore}</strong>
      <a href={`${prefix}/solutions`}>{t.solutions}</a>
      <a href={`${prefix}/products`}>{t.products}</a>
      <a href={`${prefix}/projects`}>{t.projects}</a>
      <a href={`${prefix}/company`}>{t.company}</a>
    </div>
    <div>
      <strong>BLUTA</strong>
      <p class="muted">{t.bluta}</p>
      <a href="https://bluta.io" rel="noopener" target="_blank">{t.visit} ↗</a>
      <a href="mailto:enquiry@blutech.io">enquiry@blutech.io</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <a href="/privacy">{t.privacy}</a>
    <a href="/terms">{t.terms}</a>
  </div>
</footer>
