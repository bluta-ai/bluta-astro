---
interface Props { lang?: string; path?: string; }
const { lang = "en", path = "/" } = Astro.props;
const labels: Record<string, Record<string,string>> = {
  en: { solutions:"Solutions", products:"Products", software:"Software", projects:"Projects", technology:"Technology", company:"Company", resources:"Resources", contact:"Contact" },
  "zh-hk": { solutions:"解決方案", products:"產品", software:"軟件", projects:"項目", technology:"技術", company:"公司", resources:"資源", contact:"聯絡" },
  "zh-cn": { solutions:"解决方案", products:"产品", software:"软件", projects:"项目", technology:"技术", company:"公司", resources:"资源", contact:"联系" },
  ar: { solutions:"الحلول", products:"المنتجات", software:"البرمجيات", projects:"المشاريع", technology:"التقنية", company:"الشركة", resources:"المصادر", contact:"تواصل" },
};
const l = labels[lang] || labels.en;
const prefix = lang === "en" ? "" : `/${lang}`;
const home = prefix || "/";
const nav = [
  ["solutions", `${prefix}/solutions`], ["products", `${prefix}/products`], ["software", `${prefix}/software`],
  ["projects", `${prefix}/projects`], ["technology", `${prefix}/technology`], ["company", `${prefix}/company`], ["resources", `${prefix}/resources`]
];
const clean = path.replace(/^\/(zh-hk|zh-cn|ar)(?=\/|$)/, "") || "/";
const localeHref = (code:string) => code === "en" ? clean : `/${code}${clean === "/" ? "/" : clean}`;
---
<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand" href={home} aria-label="Blutech home"><span class="brand-blu">blu</span><span>tech</span><span class="brand-dot">.</span></a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map(([key, href]) => <a class={path === href ? "active" : ""} href={href}>{l[key]}</a>)}
    </nav>
    <div class="nav-actions">
      <details class="language-menu">
        <summary aria-label="Choose language">{lang === "zh-hk" ? "繁" : lang === "zh-cn" ? "简" : lang === "ar" ? "AR" : "EN"}</summary>
        <div class="language-popover">
          <a href={localeHref("en")}>English</a>
          <a href={localeHref("zh-hk")}>繁體中文</a>
          <a href={localeHref("zh-cn")}>简体中文</a>
          <a href={localeHref("ar")}>العربية</a>
        </div>
      </details>
      <a class="button small" href={`${prefix}/contact`}>{l.contact}</a>
      <details class="mobile-menu">
        <summary aria-label="Open menu">Menu</summary>
        <nav aria-label="Mobile navigation">
          {nav.map(([key, href]) => <a href={href}>{l[key]}</a>)}
          <a href={`${prefix}/contact`}>{l.contact}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
