---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
export function getStaticPaths(){ return projects.map((project)=>({params:{slug:project.slug},props:{project}})); }
const { project } = Astro.props;
const schema = {"@context":"https://schema.org","@type":"WebPage",name:`${project.title} — Blutech project`,description:project.outcome,url:`https://blutech.io/projects/${project.slug}`,about:{"@type":"Service",name:"Building IoT and AIoT deployment",provider:{"@type":"Organization",name:"Blutech IoT Limited"}}};
---
<BaseLayout title={`${project.title} | Blutech Project`} description={project.outcome} canonicalPath={`/projects/${project.slug}`} schema={schema} image={project.image} hasLocalizedVersions={true}>
  <section class="case-hero"><div class="shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><a href="/projects">Projects</a><span>›</span><span>{project.title}</span></div><div class="case-title"><div><div class="kicker">{project.category} · {project.location}</div><h1>{project.title}</h1><p>{project.summary}</p></div><div class="case-outcome"><span>Operational outcome</span><strong>{project.outcome}</strong></div></div><img src={project.image} alt={`${project.title} project`} width="1600" height="1000" fetchpriority="high" /></div></section>

  <section class="case-proof"><div class="shell"><div class="kpi-row">{project.kpis.map((k)=><div><strong>{k.value}</strong><span>{k.label}</span></div>)}</div></div></section>

  <section class="case-scope"><div class="shell scope-grid"><div><div class="kicker">Confirmed project scope</div><h2>What Blutech delivered.</h2><p>Only confirmed, operating scope is included. Proposed or unrelated functions are not presented as delivered work.</p></div><ul>{project.delivered.map((item)=><li>{item}</li>)}</ul></div></section>

  <section class="case-benefits"><div class="shell"><div class="compact-title"><div class="kicker">Value to the property</div><h2>Benefits that can be understood at a glance.</h2></div><div class="benefit-cards">{project.benefits.map((b,i)=><article><span>0{i+1}</span><h3>{b.title}</h3><p>{b.body}</p></article>)}</div>{project.software?.length && <div class="software-line"><b>Software</b>{project.software.map((s)=><span>{s}</span>)}</div>}{project.note && <p class="scope-note">Scope note: {project.note}</p>}</div></section>

  <section class="case-cta"><div class="shell cta-panel"><div><div class="kicker">Plan a deployment</div><h2>Bring the building problem, floorplan and integration boundary.</h2><p>Blutech can define the sensing, edge response, network, software and handover around the property.</p></div><a class="button" href={`/contact?project=${project.slug}`}>Discuss a project</a></div></section>
</BaseLayout>
<style>
.case-hero{padding:42px 0 0;background:#fff}.case-title{display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:end;padding:32px 0 38px}.case-title h1{font-size:clamp(48px,5.5vw,76px);line-height:.98;letter-spacing:-.055em;margin:9px 0 18px}.case-title p{font-size:18px;color:var(--muted);max-width:720px}.case-outcome{border-left:2px solid var(--brand);padding-left:22px}.case-outcome span{font-size:10px;text-transform:uppercase;letter-spacing:.13em;color:var(--brand-2);font-weight:850}.case-outcome strong{display:block;font-size:18px;line-height:1.45;margin-top:8px}.case-hero img{width:100%;height:min(58vw,650px);object-fit:cover}.case-proof{padding:0;background:#fff}.kpi-row{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-top:0}.kpi-row div{padding:22px}.kpi-row div+div{border-left:1px solid var(--line)}.kpi-row strong,.kpi-row span{display:block}.kpi-row strong{font-size:29px;letter-spacing:-.04em}.kpi-row span{font-size:12px;color:var(--muted)}.scope-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:80px}.scope-grid h2,.compact-title h2,.cta-panel h2{font-size:clamp(36px,4vw,54px);line-height:1.03;letter-spacing:-.045em;margin:9px 0 15px}.scope-grid p{color:var(--muted)}.scope-grid ul{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}.scope-grid li{padding:15px 0;border-bottom:1px solid var(--line);font-size:16px}.scope-grid li::before{content:"✓";color:var(--brand-2);margin-right:12px}.case-benefits{background:#eef0ed}.benefit-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:30px}.benefit-cards article{background:#fff;padding:28px}.benefit-cards span{font-size:10px;color:var(--brand-2);font-weight:900}.benefit-cards h3{font-size:23px;margin:26px 0 10px}.benefit-cards p{font-size:14px;color:var(--muted);margin:0}.software-line{display:flex;align-items:center;gap:8px;margin-top:24px}.software-line b{font-size:12px;margin-right:8px}.software-line span{border:1px solid var(--line);background:#fff;padding:7px 9px;font-size:11px}.scope-note{font-size:12px;color:#5b6266;border-left:2px solid #d71920;padding-left:13px;margin-top:22px}.case-cta{background:#151718;color:#fff}.cta-panel{display:flex;align-items:end;justify-content:space-between;gap:50px}.cta-panel p{color:#b9c1c3}.cta-panel .button{background:#fff;color:#111;border-color:#fff}
@media(max-width:850px){.case-title,.scope-grid{grid-template-columns:1fr;gap:28px}.case-outcome{margin-bottom:10px}.benefit-cards{grid-template-columns:1fr}.kpi-row{grid-template-columns:1fr}.kpi-row div+div{border-left:0;border-top:1px solid var(--line)}.cta-panel{display:block}.cta-panel .button{margin-top:20px}}
</style>
