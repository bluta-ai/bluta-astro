---
import BaseLayout from "../layouts/BaseLayout.astro";
import hk from "../assets/office-hong-kong.webp";
import dg from "../assets/office-dongguan.webp";
import qa from "../assets/office-qatar.webp";
import ifAward from "../assets/if-Design-Award.webp";
import { deploymentSites } from "../data/projects";
---
<BaseLayout title="About Blutech | Building AI and IoT Since 2019" description="Blutech IoT Limited develops connected building hardware, software and integrations from Hong Kong, with R&D in Dongguan and a Qatar office supporting the Middle East." canonicalPath="/company">
  <section class="page-hero company-intro"><div class="shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Company</span></div><div class="kicker">Blutech IoT Limited · Since 2019</div><h1>Building AI and IoT that works in the real property.</h1><p>We design and deliver the full connected-building layer — sensors, edge control, networks, Halo, Core and integration — around the way owners and property teams actually operate.</p></div></section>

  <section class="company-story"><div class="shell story-grid"><div><div class="kicker">What we do</div><h2>From a field signal to an operating decision.</h2></div><div><p>Blutech began in Hong Kong in 2019 with a practical belief: building intelligence is only useful when the sensing is accurate, the local response is dependable and the result is clear to the people running the property.</p><p>That is why we work across hardware, firmware, wireless design, edge logic, software, APIs and site delivery — including cloud, private-cloud and on-premise deployment models where required.</p><div class="brand-lines"><span><b>Blutech</b>Building AI and IoT</span><span><b>Blutech Halo</b>Building intelligence and management</span><span><b>Blutech Core</b>IoT devices and integration</span><span><b>BLUTA</b>For fire safety</span></div></div></div></section>

  <section class="offices"><div class="shell"><div class="compact-head"><div><div class="kicker">Where we work</div><h2>Close to product, projects and customers.</h2></div></div><div class="office-grid"><article><img src={hk.src} alt="Hong Kong skyline" loading="lazy" /><div><span>Headquarters</span><h3>Hong Kong</h3><p>Product strategy, project delivery, commercial leadership and customer support.</p></div></article><article><img src={dg.src} alt="Dongguan modern city and technology district" loading="lazy" /><div><span>R&D office</span><h3>Dongguan</h3><p>Hardware engineering, firmware, prototyping, testing and product development.</p></div></article><article><img src={qa.src} alt="Doha skyline in Qatar" loading="lazy" /><div><span>Regional office</span><h3>Qatar</h3><p>Project development and customer support for the Middle East.</p></div></article></div></div></section>

  <section class="awards"><div class="shell"><div class="compact-head"><div><div class="kicker">Recognition</div><h2>Awards connected to confirmed work.</h2><p>Award wording is kept at the company or solution level unless an official record names an exact product.</p></div><img class="if-mark" src={ifAward.src} alt="iF Design Award" loading="lazy" /></div><div class="award-grid"><article><span>2020</span><h3>Hong Kong ICT Awards</h3><p>Award of the Year and ICT Startup Grand Award recognition for the Smart Washroom AIoT Solution.</p></article><article><span>2021</span><h3>APICTA</h3><p>Start Up of the Year recognition for the Blutech smart-washroom solution.</p></article><article class="if-card"><span>2024</span><h3>iF DESIGN AWARD</h3><p>Winner — “BLUTECH.IO Smart Washroom AIoT Solution”, Product / Building Technology.</p></article><article><span>2023/24</span><h3>Smart Living Partnership Awards</h3><p>Outstanding B2B IoT Solutions recognition.</p></article></div></div></section>

  <section class="deployments" id="deployments"><div class="shell"><div class="deployment-head"><div><div class="kicker">Deployment network</div><h2>Deployed across the buildings Hong Kong relies on.</h2></div><p>Selected named deployment sites are listed as searchable text so people and AI systems can understand the breadth of Blutech’s operating experience. Inclusion indicates a Blutech deployment at the site; the exact scope varies by project.</p></div><div class="deployment-groups">{Object.entries(deploymentSites).map(([group,sites])=><section><h3>{group}</h3><ul>{sites.map((site)=><li>{site}</li>)}</ul></section>)}</div></div></section>

  <section class="company-cta"><div class="shell cta-panel"><div><div class="kicker">Work with Blutech</div><h2>Have a building problem that does not fit a catalogue?</h2><p>That is usually where our engineering work starts.</p></div><a class="button" href="/contact">Talk to Blutech</a></div></section>
</BaseLayout>
<style>
.company-intro h1{font-size:clamp(46px,5vw,70px);max-width:1000px}.story-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px}.story-grid h2,.compact-head h2,.deployment-head h2,.cta-panel h2{font-size:clamp(36px,4vw,54px);line-height:1.03;letter-spacing:-.045em;margin:9px 0 14px}.story-grid p{font-size:17px;color:var(--muted)}.brand-lines{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);margin-top:30px}.brand-lines span{background:#fff;padding:17px;font-size:11px;color:var(--muted)}.brand-lines b{display:block;color:var(--ink);font-size:15px;margin-bottom:3px}.offices{background:#eef0ed}.compact-head{display:flex;align-items:end;justify-content:space-between;gap:45px;margin-bottom:32px}.office-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.office-grid article{background:#fff}.office-grid img{width:100%;aspect-ratio:16/10;object-fit:cover}.office-grid article>div{padding:22px}.office-grid span{font-size:10px;color:var(--brand-2);font-weight:850;text-transform:uppercase;letter-spacing:.1em}.office-grid h3{font-size:30px;margin:8px 0}.office-grid p{font-size:13px;color:var(--muted)}.awards{background:#fff}.if-mark{width:92px;height:92px;object-fit:contain}.award-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.award-grid article{background:#fff;padding:24px}.award-grid span{font-size:11px;color:var(--brand-2);font-weight:900}.award-grid h3{font-size:20px;margin:26px 0 9px}.award-grid p{font-size:12px;color:var(--muted)}.award-grid .if-card{border-top:3px solid #d71920}.award-grid .if-card h3,.award-grid .if-card span{color:#d71920}.deployments{background:#f0f1ee}.deployment-head{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:end}.deployment-head p{color:var(--muted);font-size:14px}.deployment-groups{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:38px}.deployment-groups section{background:#fff;padding:24px}.deployment-groups h3{font-size:18px;margin:0 0 16px}.deployment-groups ul{columns:1;margin:0;padding:0;list-style:none}.deployment-groups li{font-size:12px;padding:7px 0;border-top:1px solid var(--line);color:#454d51}.company-cta{background:#151718;color:#fff}.cta-panel{display:flex;align-items:end;justify-content:space-between;gap:50px}.cta-panel p{color:#b9c1c3}.cta-panel .button{background:#fff;color:#111;border-color:#fff}
@media(max-width:950px){.story-grid,.deployment-head{grid-template-columns:1fr;gap:28px}.office-grid,.deployment-groups{grid-template-columns:1fr 1fr}.award-grid{grid-template-columns:1fr 1fr}}@media(max-width:650px){.brand-lines,.office-grid,.deployment-groups,.award-grid{grid-template-columns:1fr}.compact-head{align-items:flex-start}.cta-panel{display:block}.cta-panel .button{margin-top:18px}}
</style>
