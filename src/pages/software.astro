---
import BaseLayout from "../layouts/BaseLayout.astro";
const softwareSchema = [
  {"@context":"https://schema.org","@type":"SoftwareApplication",name:"Blutech Halo",applicationCategory:"BusinessApplication",operatingSystem:"Web",description:"Building intelligence and management platform for live status, floorplans, alerts, work orders, trends, reports and authorised controls."},
  {"@context":"https://schema.org","@type":"SoftwareApplication",name:"Blutech Core",applicationCategory:"BusinessApplication",operatingSystem:"Web",description:"IoT device and integration platform for registry, provisioning, connectivity, configuration, rules, payloads, APIs and audit."}
];
---
<BaseLayout title="Blutech Halo & Core | Building Software" description="Halo gives owners and operators a clear daily building view. Core manages the IoT devices, gateways, configuration and integrations underneath." canonicalPath="/software" schema={softwareSchema}>
  <section class="page-hero software-intro"><div class="shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Software</span></div><div class="kicker">Blutech software</div><h1>Two layers. Two clear jobs.</h1><p>Halo turns building data into daily operational decisions. Core keeps the devices, networks and integrations behind that experience dependable.</p></div></section>

  <section id="halo" class="software-section halo"><div class="shell software-grid">
    <div class="software-copy"><div class="software-number">01 · For owners and operators</div><h2>Blutech Halo</h2><p class="lead">The building intelligence and management layer: a clear place to see conditions, understand location, respond to events and review performance.</p><div class="capability-list"><div><b>Live building view</b><p>Occupancy, safety, environmental, equipment and supply status in one browser-based interface.</p></div><div><b>Floorplans & location</b><p>Map every event to the site, floor, area, room or cubicle where action is needed.</p></div><div><b>Alerts & work orders</b><p>Prioritise, acknowledge, assign and review the response history for configured events.</p></div><div><b>Trends & reports</b><p>Review utilisation, incidents, consumables, sensor health and project-specific KPIs over time.</p></div><div><b>Roles & controls</b><p>Give each authorised user the information and controls appropriate to their responsibility.</p></div></div><a class="button" href="/contact?software=halo">Discuss Halo</a></div>
    <div class="ui-frame halo-ui" aria-label="Illustrative Halo interface"><div class="ui-top"><span>BLUTECH HALO</span><i>Portfolio · Live</i></div><div class="ui-kpis"><span><b>128</b>Spaces online</span><span><b>3</b>Active alerts</span><span><b>98.7%</b>Device availability</span></div><div class="ui-main"><div class="floorplan"><div class="room r1"></div><div class="room r2"></div><div class="room r3"></div><div class="room r4"></div><i class="dot d1"></i><i class="dot d2"></i><i class="dot d3"></i></div><div class="alert-list"><b>Priority events</b><span><i class="status red"></i>Water event · Level 18</span><span><i class="status cyan"></i>Accessible space · Cleared</span><span><i class="status amber"></i>IAQ threshold · Review</span></div></div><div class="ui-chart"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><small>Illustrative interface · project screens are configured to deployment scope</small></div>
  </div></section>

  <section id="core" class="software-section core-section"><div class="shell software-grid reverse">
    <div class="ui-frame core-ui" aria-label="Illustrative Core interface"><div class="ui-top"><span>BLUTECH CORE</span><i>Infrastructure · Healthy</i></div><div class="registry"><div class="registry-head"><b>Device registry</b><span>Filter · Export</span></div>{["BT338 HeatMap Fusion","BT306 IAQ Sensor","BT339 BluDrop","BT802 LoRaWAN Gateway","BT316 Edge Controller"].map((name,i)=><div class="registry-row"><span><i class="status cyan"></i>{name}</span><b>{i===3?"Gateway":"Online"}</b><em>{i%2?"LoRaWAN":"Bluetooth + LoRaWAN"}</em></div>)}</div><div class="payload"><b>Connectivity health</b><span class="health-bar"><i></i></span><small>Provisioning · settings · rules · payloads · API</small></div></div>
    <div class="software-copy"><div class="software-number">02 · For technical operations</div><h2>Blutech Core</h2><p class="lead">The IoT device and integration layer that keeps the field estate organised, configurable, observable and ready to connect with other systems.</p><div class="capability-list"><div><b>Device & gateway registry</b><p>Organise the estate by project, property, floor, zone, device type and identifier.</p></div><div><b>Provisioning & configuration</b><p>Onboard devices and manage project-specific parameters in a controlled structure.</p></div><div><b>Connectivity health</b><p>Track heartbeat, last-seen status, network quality and gateway conditions.</p></div><div><b>Rules & payloads</b><p>Translate device events into usable data, thresholds, downlinks and response logic.</p></div><div><b>APIs & audit</b><p>Connect approved customer systems while maintaining user, change and event history.</p></div></div><a class="button" href="/contact?software=core">Discuss Core</a></div>
  </div></section>

  <section class="software-flow"><div class="shell"><div class="compact-title"><div class="kicker">How they work together</div><h2>Edge for immediate response. Cloud for visibility and management.</h2><p>A local event can trigger a nearby device directly. LoRaWAN then carries status and settings through the gateway to Core; Halo gives the building team the context to act.</p></div><div class="flow-row"><div><b>01</b><h3>Sense</h3><p>Thermal, mmWave, PIR, IAQ, leakage, contact or third-party input.</p></div><div><b>02</b><h3>Respond locally</h3><p>Bluetooth edge logic handles time-sensitive control without a cloud round trip.</p></div><div><b>03</b><h3>Manage in Core</h3><p>LoRaWAN and 4G/IP carry data, health, settings and integration payloads.</p></div><div><b>04</b><h3>Operate in Halo</h3><p>Owners and operators see location, priority, history and authorised actions.</p></div></div></div></section>

  <section class="software-cta"><div class="shell cta-panel"><div><div class="kicker">Software demonstration</div><h2>See Halo and Core around your building workflow.</h2><p>We can demonstrate the relevant live views, device operations and integration path without exposing another customer’s information.</p></div><a class="button" href="/contact">Book a demonstration</a></div></section>
</BaseLayout>
<style>
.software-intro h1{font-size:clamp(48px,5vw,70px)}.software-section{background:#fff}.software-section.halo{padding-top:78px}.software-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:72px;align-items:center}.software-grid.reverse{grid-template-columns:1.1fr .9fr}.software-number{font-size:12px;color:var(--brand-2);font-weight:850}.software-copy h2{font-size:clamp(42px,4.8vw,64px);line-height:1;letter-spacing:-.05em;margin:10px 0 18px}.lead{font-size:18px;color:#4f575b}.capability-list{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid var(--line);margin:28px 0}.capability-list>div{padding:16px 18px 14px 0;border-bottom:1px solid var(--line)}.capability-list>div:nth-child(even){padding-left:18px;border-left:1px solid var(--line)}.capability-list b{font-size:14px}.capability-list p{font-size:12px;color:var(--muted);margin:5px 0}.core-section{background:#eef0ed}.ui-frame{background:#0d1c22;color:#e7f1f2;padding:24px;box-shadow:0 30px 70px rgba(9,26,32,.18);min-height:520px}.ui-top{display:flex;justify-content:space-between;font-size:10px;letter-spacing:.12em;border-bottom:1px solid rgba(255,255,255,.12);padding-bottom:15px}.ui-top i{font-style:normal;color:#75d3dc}.ui-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.12);margin-top:18px}.ui-kpis span{background:#11252d;padding:14px;font-size:9px;color:#9fb0b6}.ui-kpis b{display:block;font-size:24px;color:#fff}.ui-main{display:grid;grid-template-columns:1.2fr .8fr;gap:14px;margin-top:14px}.floorplan,.alert-list,.ui-chart,.registry,.payload{background:#10242c;border:1px solid rgba(255,255,255,.08)}.floorplan{height:210px;position:relative;padding:15px}.room{position:absolute;border:1px solid rgba(117,211,220,.4)}.r1{left:12%;top:18%;width:38%;height:33%}.r2{left:50%;top:18%;width:38%;height:33%}.r3{left:12%;top:51%;width:25%;height:32%}.r4{left:37%;top:51%;width:51%;height:32%}.dot{position:absolute;width:9px;height:9px;border-radius:50%;background:#39d3df;box-shadow:0 0 0 5px rgba(57,211,223,.12)}.d1{left:28%;top:34%}.d2{left:67%;top:65%}.d3{left:75%;top:33%;background:#e65a5a}.alert-list{padding:16px;display:flex;flex-direction:column;gap:13px}.alert-list>b{font-size:11px}.alert-list span{font-size:9px;color:#b9c7cb}.status{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:7px}.red{background:#e65a5a}.cyan{background:#39d3df}.amber{background:#e9b94f}.ui-chart{height:95px;margin-top:14px;display:flex;align-items:end;gap:7px;padding:13px}.ui-chart span{background:linear-gradient(#39d3df,#167c89);flex:1;height:35%}.ui-chart span:nth-child(2n){height:72%}.ui-chart span:nth-child(3n){height:52%}.ui-chart span:nth-child(5n){height:90%}.ui-frame>small{display:block;color:#71868d;font-size:8px;margin-top:10px}.registry{margin-top:18px}.registry-head,.registry-row{display:grid;grid-template-columns:1.3fr .5fr .8fr;padding:13px 14px;border-bottom:1px solid rgba(255,255,255,.08);align-items:center}.registry-head{font-size:9px;color:#82979d}.registry-head span{text-align:right;grid-column:3}.registry-row span,.registry-row b,.registry-row em{font-size:9px}.registry-row b{color:#75d3dc}.registry-row em{font-style:normal;color:#82979d}.payload{padding:18px;margin-top:14px}.payload>b{font-size:10px}.health-bar{height:8px;background:#24373e;display:block;margin:12px 0}.health-bar i{display:block;height:100%;width:94%;background:#39d3df}.payload small{color:#82979d;font-size:8px}.software-flow{background:#fff}.compact-title{max-width:920px}.compact-title h2,.cta-panel h2{font-size:clamp(36px,4vw,54px);line-height:1.03;letter-spacing:-.045em;margin:9px 0 13px}.compact-title p{color:var(--muted)}.flow-row{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:34px}.flow-row>div{background:#fff;padding:24px}.flow-row b{font-size:10px;color:var(--brand-2)}.flow-row h3{font-size:20px;margin:28px 0 8px}.flow-row p{font-size:12px;color:var(--muted)}.software-cta{background:#151718;color:#fff}.cta-panel{display:flex;align-items:end;justify-content:space-between;gap:50px}.cta-panel p{color:#b9c1c3}.cta-panel .button{background:#fff;color:#111;border-color:#fff}
@media(max-width:950px){.software-grid,.software-grid.reverse{grid-template-columns:1fr}.software-grid.reverse .ui-frame{order:2}.flow-row{grid-template-columns:1fr 1fr}}@media(max-width:650px){.capability-list,.flow-row{grid-template-columns:1fr}.capability-list>div:nth-child(even){padding-left:0;border-left:0}.ui-frame{padding:15px;min-height:450px}.ui-main{grid-template-columns:1fr}.alert-list{display:none}.registry-row{grid-template-columns:1.3fr .6fr}.registry-row em{display:none}.cta-panel{display:block}.cta-panel .button{margin-top:18px}}
</style>
