---
import BaseLayout from "../layouts/BaseLayout.astro";
const softwareSchema = [
  {"@context":"https://schema.org","@type":"SoftwareApplication",name:"Blutech Halo",applicationCategory:"BusinessApplication",operatingSystem:"Web",description:"Building intelligence and management platform for live status, floorplans, alerts, history, reports and authorised controls."},
  {"@context":"https://schema.org","@type":"SoftwareApplication",name:"Blutech Core",applicationCategory:"BusinessApplication",operatingSystem:"Web",description:"IoT device and integration platform for provisioning, gateways, configuration, connectivity, rules and APIs."}
];
---
<BaseLayout title="Blutech Halo & Core | Smart Building Software" description="Blutech Halo is the building intelligence and management layer. Blutech Core is the IoT device and integration layer behind connected-building deployments." canonicalPath="/software" schema={softwareSchema}>
  <section class="page-hero"><div class="shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Software</span></div><div class="kicker">Blutech software stack</div><h1>Core underneath.<br/>Halo around it.</h1><p>Separate the technical work of managing IoT infrastructure from the day-to-day work of operating a building.</p></div></section>
  <section id="halo"><div class="shell split"><div><div class="kicker">Building Intelligence & Management Platform</div><h2>Blutech Halo</h2><p class="hero-copy" style="font-size:20px">Halo is the operator-facing layer. It turns connected devices and building data into live status, location context, alerts, trends, reports and authorised actions.</p><div class="actions"><a class="button" href="https://dashboard.blutech.io" target="_blank" rel="noopener">Open Halo ↗</a><a class="button secondary" href="/contact?software=halo">Ask about Halo</a></div></div><div class="grid grid-2"><div class="card"><h3>Live building view</h3><p>Sensor state, occupancy, environmental data and operational status in a browser-based interface.</p></div><div class="card"><h3>Floorplan context</h3><p>Map events and devices to the exact site, floor, area, room or cubicle used in the project.</p></div><div class="card"><h3>Alarm workflow</h3><p>Prioritisation, acknowledgement, mute/reset actions and event history where configured.</p></div><div class="card"><h3>Reports & trends</h3><p>Historical utilisation, sensor health, incidents, replenishment patterns and export/report workflows.</p></div><div class="card"><h3>Roles & permissions</h3><p>Different access levels and user groupings can be configured according to project requirements.</p></div><div class="card"><h3>Controls & integration</h3><p>Schedules, overrides, scenes, thresholds or BMS-facing views are exposed when the deployed solution supports them.</p></div></div></div></section>
  <section style="background:var(--bg-2)" id="core"><div class="shell split"><div class="grid grid-2"><div class="card"><h3>Device registry</h3><p>Organise devices by project, site, floor, area and identifier.</p></div><div class="card"><h3>Provisioning</h3><p>Onboard devices, gateways and project-specific parameters into a controlled deployment structure.</p></div><div class="card"><h3>Connectivity health</h3><p>Track heartbeat, last-seen status, gateway/device health and network-related conditions.</p></div><div class="card"><h3>Configuration</h3><p>Manage thresholds, timers, groups, device settings and approved remote configuration workflows.</p></div><div class="card"><h3>Payloads & data</h3><p>Decode and map connected-device payloads into usable data for applications and integrations.</p></div><div class="card"><h3>APIs & integrations</h3><p>Support REST, MQTT and project-specific interfaces for BMS, FM, hospital or customer systems.</p></div></div><div><div class="kicker">IoT Device & Integration Platform</div><h2>Blutech Core</h2><p class="hero-copy" style="font-size:20px">Core is the technical layer engineers and system administrators use to provision, configure and maintain connected infrastructure behind each deployment.</p><div class="actions"><a class="button" href="https://platform.blutech.io" target="_blank" rel="noopener">Open Core ↗</a><a class="button secondary" href="/contact?software=core">Ask about Core</a></div></div></div></section>
  <section><div class="shell"><div class="section-head"><div><div class="kicker">Architecture</div><h2>One data path. Two user experiences.</h2><p>Field devices and third-party systems connect into Core. Halo turns that infrastructure into an operational view for building teams.</p></div></div><div class="grid grid-4"><div class="card"><div class="meta">01 · Field</div><h3>Sensors & controllers</h3><p>Thermal, PIR, mmWave, IAQ, leakage, contacts, relays, signage and third-party equipment.</p></div><div class="card"><div class="meta">02 · Connect</div><h3>Gateways & networks</h3><p>LoRaWAN, Bluetooth, 4G, Wi-Fi, Ethernet, RS485 and local interfaces.</p></div><div class="card"><div class="meta">03 · Core</div><h3>Infrastructure layer</h3><p>Provisioning, device health, data mapping, configuration and APIs.</p></div><div class="card"><div class="meta">04 · Halo</div><h3>Operations layer</h3><p>Live status, alerts, floorplans, history, reports and authorised control.</p></div></div></div></section>
  <section style="background:var(--bg-2)"><div class="shell panel"><p class="notice" style="margin:0">Deployment can be cloud-based or on-premises when the project requires it. Exact hosting, retention, integration and cybersecurity arrangements are confirmed during project design rather than assumed globally.</p></div></section>
</BaseLayout>
