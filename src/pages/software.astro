---
const haloFeatures = [
  "Live building and sensor status",
  "Floor-plan views and location context",
  "Alerts, acknowledgement and event history",
  "Historical trends and operational analytics",
  "Reports and data export",
  "Authorised control, thresholds and schedules",
  "Role-based access",
  "API and BMS-connected workflows"
];
const coreFeatures = [
  "Device and gateway registry",
  "Provisioning and deployment setup",
  "Location and hierarchy mapping",
  "Device configuration and remote parameters",
  "Connectivity and device-health monitoring",
  "Rules, payload handling and data routing",
  "API and third-party integration",
  "Technical administration for multi-site systems"
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Blutech Halo & Core — Building Software</title>
  <meta name="description" content="Blutech Halo is the building intelligence and management layer for operators. Blutech Core is the IoT device and integration platform behind the deployment." />
  <link rel="canonical" href="https://blutech.io/software" />
</head>
<body>
  <header>
    <div class="shell nav">
      <a class="brand" href="/"><span>blu</span>tech.io</a>
      <nav><a href="/solutions">Solutions</a><a href="/hardware">Products</a><a class="active" href="/software">Software</a><a href="/projects">Projects</a></nav>
      <a class="contact" href="mailto:enquiry@blutech.io">Talk to us</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="shell">
        <p class="eyebrow">BLUTECH SOFTWARE</p>
        <h1>Two layers.<br/>One connected building.</h1>
        <p class="lead">Halo is where building teams see and act. Core is the technical layer that keeps devices, data and integrations organised underneath.</p>
      </div>
    </section>

    <section id="halo" class="product halo">
      <div class="shell product-grid">
        <div class="sticky-copy">
          <span class="pill">For building operators</span>
          <h2>Blutech Halo</h2>
          <h3>Building Intelligence & Management Platform</h3>
          <p>Halo turns connected-building data into an operational view that people can actually use. It brings live conditions, location context, alerts, history and authorised actions into one browser-based environment.</p>
          <a class="button" href="https://dashboard.blutech.io">Open Halo ↗</a>
        </div>
        <div class="feature-panel">
          <p class="panel-label">WHAT HALO DOES</p>
          <div class="features">
            {haloFeatures.map((feature, i) => <div class="feature"><span>0{i+1}</span><p>{feature}</p></div>)}
          </div>
          <div class="use-note">
            <strong>Designed around the operator.</strong>
            <p>Halo can be configured around the project: smart washroom, safety, IAQ, water leakage, lighting control, HVAC interaction or other connected-building workflows.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bridge">
      <div class="shell bridge-inner">
        <p>Halo presents the building.</p>
        <div class="line"><span></span></div>
        <p>Core makes the connected system work.</p>
      </div>
    </section>

    <section id="core" class="product core">
      <div class="shell product-grid reverse">
        <div class="sticky-copy">
          <span class="pill">For engineers & integrators</span>
          <h2>Blutech Core</h2>
          <h3>IoT Device & Integration Platform</h3>
          <p>Core is the technical backbone behind Blutech deployments. It manages the device estate, network relationships, configuration and data interfaces that operators should not have to think about every day.</p>
          <a class="button" href="https://platform.blutech.io">Open Core ↗</a>
        </div>
        <div class="feature-panel">
          <p class="panel-label">WHAT CORE DOES</p>
          <div class="features">
            {coreFeatures.map((feature, i) => <div class="feature"><span>0{i+1}</span><p>{feature}</p></div>)}
          </div>
          <div class="use-note">
            <strong>Built for deployment and integration.</strong>
            <p>Core supports the technical work behind field devices, gateways, site hierarchies, remote configuration and links to customer systems.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="shell cta-inner">
        <div><p class="eyebrow dark">SOFTWARE + HARDWARE + INTEGRATION</p><h2>Start with the problem, not the platform.</h2></div>
        <div><p>Blutech can deliver Halo and Core as part of a complete connected-building solution or integrate them into an existing technology stack.</p><a class="button dark" href="mailto:enquiry@blutech.io">Discuss your project</a></div>
      </div>
    </section>
  </main>

  <footer><div class="shell footer"><span class="brand"><span>blu</span>tech.io</span><span>© {new Date().getFullYear()} Blutech IoT Limited</span></div></footer>
</body>
</html>

<style>
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f2f6f5;color:#0a2025;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.55}a{color:inherit;text-decoration:none}.shell{width:min(1180px,calc(100% - 40px));margin:auto}
  header{position:sticky;top:0;z-index:20;background:rgba(6,20,24,.94);backdrop-filter:blur(16px);color:white;border-bottom:1px solid rgba(255,255,255,.08)}.nav{height:70px;display:flex;align-items:center;justify-content:space-between;gap:26px}.brand{font-weight:850;font-size:22px;letter-spacing:-1px}.brand span{color:#19d1c1}.nav nav{display:flex;gap:26px;font-size:14px;color:#bdd0cd}.nav nav .active,.nav nav a:hover{color:white}.contact{font-size:13px;font-weight:750;border:1px solid rgba(255,255,255,.28);border-radius:999px;padding:8px 13px}
  .hero{background:#061519;color:white;padding:130px 0 105px}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.18em;color:#71eadd;margin:0 0 16px}.eyebrow.dark{color:#087e76}.hero h1{font-size:clamp(52px,8vw,96px);line-height:.95;letter-spacing:-.055em;margin:0 0 30px}.lead{max-width:760px;color:#bdd0cd;font-size:20px;margin:0}
  .product{padding:110px 0}.halo{background:#e7f7f3}.core{background:#e9eef5}.product-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:100px;align-items:start}.reverse .sticky-copy{order:2}.reverse .feature-panel{order:1}.sticky-copy{position:sticky;top:115px}.pill{display:inline-block;border:1px solid rgba(10,32,37,.18);border-radius:999px;padding:7px 11px;font-size:11px;font-weight:800;color:#436267}.sticky-copy h2{font-size:clamp(54px,7vw,86px);line-height:.95;letter-spacing:-.055em;margin:52px 0 10px}.sticky-copy h3{font-size:17px;color:#476368;margin:0 0 22px}.sticky-copy>p{color:#476368;font-size:17px;line-height:1.75;max-width:520px}.button{display:inline-flex;background:#0d3337;color:white;border-radius:999px;padding:12px 17px;font-size:13px;font-weight:800;margin-top:20px}.button.dark{background:#09282c}
  .feature-panel{background:rgba(255,255,255,.72);border:1px solid rgba(15,49,53,.1);border-radius:26px;padding:34px}.panel-label{font-size:11px;font-weight:850;letter-spacing:.16em;color:#668085;margin:0 0 18px}.features{border-top:1px solid #cfdbd9}.feature{display:grid;grid-template-columns:54px 1fr;gap:18px;align-items:center;min-height:78px;border-bottom:1px solid #cfdbd9}.feature span{font-size:11px;color:#75908e}.feature p{margin:0;font-size:17px;font-weight:720}.use-note{margin-top:30px;padding:26px;border-radius:18px;background:#0b2b30;color:#d8e8e5}.use-note strong{color:#74eddf}.use-note p{margin:8px 0 0;color:#b9ccca;font-size:14px}
  .bridge{background:#07191d;color:white;padding:52px 0}.bridge-inner{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:28px}.bridge-inner p{margin:0;font-size:14px;font-weight:750;color:#bfd0cd}.line{height:1px;background:#315156;position:relative}.line span{position:absolute;width:9px;height:9px;border-radius:50%;background:#19d1c1;left:50%;top:50%;transform:translate(-50%,-50%)}
  .cta{background:white;padding:100px 0}.cta-inner{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:end}.cta h2{font-size:clamp(40px,5vw,64px);line-height:1.03;letter-spacing:-.045em;margin:0}.cta-inner>div:last-child{color:#50686c;font-size:17px}
  footer{background:#061519;color:#9eb3b0;padding:32px 0}.footer{display:flex;justify-content:space-between;align-items:center;font-size:12px}
  @media(max-width:850px){.nav nav{display:none}.product-grid,.cta-inner{grid-template-columns:1fr;gap:48px}.sticky-copy{position:static}.reverse .sticky-copy,.reverse .feature-panel{order:initial}.bridge-inner{grid-template-columns:1fr}.bridge .line{display:none}}
  @media(max-width:520px){.shell{width:min(100% - 28px,1180px)}.contact{display:none}.hero{padding:100px 0 72px}.product{padding:72px 0}.feature-panel{padding:24px}.feature{grid-template-columns:38px 1fr}.footer{align-items:flex-start;flex-direction:column;gap:12px}}
</style>
