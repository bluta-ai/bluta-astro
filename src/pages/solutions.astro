astro
---
import "../styles/global.css";
import { Image } from "astro:assets";

// Import images
import solutionsHero from "../assets/bluta-solutions-hero.webp";
import aiDashboard from "../assets/bluta-ai-dashboard.webp";
import energyManagement from "../assets/bluta-energy-management.webp";
import commandCenter from "../assets/bluta-command-center.webp";
---

<!doctype html>
<html lang="en">
<head>
  <title>AI Building Solutions for GCC & Qatar | BLUTA</title>
  <meta name="description" content="Smart AI solutions tailored for Qatar and GCC region. Energy optimization, Arabic language support, and privacy-first building automation." />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b1020" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700;800&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0b1020; --panel:#121a2e; --ink:#e5e7eb; --muted:#9aa3b2;
      --line:#1f2a44; --brand:#00C3D8; --brand2:#a78bfa; --nav-h:68px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:linear-gradient(180deg,#0a0f1f 0%,#0b1020 18%,#0b1020 100%);color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial}
    a{color:var(--ink);text-decoration:none}
    .container{max-width:1200px;margin:0 auto;padding:0 20px}

    /* NAV */
    .nav{position:sticky;top:0;z-index:50;height:var(--nav-h);backdrop-filter:saturate(1.2) blur(8px);background:rgba(10,14,28,.7);border-bottom:1px solid var(--line)}
    .nav-inner{display:flex;gap:16px;align-items:center;justify-content:space-between;height:100%}
    .brand{display:flex;gap:10px;align-items:center;font-weight:800;font-family:'Comfortaa', ui-sans-serif, system-ui}
    .wordmark{font-weight:800;font-size:24px;letter-spacing:.2px;text-transform:lowercase}
    .wordmark .blu{color:var(--brand)}
    .wordmark .ta{color:#fff}
    .nav-links{display:flex;align-items:center;gap:10px}
    .nav-links a{display:inline-block;padding:10px 12px;border-radius:10px;font-weight:700;color:#dbe3f3}
    .nav-links a:hover{background:rgba(255,255,255,.06)}
    .nav-links a.active{background:rgba(255,255,255,.1)}

    /* Language Switcher */
    .language-switcher {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-left: 20px;
      padding-left: 20px;
      border-left: 1px solid var(--line);
    }
    .language-switcher a {
      text-decoration: none;
      color: #9aa3b2;
      font-weight: 600;
      font-size: 14px;
      padding: 4px 8px;
      border-radius: 6px;
    }
    .language-switcher a:hover {
      color: #00C3D8;
      background: rgba(255,255,255,0.05);
    }

    /* LAYOUT */
    section{padding:80px 0}
    .grid{display:grid;gap:30px}
    .col-2{grid-template-columns:1fr 1fr}
    .col-3{grid-template-columns:repeat(3,1fr)}
    @media(max-width:980px){.col-2,.col-3{grid-template-columns:1fr}}
    .card{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));border:1px solid var(--line);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.25);transition:transform 0.3s ease}
    .card:hover{transform:translateY(-5px)}
    .p-6{padding:24px}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:12px;font-weight:800;border:1px solid var(--line);background:rgba(255,255,255,.04);cursor:pointer;transition:all 0.3s ease}
    .btn.primary{background:linear-gradient(120deg,var(--brand),var(--brand2));color:#0b1020;border-color:transparent}
    .btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(0,195,216,0.3)}
    .subtitle{color:var(--muted);font-size:20px;text-align:center;max-width:900px;margin:0px auto 0;line-height:1.6}
    .h1{font-size:clamp(32px,4vw,56px);line-height:1.1;margin:10px 0;text-align:center;font-weight:900}
    .h2{font-size:36px;margin:0 0 16px;font-weight:800}
    .h3{font-size:24px;margin:0 0 12px;font-weight:700}
    .pill{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;background:rgba(96,165,250,.12);color:#c7d2fe;font-weight:800;font-size:14px;border:1px solid var(--line)}
    .muted{color:var(--muted);line-height:1.6}

    .image{overflow:hidden;border-radius:16px;border:1px solid var(--line);background:#050814}
    .image img, .image picture{display:block;width:100%;height:100%;object-fit:cover;transition:transform 0.3s ease}
    .image:hover img{transform:scale(1.05)}

    /* Solutions Specific Styles */
    .solution-hero{position:relative;padding:120px 0 80px;text-align:center}
    .solution-hero-bg{position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(135deg,rgba(0,195,216,0.1),rgba(167,139,250,0.1))}
    
    .feature-grid{display:grid;gap:24px;margin-top:40px}
    .feature-card{text-align:center;padding:30px}
    .feature-icon{width:80px;height:80px;margin:0 auto 20px;background:linear-gradient(135deg,var(--brand),var(--brand2));border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:32px}
    
    .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin:40px 0}
    @media(max-width:768px){.stats-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:480px){.stats-grid{grid-template-columns:1fr}}
    .stat-card{text-align:center;padding:20px}
    .stat-number{font-size:36px;font-weight:900;color:var(--brand);margin-bottom:8px}
    .stat-label{color:var(--muted);font-size:14px;font-weight:600}
    
    .use-case{background:rgba(255,255,255,.02);border-radius:16px;padding:30px;margin:20px 0}
    .use-case h4{color:var(--brand);margin-bottom:12px}
    
    .integration-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:rgba(255,255,255,.05);border-radius:8px;font-size:12px;font-weight:600;margin:4px}
  </style>
</head>

<body>
  <!-- NAV -->
  <div class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand" aria-label="bluta home">
        <span class="wordmark"><span class="blu">blu</span><span class="ta">ta</span></span>
      </a>
      <div class="nav-links">
        <a href="/" data-nav="home">Home</a>
        <a href="/solutions" data-nav="solutions" class="active">Solutions</a>
        <a href="/hardware" data-nav="hardware">Hardware</a>
        <a href="/projects" data-nav="projects">Projects</a>
        <a href="/#contact" data-nav="contact">Contact</a>
        <div class="language-switcher">
          <a href="/">EN</a>
          <span>|</span>
          <a href="/ar/solutions">AR</a>
        </div>
      </div>
    </div>
  </div>

  <!-- SOLUTIONS HERO -->
  <section class="solution-hero">
    <div class="solution-hero-bg"></div>
    <div class="container">
      <div style="position:relative;z-index:2">
        <span class="pill">Tailored for Qatar & GCC Region</span>
        <h1 class="h1">AI Solutions for Smarter<br>Buildings in the Middle East</h1>
        <p class="subtitle">
          BLUTA delivers intelligent building automation with Arabic language support, 
          designed specifically for the climate and operational needs of GCC countries.
        </p>
        <div style="margin-top:30px;display:flex;gap:15px;flex-wrap:wrap;justify-content:center">
          <a class="btn primary" href="#demo">Request GCC Demo</a>
          <a class="btn" href="#solutions">Explore Solutions</a>
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK STATS -->
  <section>
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">30-50%</div>
          <div class="stat-label">Labour Cost Reduction</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">15-25%</div>
          <div class="stat-label">Energy Savings</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">24/7</div>
          <div class="stat-label">Arabic Language Support</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">100%</div>
          <div class="stat-label">Privacy Compliant</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CORE SOLUTIONS -->
  <section id="solutions">
    <div class="container">
      <div class="h2" style="text-align:center">Comprehensive AI Building Solutions</div>
      <p class="subtitle">End-to-end automation platform designed for Middle Eastern building requirements</p>
      
      <div class="grid col-3" style="margin-top:50px">
        <!-- Solution 1 -->
        <div class="card p-6">
          <div class="feature-icon">🌡️</div>
          <h3>Smart Energy & HVAC</h3>
          <p class="muted">AI-powered climate control optimized for extreme Gulf temperatures. Reduce cooling costs while maintaining perfect comfort levels.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">HVAC Systems</span>
            <span class="integration-badge">Energy Meters</span>
            <span class="integration-badge">Weather Data</span>
          </div>
          <div class="use-case">
            <h4>Qatar Use Case</h4>
            <p class="muted">Automatically adjust cooling based on prayer times and occupancy patterns in mosques and public buildings.</p>
          </div>
        </div>

        <!-- Solution 2 -->
        <div class="card p-6">
          <div class="feature-icon">👥</div>
          <h3>People & Space Analytics</h3>
          <p class="muted">Privacy-first occupancy tracking and crowd management. Optimize space utilization without compromising personal data.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">People Counting</span>
            <span class="integration-badge">Queue Management</span>
            <span class="integration-badge">Space Utilization</span>
          </div>
          <div class="use-case">
            <h4>Mall & Retail</h4>
            <p class="muted">Manage peak shopping hours and optimize food court operations during weekend rushes.</p>
          </div>
        </div>

        <!-- Solution 3 -->
        <div class="card p-6">
          <div class="feature-icon">🛡️</div>
          <h3>Unified Operations Center</h3>
          <p class="muted">Centralized control for all building systems with Arabic interface. One platform for maintenance, security, and facilities teams.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">BMS Integration</span>
            <span class="integration-badge">CCTV Systems</span>
            <span class="integration-badge">Access Control</span>
          </div>
          <div class="use-case">
            <h4>Government Buildings</h4>
            <p class="muted">Unified security and maintenance operations for ministry buildings and public facilities.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARABIC LANGUAGE SUPPORT -->
  <section style="background:linear-gradient(135deg,rgba(0,195,216,0.05),rgba(167,139,250,0.05))">
    <div class="container">
      <div class="grid col-2" style="align-items:center">
        <div>
          <span class="pill">Arabic First Design</span>
          <h2>Built for the Middle East Market</h2>
          <p class="muted">Full Arabic language support with understanding of regional dialects and cultural context.</p>
          <ul class="muted" style="line-height:2;margin-top:20px">
            <li>✓ Modern Standard Arabic interface</li>
            <li>✓ Gulf dialect understanding in AI models</li>
            <li>✓ Right-to-left layout support</li>
            <li>✓ Local compliance and data sovereignty</li>
            <li>✓ Arabic documentation and support</li>
          </ul>
        </div>
        <div class="image" style="height:400px">
          <div style="display:flex;align-items:center;justify-content:center;height:100%;background:linear-gradient(135deg,#121a2e,#1f2a44);color:var(--muted);font-size:18px">
            Arabic AI Dashboard Visualization
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRY SOLUTIONS -->
  <section>
    <div class="container">
      <div class="h2" style="text-align:center">Industry-Specific Solutions</div>
      <p class="subtitle">Tailored automation for Qatar's key sectors</p>
      
      <div class="grid col-3" style="margin-top:40px">
        <div class="card p-6">
          <h3>🏢 Commercial Real Estate</h3>
          <p class="muted">Portfolio-wide energy management and tenant comfort optimization for office towers and business districts.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">Tenant Billing</span>
            <span class="integration-badge">ESG Reporting</span>
            <span class="integration-badge">Preventive Maintenance</span>
          </div>
        </div>

        <div class="card p-6">
          <h3>🛍️ Retail & Shopping Malls</h3>
          <p class="muted">Customer experience enhancement and operational efficiency for malls and retail centers.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">Footfall Analytics</span>
            <span class="integration-badge">Smart Parking</span>
            <span class="integration-badge">Retail Heatmaps</span>
          </div>
        </div>

        <div class="card p-6">
          <h3>🏥 Healthcare Facilities</h3>
          <p class="muted">Patient comfort and operational excellence for hospitals and medical centers.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">IAQ Monitoring</span>
            <span class="integration-badge">Equipment Tracking</span>
            <span class="integration-badge">Compliance Reporting</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TECHNOLOGY STACK -->
  <section>
    <div class="container">
      <div class="h2" style="text-align:center">Advanced Technology Stack</div>
      <div class="grid col-2" style="margin-top:40px">
        <div class="card p-6">
          <h3>AI & Machine Learning</h3>
          <ul class="muted" style="line-height:2;margin-top:15px">
            <li>• Predictive maintenance algorithms</li>
            <li>• Anomaly detection in building systems</li>
            <li>• Arabic NLP for voice commands</li>
            <li>• Computer vision for space analytics</li>
            <li>• Energy consumption forecasting</li>
          </ul>
        </div>
        <div class="card p-6">
          <h3>Privacy & Security</h3>
          <ul class="muted" style="line-height:2;margin-top:15px">
            <li>• On-premise deployment options</li>
            <li>• GDPR and local compliance</li>
            <li>• End-to-end encryption</li>
            <li>• No personal data collection</li>
            <li>• Regular security audits</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section id="demo">
    <div class="container">
      <div class="card p-6" style="background:linear-gradient(135deg,rgba(167,139,250,.15),rgba(0,195,216,.15));text-align:center">
        <h2>Ready to Transform Your Building Operations?</h2>
        <p class="muted" style="max-width:600px;margin:20px auto">See how BLUTA can reduce costs and improve efficiency in your Qatari or GCC facility.</p>
        <div style="margin-top:30px;display:flex;gap:15px;flex-wrap:wrap;justify-content:center">
          <a class="btn primary js-request-demo" href="#demo-modal">Request GCC Demo</a>
          <a class="btn" href="/contact">Contact Qatar Team</a>
        </div>
        <p class="muted" style="margin-top:20px;font-size:14px">Arabic-speaking support team available</p>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section>
    <div class="container">
      <div class="h2" style="text-align:center">Frequently Asked Questions</div>
      <div class="grid col-2" style="margin-top:40px;gap:40px">
        <div>
          <h4>Do you support Arabic language completely?</h4>
          <p class="muted">Yes, full Arabic interface with support for Modern Standard Arabic and understanding of Gulf dialects in our AI models.</p>
        </div>
        <div>
          <h4>Is my data stored locally in Qatar?</h4>
          <p class="muted">We offer both cloud and on-premise deployment options to meet Qatar's data sovereignty requirements.</p>
        </div>
        <div>
          <h4>How long does implementation take?</h4>
          <p class="muted">Typically 4-8 weeks depending on building size and systems integration requirements.</p>
        </div>
        <div>
          <h4>Do you provide training in Arabic?</h4>
          <p class="muted">Yes, comprehensive training and documentation available in Arabic for your team.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Demo Modal -->
  <div id="demo-modal" class="modal hidden">
    <div class="modal-backdrop js-close-demo"></div>
    <div class="modal-panel">
      <button class="modal-close js-close-demo">✕</button>
      <h3 class="modal-title">Request GCC Demo</h3>
      <p class="modal-sub">Our Qatar team will contact you to schedule a personalized demonstration.</p>
      <form class="demo-form" action="https://formspree.io/f/xyznyolp" method="POST">
        <input type="text" name="_gotcha" style="display:none">
        <div class="field">
          <label for="demo-name">Name</label>
          <input id="demo-name" name="name" type="text" required>
        </div>
        <div class="field">
          <label for="demo-email">Email</label>
          <input id="demo-email" name="email" type="email" required>
        </div>
        <div class="field">
          <label for="demo-company">Company</label>
          <input id="demo-company" name="company" type="text">
        </div>
        <div class="field">
          <label for="demo-building">Building Type</label>
          <select id="demo-building" name="building_type">
            <option value="">Select building type</option>
            <option value="commercial">Commercial Office</option>
            <option value="retail">Shopping Mall/Retail</option>
            <option value="healthcare">Hospital/Healthcare</option>
            <option value="hospitality">Hotel/Resort</option>
            <option value="government">Government Building</option>
            <option value="other">Other</option>
          </select>
        </div>
        <button type="submit" class="btn primary" style="width:100%">Request Demo</button>
      </form>
    </div>
  </div>

  <script>
    // Modal functionality
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('demo-modal');
      const openers = document.querySelectorAll('.js-request-demo');
      const closers = document.querySelectorAll('.js-close-demo');

      openers.forEach(opener => {
        opener.addEventListener('click', function(e) {
          e.preventDefault();
          modal.classList.remove('hidden');
        });
      });

      closers.forEach(closer => {
        closer.addEventListener('click', function() {
          modal.classList.add('hidden');
        });
      });
    });
  </script>

</body>
</html>