---
import { Image } from "astro:assets";
import hero from "../assets/bluta-hero-city.webp";
import iaqSensor from "../assets/bluta-iaq-sensor.webp";
import heatmapFusion from "../assets/bluta-heatmap-fusion-sensor.webp";

const software = [
  {
    name: "Blutech Halo",
    subtitle: "Building Intelligence & Management Platform",
    copy: "The customer-facing layer for live building status, floor plans, alerts, analytics, reports and authorised control.",
    href: "/software#halo",
    tag: "For building operators"
  },
  {
    name: "Blutech Core",
    subtitle: "IoT Device & Integration Platform",
    copy: "The technical backbone for devices, gateways, provisioning, configuration, rules, APIs and system integrations.",
    href: "/software#core",
    tag: "For engineers & integrators"
  }
];

const solutionAreas = [
  ["Occupancy & safety", "Privacy-first sensing for occupancy, long stay, motionless events and fall detection without conventional cameras."],
  ["Smart washroom", "Connect cubicle status, safety sensing, signage, service calls and operational data in one practical workflow."],
  ["Environmental intelligence", "Monitor IAQ, smoking, water leakage and other building conditions with connected sensors and actionable alerts."],
  ["Smart building control", "Use wireless sensing, local logic and platform integration to support lighting, HVAC and other building operations."],
];

const productLinks = [
  "HeatMap Fusion",
  "HeatMap Pro",
  "IAQ5",
  "BluDrop",
  "Smart Bin Sensor",
  "Vacancy Indicator Light",
  "Smart Signage",
  "LoRaWAN Gateways"
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Blutech IoT Limited",
  url: "https://blutech.io",
  description: "Building IoT and AIoT technology company providing connected sensing, software, automation and integration for real buildings."
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blutech — Building IoT & AIoT</title>
    <meta name="description" content="Blutech connects buildings from sensor to software with privacy-first sensing, IoT infrastructure, building intelligence software and system integration." />
    <link rel="canonical" href="https://blutech.io/" />
    <meta property="og:title" content="Blutech — Building IoT & AIoT" />
    <meta property="og:description" content="Connected sensing, software, automation and integration for real buildings." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://blutech.io/" />
    <meta name="theme-color" content="#071216" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <header class="site-nav">
      <div class="shell nav-inner">
        <a class="brand" href="/" aria-label="Blutech home">
          <span class="brand-blu">blu</span><span>tech</span><span class="brand-dot">.</span><span>io</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/solutions">Solutions</a>
          <a href="/hardware">Products</a>
          <a href="/software">Software</a>
          <a href="/projects">Projects</a>
          <a href="#company">Company</a>
        </nav>
        <a class="nav-cta" href="#contact">Talk to us</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-media">
          <Image src={hero} alt="Connected city and building environment" widths={[960,1280,1600,1920]} sizes="100vw" format="webp" loading="eager" decoding="async" />
        </div>
        <div class="hero-shade"></div>
        <div class="shell hero-content">
          <p class="eyebrow">BUILDING IoT & AIoT</p>
          <h1>Connect the building.<br/><span>Understand what is happening.</span></h1>
          <p class="hero-copy">Blutech brings sensing, connectivity, software and integration together so building teams can see conditions clearly, respond faster and automate where it makes sense.</p>
          <div class="hero-actions">
            <a class="button primary" href="/solutions">Explore solutions</a>
            <a class="button secondary" href="/hardware">View products</a>
          </div>
          <div class="proof-line" aria-label="Selected sectors">
            <span>Hospitals</span><i></i><span>Transport</span><i></i><span>Government</span><i></i><span>Commercial buildings</span>
          </div>
        </div>
      </section>

      <section class="intro" id="company">
        <div class="shell split">
          <div>
            <p class="eyebrow dark">ONE TECHNOLOGY LAYER, FROM FIELD TO SOFTWARE</p>
            <h2>IoT that belongs in real buildings.</h2>
          </div>
          <div class="intro-copy">
            <p>Blutech builds practical connected systems for spaces where reliability, privacy and integration matter. We develop field devices, wireless infrastructure and software, then make them work with the building around them.</p>
            <p>AI is used where it adds real value — such as privacy-preserving human activity sensing, sensor fusion and building optimisation — rather than as a label for everything.</p>
          </div>
        </div>
      </section>

      <section class="solutions-section">
        <div class="shell">
          <div class="section-head">
            <div><p class="eyebrow dark">SOLUTIONS</p><h2>Start with the building problem.</h2></div>
            <a class="text-link" href="/solutions">All solutions →</a>
          </div>
          <div class="solution-grid">
            {solutionAreas.map(([title, copy], index) => (
              <article class="solution-card">
                <span class="index">0{index + 1}</span>
                <h3>{title}</h3>
                <p>{copy}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="software-section">
        <div class="shell">
          <div class="software-heading">
            <p class="eyebrow">BLUTECH SOFTWARE</p>
            <h2>Core underneath. Halo around it.</h2>
            <p>Two purpose-built software layers for two very different jobs.</p>
          </div>
          <div class="software-grid">
            {software.map((item, index) => (
              <article class:list={["software-card", index === 0 ? "halo" : "core"]} id={index === 0 ? "halo-preview" : "core-preview"}>
                <span class="software-tag">{item.tag}</span>
                <h3>{item.name}</h3>
                <strong>{item.subtitle}</strong>
                <p>{item.copy}</p>
                <a href={item.href}>Explore {item.name.replace("Blutech ", "")} →</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="products-section">
        <div class="shell products-layout">
          <div class="product-visuals">
            <div class="product-image large"><Image src={heatmapFusion} alt="Blutech HeatMap Fusion sensor" format="webp" /></div>
            <div class="product-image small"><Image src={iaqSensor} alt="Blutech IAQ sensor" format="webp" /></div>
          </div>
          <div class="product-copy">
            <p class="eyebrow dark">PRODUCTS</p>
            <h2>Hardware designed around deployment, not demos.</h2>
            <p>Our catalogue focuses on products with real commercial use and ongoing support — from privacy-first occupancy sensing to environmental monitoring, local indicators and LoRaWAN infrastructure.</p>
            <div class="product-chips">
              {productLinks.map((product) => <span>{product}</span>)}
            </div>
            <a class="button dark" href="/hardware">Explore product catalogue</a>
          </div>
        </div>
      </section>

      <section class="projects-section">
        <div class="shell project-banner">
          <div>
            <p class="eyebrow">REAL DEPLOYMENTS</p>
            <h2>Built for places that cannot afford technology theatre.</h2>
          </div>
          <div>
            <p>Blutech systems have been deployed across healthcare, transport infrastructure, government facilities, shopping centres and Grade-A commercial buildings.</p>
            <a class="text-link light" href="/projects">View selected projects →</a>
          </div>
        </div>
      </section>

      <section class="contact-section" id="contact">
        <div class="shell contact-card">
          <div>
            <p class="eyebrow dark">LET'S BUILD SOMETHING USEFUL</p>
            <h2>Tell us what you need the building to do.</h2>
          </div>
          <div class="contact-side">
            <p>Whether the project starts with a sensor, a retrofit problem, an integration requirement or a completely new workflow, we can help define the practical system around it.</p>
            <a class="button primary" href="mailto:enquiry@blutech.io">enquiry@blutech.io</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-inner">
        <div class="brand footer-brand"><span class="brand-blu">blu</span><span>tech</span><span class="brand-dot">.</span><span>io</span></div>
        <p>Building IoT & AIoT · Hong Kong</p>
        <p>© {new Date().getFullYear()} Blutech IoT Limited</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:#f4f7f6;color:#0c1e23;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.5}
  :global(a){color:inherit;text-decoration:none}
  .shell{width:min(1240px,calc(100% - 40px));margin:0 auto}
  .site-nav{position:fixed;z-index:30;top:0;left:0;right:0;background:rgba(5,18,22,.78);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.09)}
  .nav-inner{height:72px;display:flex;align-items:center;justify-content:space-between;gap:30px;color:#fff}
  .brand{font-size:24px;font-weight:800;letter-spacing:-1px;white-space:nowrap}.brand-blu{color:#17d3c3}.brand-dot{color:#17d3c3}
  nav{display:flex;gap:28px;font-size:14px;color:#dce9e7}nav a:hover{color:#fff}
  .nav-cta{border:1px solid rgba(255,255,255,.32);padding:9px 15px;border-radius:999px;font-size:14px;font-weight:700}
  .hero{min-height:760px;position:relative;display:flex;align-items:flex-end;background:#071216;color:#fff;overflow:hidden}
  .hero-media{position:absolute;inset:0}.hero-media :global(img){width:100%;height:100%;object-fit:cover;filter:saturate(.65) contrast(1.02)}
  .hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(2,13,17,.92) 0%,rgba(4,18,23,.72) 42%,rgba(4,18,23,.30) 72%,rgba(4,18,23,.38) 100%),linear-gradient(0deg,rgba(3,15,19,.78),transparent 55%)}
  .hero-content{position:relative;z-index:2;padding:160px 0 76px}
  .eyebrow{font-size:12px;letter-spacing:.18em;font-weight:800;color:#73eee1;margin:0 0 18px}.eyebrow.dark{color:#087e76}
  h1,h2,h3,p{margin-top:0}h1{max-width:900px;font-size:clamp(48px,7vw,88px);line-height:.98;letter-spacing:-.055em;margin-bottom:28px}h1 span{color:#a8c5c1}
  .hero-copy{max-width:720px;color:#d5e3e1;font-size:20px;line-height:1.65;margin-bottom:34px}
  .hero-actions{display:flex;gap:12px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:13px 19px;font-weight:800;font-size:14px}.button.primary{background:#17d3c3;color:#06201f}.button.secondary{border:1px solid rgba(255,255,255,.3);color:#fff}.button.dark{background:#0b292e;color:#fff;margin-top:28px}
  .proof-line{display:flex;align-items:center;gap:14px;flex-wrap:wrap;color:#adc0bd;font-size:13px;margin-top:72px}.proof-line i{width:3px;height:3px;border-radius:50%;background:#17d3c3}
  section:not(.hero){padding:100px 0}.split{display:grid;grid-template-columns:.9fr 1.1fr;gap:110px}.split h2,.section-head h2,.product-copy h2,.contact-card h2{font-size:clamp(38px,5vw,62px);line-height:1.05;letter-spacing:-.045em;margin-bottom:0}.intro-copy{font-size:18px;color:#385056}.intro-copy p{margin-bottom:22px}
  .solutions-section{background:#fff}.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:50px}.text-link{font-size:14px;font-weight:800;color:#087e76}.text-link.light{color:#73eee1}
  .solution-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #d9e3e1;border-bottom:1px solid #d9e3e1}.solution-card{padding:30px 26px 34px;border-right:1px solid #d9e3e1;min-height:280px}.solution-card:last-child{border-right:0}.solution-card .index{font-size:12px;color:#6e8589;font-weight:800}.solution-card h3{font-size:24px;letter-spacing:-.025em;margin:70px 0 14px}.solution-card p{color:#586e72;font-size:14px;line-height:1.7}
  .software-section{background:#07191e;color:#fff}.software-heading{max-width:760px;margin-bottom:44px}.software-heading h2{font-size:clamp(40px,5vw,64px);letter-spacing:-.045em;line-height:1.04;margin-bottom:14px}.software-heading>p:last-child{color:#a9bdba;font-size:18px}.software-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.software-card{padding:44px;border-radius:24px;min-height:380px;display:flex;flex-direction:column;align-items:flex-start}.software-card.halo{background:radial-gradient(circle at 85% 10%,rgba(105,244,225,.28),transparent 35%),#0e3438}.software-card.core{background:radial-gradient(circle at 85% 10%,rgba(103,149,255,.24),transparent 35%),#111f31}.software-tag{border:1px solid rgba(255,255,255,.2);border-radius:999px;padding:6px 10px;font-size:11px;color:#c9d8d6}.software-card h3{font-size:48px;letter-spacing:-.045em;margin:72px 0 4px}.software-card strong{color:#b9cecb;font-size:15px}.software-card p{max-width:520px;color:#b8c8c6;margin:18px 0 32px}.software-card a{margin-top:auto;color:#73eee1;font-weight:800;font-size:14px}
  .products-section{background:#eef3f1}.products-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:82px;align-items:center}.product-visuals{position:relative;min-height:540px}.product-image{position:absolute;background:#fff;border-radius:28px;overflow:hidden;box-shadow:0 28px 70px rgba(10,35,38,.12)}.product-image :global(img){width:100%;height:100%;object-fit:contain}.product-image.large{left:0;top:0;width:78%;height:440px;padding:30px}.product-image.small{right:0;bottom:0;width:44%;height:260px;padding:24px}.product-copy>p:not(.eyebrow){color:#52686c;font-size:17px;line-height:1.7}.product-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}.product-chips span{background:#fff;border:1px solid #d8e2df;border-radius:999px;padding:8px 11px;font-size:12px;font-weight:700;color:#29464a}
  .projects-section{background:#0a272c;color:#fff}.project-banner{display:grid;grid-template-columns:1.1fr .9fr;gap:100px;align-items:end}.project-banner h2{font-size:clamp(40px,5vw,68px);letter-spacing:-.045em;line-height:1.03;margin:0}.project-banner>div:last-child{color:#b8cbc8;font-size:17px}.project-banner .text-link{display:inline-block;margin-top:18px}
  .contact-section{background:#fff}.contact-card{background:#dff7f1;border-radius:28px;padding:58px;display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center}.contact-side{color:#3e595d}.contact-side .button{margin-top:16px}
  footer{background:#051216;color:#a7bbb8;padding:36px 0}.footer-inner{display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;font-size:12px}.footer-inner p{margin:0}.footer-inner p:last-child{text-align:right}.footer-brand{color:#fff;font-size:20px}
  @media(max-width:900px){nav{display:none}.split,.products-layout,.project-banner,.contact-card{grid-template-columns:1fr;gap:40px}.solution-grid{grid-template-columns:1fr 1fr}.solution-card:nth-child(2){border-right:0}.solution-card:nth-child(-n+2){border-bottom:1px solid #d9e3e1}.software-grid{grid-template-columns:1fr}.product-visuals{min-height:430px}.footer-inner{grid-template-columns:1fr;gap:10px}.footer-inner p:last-child{text-align:left}}
  @media(max-width:560px){.shell{width:min(100% - 28px,1240px)}.site-nav .nav-cta{display:none}.hero{min-height:700px}.hero-content{padding-top:140px}.hero-copy{font-size:17px}.proof-line{margin-top:50px}section:not(.hero){padding:72px 0}.solution-grid{grid-template-columns:1fr}.solution-card{border-right:0!important;border-bottom:1px solid #d9e3e1}.solution-card:last-child{border-bottom:0}.solution-card h3{margin-top:38px}.software-card{padding:30px}.software-card h3{font-size:40px;margin-top:50px}.product-visuals{min-height:360px}.product-image.large{height:310px;width:82%}.product-image.small{height:190px;width:48%}.contact-card{padding:34px 26px}.section-head{align-items:start;flex-direction:column}.nav-inner{height:64px}}
</style>
