---
import BaseLayout from "../layouts/BaseLayout.astro";
import hero from "../assets/bluta-project-3-Garden-Road-1.webp";
import { products, solutions, projects } from "../data/site";
const featuredProducts = products.filter((p) => p.featured).slice(0,4);
const featuredProjects = projects.slice(0,4);
---
<BaseLayout title="Blutech | Building IoT & AIoT for Real-World Operations" description="Blutech connects sensors, wireless networks, edge logic, software and building-system integrations for smarter, privacy-conscious building operations." canonicalPath="/">
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <div class="eyebrow">Building IoT & AIoT · Hong Kong</div>
        <h1>Connect the building.<br/><span>Understand what is happening.</span></h1>
        <p class="hero-copy">Blutech builds connected building systems from sensor to software — privacy-preserving sensing, LoRaWAN and Bluetooth connectivity, edge automation, dashboards, APIs and integration with existing building systems.</p>
        <div class="actions">
          <a class="button" href="/solutions">Explore solutions</a>
          <a class="button secondary" href="/projects">See real deployments</a>
        </div>
      </div>
      <div class="hero-visual">
        <img src={hero.src} alt="Blutech deployment at Three Garden Road, Hong Kong" width="1200" height="900" fetchpriority="high" />
        <div class="hero-label"><strong>Three Garden Road · Hong Kong</strong><span class="muted">Real building deployment · commercial building technology</span></div>
      </div>
    </div>
  </section>

  <div class="trust-strip">
    <div class="shell trust-grid">
      <div class="trust-item"><strong>Since 2019</strong><span>Hong Kong building IoT company</span></div>
      <div class="trust-item"><strong>Privacy-first sensing</strong><span>Thermal, PIR, mmWave and non-camera approaches</span></div>
      <div class="trust-item"><strong>Wireless-first retrofit</strong><span>LoRaWAN · Bluetooth · 4G · Wi-Fi · RS485</span></div>
      <div class="trust-item"><strong>iF DESIGN AWARD 2024</strong><span>BLUTECH.IO Smart Washroom AIoT Solution</span></div>
    </div>
  </div>

  <section>
    <div class="shell">
      <div class="section-head"><div><div class="kicker">Solutions</div><h2>Start with the operational problem.</h2><p>Blutech combines the right sensing, connectivity, local logic and software for each environment instead of forcing every project into one device or protocol.</p></div><a class="button secondary" href="/solutions">All solutions</a></div>
      <div class="grid grid-4">
        {solutions.slice(0,8).map((s) => <a class="card" href={`/solutions/${s.slug}`}><div class="meta">{s.search}</div><h3>{s.title}</h3><p>{s.summary}</p><span class="card-link">Explore →</span></a>)}
      </div>
    </div>
  </section>

  <section style="background:var(--bg-2)">
    <div class="shell">
      <div class="section-head"><div><div class="kicker">Software</div><h2>Core underneath. Halo around it.</h2><p>Two purpose-built software layers separate technical IoT management from the day-to-day building experience.</p></div><a class="button secondary" href="/software">Explore software</a></div>
      <div class="software-pair">
        <article class="card software-card" id="halo"><div class="software-role">Building Intelligence & Management Platform</div><h3>Blutech Halo</h3><p>Where operators see and act on the building: live status, floorplans, alerts, history, reports and authorised controls.</p><ul><li>Live building and sensor status</li><li>Floorplan and location context</li><li>Alerts, event history and reporting</li><li>Controls, schedules and integration views where deployed</li></ul><a class="card-link" href="/software#halo">Meet Halo →</a></article>
        <article class="card software-card core" id="core"><div class="software-role">IoT Device & Integration Platform</div><h3>Blutech Core</h3><p>The technical layer behind deployments: device provisioning, gateways, configuration, connectivity, rules and integration.</p><ul><li>Device and gateway registry</li><li>Provisioning and location hierarchy</li><li>Configuration, health and connectivity</li><li>APIs, payloads and system integrations</li></ul><a class="card-link" href="/software#core">Meet Core →</a></article>
      </div>
    </div>
  </section>

  <section>
    <div class="shell">
      <div class="section-head"><div><div class="kicker">Products</div><h2>Hardware designed to disappear into operations.</h2><p>Every public product must have verified product photography before release. The redesign preview now makes any unresolved image obvious rather than silently leaving an empty card.</p></div><a class="button secondary" href="/products">Browse products</a></div>
      <div class="product-grid">
        {featuredProducts.map((p) => <a class="card product-card" href={`/products/${p.slug}`}>{p.image ? <div class="product-image"><img src={p.image} alt={`${p.model} ${p.name}`} loading="lazy" width="720" height="540" /></div> : <div class="product-image product-image-missing"><span>Verified product photography pending</span></div>}<div class="model">{p.model} · {p.family}</div><h3>{p.name}</h3><p>{p.summary}</p><span class="card-link">Product details →</span></a>)}
      </div>
    </div>
  </section>

  <section style="background:var(--bg-2)">
    <div class="shell">
      <div class="section-head"><div><div class="kicker">Selected deployments</div><h2>Proof lives on site.</h2><p>Real installations across commercial buildings, hospitals, government facilities and transport infrastructure.</p></div><a class="button secondary" href="/projects">All projects</a></div>
      <div class="project-grid">
        {featuredProjects.map((p) => <a class="card project-card" href={`/projects#${p.slug}`}><img src={p.image} alt={`${p.title} Blutech project`} loading="lazy" width="900" height="675"/><div class="card-body"><div class="meta">{p.category}</div><h3>{p.title}</h3><p>{p.summary}</p></div></a>)}
      </div>
    </div>
  </section>

  <section>
    <div class="shell split">
      <div><div class="kicker">From Blutech</div><h2>Meet BLUTA Fire.</h2><p class="hero-copy" style="font-size:20px">BLUTA Fire is Blutech's dedicated fire & life-safety brand. It carries Blutech's connected-device and IoT-platform experience into a focused fire-safety product line, while keeping fire-specific product responsibility and positioning clearly separated from the wider Blutech building portfolio.</p><div class="actions"><a class="button" href="https://bluta.io" rel="noopener" target="_blank">Visit BLUTA Fire ↗</a><a class="button secondary" href="/company#brands">How the brands fit together</a></div></div>
      <div class="panel brand-callout"><div class="kicker">BLUTA Fire</div><h2 style="margin-top:8px">Connected fire & life safety.</h2><p>Dedicated fire-related products, connected detection and platform development from the Blutech team.</p><p class="notice" style="margin-top:22px">Fire-product certifications, approvals and availability are stated only on BLUTA materials where the exact product and approval scope are verified.</p></div>
    </div>
  </section>

  <section style="background:var(--bg-2)">
    <div class="shell split"><div><div class="kicker">Why Blutech</div><h2>One accountable layer from field device to software.</h2><p class="hero-copy" style="font-size:19px">Our job is not simply to sell a sensor. We plan wireless coverage, connect existing signals, configure edge logic, map data into software, integrate with BMS or customer systems, commission on site and support the deployment afterwards.</p></div><div class="grid grid-2"><div class="card"><h3>Privacy-conscious sensing</h3><p>Use non-camera sensing where privacy and operational context matter.</p></div><div class="card"><h3>Practical connectivity</h3><p>Choose LoRaWAN, Bluetooth, 4G, Wi-Fi, RS485 or contacts based on the actual site.</p></div><div class="card"><h3>Edge + cloud</h3><p>Keep time-critical local actions local while using central software for visibility and management.</p></div><div class="card"><h3>Open integration</h3><p>Connect through APIs, MQTT and project-specific interfaces instead of creating another isolated silo.</p></div></div></div>
  </section>

  <section><div class="shell panel"><div class="section-head" style="margin-bottom:0"><div><div class="kicker">Build with us</div><h2>Tell us what the building needs to understand or automate.</h2><p>We can start from an operational problem, an existing BMS point list, a retrofit requirement or a sensor concept.</p></div><a class="button" href="/contact">Talk to Blutech</a></div></div></section>
</BaseLayout>
