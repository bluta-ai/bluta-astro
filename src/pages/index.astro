---
import BaseLayout from "../layouts/BaseLayout.astro";
import hero from "../assets/bluta-hero-city.webp";
import { products } from "../data/site";
import { projects } from "../data/projects";
import { getProductImage } from "../data/productMedia";

const featuredModels = ["BT338", "BT306", "BT102", "SYSTEM"];
const featuredProducts = featuredModels.map((model) => products.find((p) => p.model === model)).filter(Boolean);
const featuredProjects = projects.slice(0, 3);
---
<BaseLayout title="Blutech | Building AI and IoT for Real Buildings" description="Blutech builds intelligence into real buildings through precise sensing, local edge control, LoRaWAN, Halo, Core and building-system integration." canonicalPath="/">
  <section class="bp-hero">
    <img src={hero.src} alt="Connected commercial building at night" width="1800" height="1100" fetchpriority="high" />
    <div class="bp-hero-shade"></div>
    <div class="bp-hero-copy">
      <p class="bp-eyebrow">Physical AI for buildings</p>
      <h1>Intelligence,<br/><em>built into the building.</em></h1>
      <p class="bp-lead">Blutech combines accurate sensing, edge intelligence, connected hardware and building software—turning live conditions into safer spaces, leaner operations and better-performing assets.</p>
      <div class="bp-actions"><a class="bp-button light" href="/software">Explore Blutech <span>→</span></a><a class="bp-link" href="/projects">See selected work <span>→</span></a></div>
    </div>
    <div class="bp-live" aria-label="Confirmed live deployment example">
      <div><span>THREE GARDEN ROAD · LIVE</span><i></i></div>
      <strong>Building systems connected</strong>
      <p><span>Connected devices</span><b>1,000+</b></p>
      <p><span>HVAC coordination</span><b>Live</b></p>
      <p><span>ESG reporting</span><b>Included</b></p>
      <small>Confirmed project scope</small>
    </div>
  </section>

  <section class="bp-proof" aria-label="Blutech credibility">
    <p>Proven in complex, live building environments</p>
    <div class="bp-names"><span>HKIA</span><span>EMSD</span><span>Three Garden Road</span><span>IFC</span><span>Metroplaza</span><span>Hospital networks</span></div>
    <div class="bp-stats">
      <div><strong>Since 2019</strong><span>Building intelligence developed in Hong Kong</span></div>
      <div><strong>100+</strong><span>deployment sites</span></div>
      <div><strong>74</strong><span>monitored airport spaces</span></div>
      <div><strong class="award-red">iF 2024</strong><span>Smart Washroom AIoT Solution</span></div>
    </div>
  </section>

  <section class="bp-value">
    <div class="bp-section-intro"><p class="bp-eyebrow dark">A better building is an outcome—not a gadget.</p><h2>Make every square metre<br/>work harder.</h2><p>Designed for owners, property teams and project teams, Blutech closes the gap between design intent and day-to-day performance.</p></div>
    <div class="bp-value-list">
      <article><span>01</span><h3>Protect asset value</h3><p>Find risk, waste and under-used space before they become expensive. Give management one dependable view across a property or portfolio.</p></article>
      <article><span>02</span><h3>Run leaner operations</h3><p>Automate routine checks, alerts, reporting and work orders, then focus the team on decisions that need human judgement.</p></article>
      <article><span>03</span><h3>Improve the occupant experience</h3><p>Respond to real occupancy, comfort and safety conditions—without cameras in sensitive spaces.</p></article>
    </div>
  </section>

  <section class="bp-audiences">
    <div class="bp-section-intro light-copy"><p class="bp-eyebrow">From drawing board to daily operation</p><h2>One intelligence layer.<br/>Two perspectives.</h2></div>
    <div class="bp-audience-grid">
      <article>
        <div class="bp-owner-visual" aria-hidden="true"><div class="mini-top"><i></i><i></i><i></i></div><div class="mini-bars"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="mini-metrics"><b>Assets</b><b>ESG</b><b>Risk</b></div></div>
        <span>01 / OWN</span><h3>For owners</h3><p>Turn live building performance into clearer asset decisions. See operating cost, risk, comfort and portfolio outcomes through one dependable intelligence layer.</p><ul><li>Lower OPEX</li><li>Asset protection</li><li>Verified ESG data</li><li>Portfolio visibility</li></ul>
      </article>
      <article>
        <div class="bp-operator-visual" aria-hidden="true"><div class="building-wire"><i></i><i></i><i></i><i></i></div><b>FLOORPLAN</b><b>ALERT</b><b>WORKFLOW</b></div>
        <span>02 / OPERATE</span><h3>For operators</h3><p>See what needs attention now and move directly from signal to action. Live status, floorplans, alerts, workflows, device health and reports stay clear.</p><ul><li>Live status</li><li>Faster response</li><li>Workflows and alerts</li><li>Device health</li></ul>
      </article>
    </div>
  </section>

  <section class="bp-software">
    <div class="bp-software-head"><div><p class="bp-eyebrow dark">Blutech software</p><h2>Halo makes the building clear.<br/>Core keeps it dependable.</h2></div><p>Two connected layers, each designed around a clear job—daily building operation above, technical infrastructure underneath.</p></div>
    <div class="bp-software-pair">
      <a href="/software#halo" class="bp-halo-panel">
        <div><span>BLUTECH HALO · OPERATIONS</span><h3>See and act on the building.</h3><p>Live status, floorplans, alerts, work orders, history, trends, reports, roles and authorised controls.</p></div>
        <div class="halo-demo" aria-hidden="true"><aside><b>HALO</b><i></i><i></i><i></i></aside><main><small>Portfolio overview</small><div><b>Live spaces</b><b>Open tasks</b><b>Reports</b></div><svg viewBox="0 0 420 110"><path d="M0 88 C45 81 55 52 95 58 S151 89 190 58 S247 31 284 49 S349 80 420 18"></path></svg></main></div>
      </a>
      <a href="/software#core" class="bp-core-panel">
        <div class="core-orbit" aria-hidden="true"><span>CORE</span><i>BMS</i><i>HVAC</i><i>LoRaWAN</i><i>API</i><i>IoT</i></div>
        <div><span>BLUTECH CORE · INFRASTRUCTURE</span><h3>Manage the connected estate.</h3><p>Devices, gateways, provisioning, configuration, connectivity health, rules, payloads, APIs and integrations.</p></div>
      </a>
    </div>
    <a class="bp-centre-link" href="/software">Explore Halo & Core →</a>
  </section>

  <section class="bp-projects">
    <div class="bp-section-intro"><p class="bp-eyebrow dark">Selected work</p><h2>Proven where performance matters.</h2><p>Confirmed scope, clear operational value and visible KPIs from offices, aviation and public buildings.</p></div>
    <div class="bp-project-grid">{featuredProjects.map((p, i) => <a href={`/projects/${p.slug}`}><div class="bp-project-image"><img src={p.image} alt={`${p.title} exterior`} loading="lazy"/><span>0{i+1}</span></div><div class="bp-project-copy"><p>{p.category} · {p.location}</p><h3>{p.title}</h3><div><p>{p.outcome}</p><ul>{p.kpis.slice(0,2).map(k => <li><b>{k.value}</b> {k.label}</li>)}</ul></div></div></a>)}</div>
    <a class="bp-centre-link" href="/projects">View all projects →</a>
  </section>

  <section class="bp-products">
    <div class="bp-section-intro light-copy"><p class="bp-eyebrow">Blutech hardware</p><h2>Signals you can trust.</h2><p>Purpose-built sensing, display and control products—quietly integrated into the architecture and clearly connected to an operating outcome.</p></div>
    <div class="bp-product-grid">{featuredProducts.map((p:any) => { const image=getProductImage(p.model,p.image); return <a href={`/products/${p.slug}`}><div class="bp-product-media"><img src={image} alt={`${p.model} ${p.name}`} loading="lazy"/></div><div class="bp-product-copy"><p>{p.model} · {p.family}</p>{p.award && <span class="bp-award">iF</span>}<h3>{p.name}</h3><p>{p.summary}</p><b>View product →</b></div></a>; })}</div>
    <a class="bp-centre-link light" href="/products">View complete catalogue →</a>
  </section>

  <section class="bp-trust"><article><p class="bp-eyebrow dark">Open by default</p><h2>Keep what works.<br/>Connect what matters.</h2><p>Bluetooth handles responsive edge control. LoRaWAN carries building data and settings. 4G or IP connects gateways to Core, where approved integrations work together.</p><a href="/technology">See the architecture →</a></article><article><p class="bp-eyebrow">Designed for sensitive spaces</p><h2>Useful intelligence without personal imagery.</h2><p>Thermal grids, mmWave and edge AI can create useful activity and occupancy signals without facial images or personal identifiers.</p><div><span>No conventional camera imagery</span><span>No facial recognition</span><span>Edge processing</span></div></article></section>

  <section class="bp-contact"><p class="bp-eyebrow dark">Start with one meaningful outcome</p><h2>Make the next building perform as beautifully as it looks.</h2><div><p>Share the property type, existing systems and priorities. We will propose a practical pilot, integration path and measurement plan.</p><a class="bp-button dark" href="/contact">Talk to our project team →</a></div></section>
</BaseLayout>

<style>
.bp-hero{position:relative;min-height:min(920px,100vh);display:flex;align-items:center;overflow:hidden;background:#06171d;color:#fff}.bp-hero>img,.bp-hero-shade{position:absolute;inset:0;width:100%;height:100%}.bp-hero>img{object-fit:cover;transform:scale(1.01)}.bp-hero-shade{background:linear-gradient(90deg,rgba(2,15,19,.97) 0%,rgba(2,15,19,.83) 40%,rgba(2,15,19,.12) 75%,rgba(2,15,19,.35))}.bp-hero-copy{position:relative;z-index:2;width:min(790px,62vw);margin-left:clamp(24px,8vw,146px);padding-top:72px}.bp-eyebrow{margin:0 0 23px;color:#36d6cf;font-size:10px;line-height:1.4;font-weight:800;letter-spacing:.19em;text-transform:uppercase}.bp-eyebrow.dark{color:#287e7b}.bp-hero h1{margin:0;font-size:clamp(60px,7.2vw,116px);line-height:.91;letter-spacing:-.064em;font-weight:580}.bp-hero h1 em{color:rgba(255,255,255,.56);font-style:normal;font-weight:420}.bp-lead{max-width:650px;margin:30px 0 0;color:rgba(255,255,255,.72);font-size:clamp(17px,1.35vw,22px);line-height:1.58}.bp-actions{display:flex;align-items:center;gap:30px;margin-top:38px}.bp-button{display:inline-flex;align-items:center;gap:13px;border-radius:999px;padding:14px 22px;font-size:13px;font-weight:700}.bp-button.light{background:#fff;color:#06171d}.bp-button.dark{background:#06171d;color:#fff}.bp-link{font-size:13px;font-weight:700;color:rgba(255,255,255,.77)}.bp-live{position:absolute;z-index:3;right:clamp(24px,6vw,106px);bottom:74px;width:268px;padding:20px;border:1px solid rgba(255,255,255,.18);border-radius:16px;background:rgba(5,27,34,.72);backdrop-filter:blur(24px);box-shadow:0 24px 80px rgba(0,0,0,.25)}.bp-live>div{display:flex;justify-content:space-between;margin-bottom:25px;color:rgba(255,255,255,.5);font-size:8px;letter-spacing:.14em}.bp-live>div i{width:7px;height:7px;border-radius:50%;background:#36d6cf;box-shadow:0 0 0 6px rgba(54,214,207,.1)}.bp-live>strong{display:block;margin-bottom:15px;font-size:18px}.bp-live p{display:flex;justify-content:space-between;margin:0;padding:9px 0;border-top:1px solid rgba(255,255,255,.11);font-size:10px;color:rgba(255,255,255,.58)}.bp-live p b{color:#fff}.bp-live small{display:block;margin-top:11px;color:rgba(255,255,255,.34);font-size:8px}
.bp-proof{padding:48px clamp(24px,8vw,146px) 0;background:#f5f7f4}.bp-proof>p{text-align:center;color:#778082;font-size:11px}.bp-names{display:flex;justify-content:center;flex-wrap:wrap;gap:26px clamp(26px,4vw,62px);color:#7d8788;font-size:14px;font-weight:650}.bp-stats{max-width:1180px;margin:42px auto 0;padding:34px 0;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #dce2df;border-bottom:1px solid #dce2df}.bp-stats>div{padding:0 28px;border-left:1px solid #dce2df}.bp-stats>div:first-child{border-left:0}.bp-stats strong{display:block;font-size:clamp(24px,2.4vw,38px);letter-spacing:-.05em}.bp-stats span{display:block;margin-top:7px;color:#5b686a;font-size:10px}.award-red{color:#d71920}
.bp-value,.bp-audiences,.bp-software,.bp-projects,.bp-products,.bp-contact{padding:clamp(100px,10vw,160px) clamp(24px,8vw,146px)}.bp-section-intro{display:grid;grid-template-columns:1.25fr .75fr;gap:70px;align-items:end;max-width:1180px;margin:0 auto 68px}.bp-section-intro .bp-eyebrow{grid-column:1/-1;margin-bottom:-42px}.bp-section-intro h2,.bp-software-head h2{margin:0;font-size:clamp(44px,5.6vw,82px);line-height:.98;letter-spacing:-.057em;font-weight:520}.bp-section-intro>p:last-child,.bp-software-head>p{margin:0 0 7px;color:#5b686a;font-size:15px;line-height:1.7}.bp-value{background:#f5f7f4}.bp-value-list{max-width:1180px;margin:auto;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #dce2df;border-bottom:1px solid #dce2df}.bp-value-list article{min-height:310px;padding:28px 32px 36px;border-left:1px solid #dce2df;display:flex;flex-direction:column}.bp-value-list article:first-child{border-left:0}.bp-value-list span{font-size:10px;color:#829092}.bp-value-list h3{margin:auto 0 0;font-size:27px;font-weight:520;letter-spacing:-.035em}.bp-value-list p{color:#5b686a;font-size:13px;line-height:1.7}
.bp-audiences{background:#06171d;color:#fff}.light-copy h2{color:#fff}.light-copy>p:last-child{color:rgba(255,255,255,.55)}.bp-audience-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,.14)}.bp-audience-grid article{padding:0 42px 42px;background:#06171d}.bp-owner-visual,.bp-operator-visual{position:relative;height:270px;margin:0 -42px 38px;overflow:hidden;background:#0b252c}.bp-owner-visual{padding:44px;background:radial-gradient(circle at 80% 25%,rgba(54,214,207,.22),transparent 34%),#0b252c}.mini-top{height:24px;border-bottom:1px solid rgba(255,255,255,.1)}.mini-top i{display:inline-block;width:6px;height:6px;margin-right:6px;border-radius:50%;background:rgba(255,255,255,.3)}.mini-bars{height:125px;display:flex;align-items:end;gap:12px;padding:20px 12px;border-bottom:1px solid rgba(255,255,255,.1)}.mini-bars i{flex:1;height:42%;background:linear-gradient(#36d6cf,rgba(54,214,207,.1))}.mini-bars i:nth-child(2){height:65%}.mini-bars i:nth-child(3){height:52%}.mini-bars i:nth-child(4){height:78%}.mini-bars i:nth-child(5){height:68%}.mini-bars i:nth-child(6){height:92%}.mini-metrics{display:flex;justify-content:space-between;padding-top:20px;color:#fff;font-size:12px}.bp-operator-visual{background:radial-gradient(circle,rgba(54,214,207,.14),transparent 38%),linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px),#0b252c;background-size:auto,24px 24px,24px 24px}.building-wire{position:absolute;left:23%;top:24%;width:54%;height:54%;border:1px solid rgba(54,214,207,.58);transform:skewY(-8deg)}.building-wire i{position:absolute;width:7px;height:7px;border-radius:50%;background:#36d6cf;box-shadow:0 0 0 5px rgba(54,214,207,.1)}.building-wire i:nth-child(1){left:-4px;top:-4px}.building-wire i:nth-child(2){right:-4px;top:-4px}.building-wire i:nth-child(3){right:-4px;bottom:-4px}.building-wire i:nth-child(4){left:-4px;bottom:-4px}.bp-operator-visual>b{position:relative;display:inline-block;margin:22px 8px;padding:7px 9px;border:1px solid rgba(255,255,255,.15);font-size:8px;color:rgba(255,255,255,.58)}.bp-audience-grid article>span{color:#36d6cf;font-size:9px;letter-spacing:.16em}.bp-audience-grid h3{font-size:clamp(28px,3vw,40px);font-weight:500;letter-spacing:-.04em;margin:17px 0}.bp-audience-grid h3+p{min-height:96px;color:rgba(255,255,255,.58);font-size:13px;line-height:1.7}.bp-audience-grid ul{display:grid;grid-template-columns:1fr 1fr;gap:10px 18px;margin:24px 0 0;padding:22px 0 0;border-top:1px solid rgba(255,255,255,.13);list-style:none}.bp-audience-grid li{font-size:11px;color:rgba(255,255,255,.82)}.bp-audience-grid li:before{content:'•';color:#36d6cf;margin-right:8px}
.bp-software{background:#eef1ed}.bp-software-head{max-width:1180px;margin:0 auto 58px;display:grid;grid-template-columns:1.25fr .75fr;gap:70px;align-items:end}.bp-software-head>div>.bp-eyebrow{margin-bottom:18px}.bp-software-pair{max-width:1180px;margin:auto;display:grid;grid-template-columns:1.08fr .92fr;gap:28px}.bp-software-pair>a{min-height:590px;overflow:hidden;background:#fff}.bp-halo-panel{display:flex;flex-direction:column}.bp-halo-panel>div:first-child,.bp-core-panel>div:last-child{padding:48px 52px}.bp-software-pair a>div>span{color:#248480;font-size:9px;font-weight:800;letter-spacing:.15em}.bp-software-pair h3{margin:13px 0 16px;font-size:clamp(36px,4vw,58px);line-height:1.02;letter-spacing:-.055em;font-weight:500}.bp-software-pair p{color:#5b686a;font-size:13px;line-height:1.7}.halo-demo{width:calc(100% - 72px);height:280px;margin:auto 36px 0;display:grid;grid-template-columns:72px 1fr;border:1px solid #d6dedb;border-radius:14px 14px 0 0;overflow:hidden}.halo-demo aside{padding:22px 18px;background:#082027;color:#fff}.halo-demo aside b{display:block;color:#36d6cf;font-size:9px;margin-bottom:35px}.halo-demo aside i{display:block;width:20px;height:2px;margin:19px 0;background:rgba(255,255,255,.25)}.halo-demo main{padding:25px;background:#f5f7f4}.halo-demo main small{font-size:9px;color:#526064}.halo-demo main div{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:20px 0}.halo-demo main div b{background:#fff;border:1px solid #e2e7e4;padding:14px;font-size:10px}.halo-demo svg{width:100%;height:100px;background:repeating-linear-gradient(#fff,#fff 24px,#e8ecea 25px)}.halo-demo path{fill:none;stroke:#1ebbb5;stroke-width:3}.bp-core-panel{display:grid;grid-template-rows:292px auto;background:#06171d!important;color:#fff}.bp-core-panel p{color:rgba(255,255,255,.56)}.core-orbit{position:relative;display:grid;place-items:center;background:radial-gradient(circle,rgba(54,214,207,.19),transparent 43%),linear-gradient(rgba(255,255,255,.025) 1px,transparent 