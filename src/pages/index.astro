---
import BaseLayout from "../layouts/BaseLayout.astro";
import hero from "../assets/bluta-hero-city.webp";
import { products } from "../data/site";
import { projects } from "../data/projects";
import { getProductImage } from "../data/productMedia";

const featuredModels = ["BT102", "BT338", "BT306", "SYSTEM"];
const featuredProducts = featuredModels.map((model) => products.find((p) => p.model === model)).filter(Boolean);
const featuredProjects = projects.slice(0, 3);
---
<BaseLayout title="Blutech | Building AI and IoT for Real Buildings" description="Blutech designs connected building systems for owners and property teams: sensing, edge control, LoRaWAN, Bluetooth, Halo, Core and building-system integration." canonicalPath="/">
  <section class="home-hero">
    <img class="home-hero-image" src={hero.src} alt="Connected commercial building at night" width="1800" height="1100" fetchpriority="high" />
    <div class="home-hero-shade"></div>
    <div class="shell home-hero-content">
      <div class="eyebrow">Building AI and IoT</div>
      <h1>Make the building<br/>easier to understand.</h1>
      <p>Blutech connects precise sensing, local control, wireless networks and building software so owners can operate with clearer information — and design teams can specify one coherent system.</p>
      <div class="actions"><a class="button light" href="/projects">See deployed work</a><a class="text-link" href="/products">Explore products →</a></div>
    </div>
  </section>

  <section class="proof-bar"><div class="shell proof-bar-grid"><div><strong>Since 2019</strong><span>Building technology developed in Hong Kong</span></div><div><strong>1,000+ devices</strong><span>Connected at Three Garden Road</span></div><div><strong>Airport-wide</strong><span>Passenger-safety monitoring</span></div><div><strong class="award-red">iF DESIGN AWARD 2024</strong><span>Smart Washroom AIoT Solution</span></div></div></section>

  <section class="audience-section"><div class="shell audience-grid">
    <div class="section-intro"><div class="kicker">One intelligence layer · Two perspectives</div><h2>Useful to the people who own and run the building.</h2><p>Blutech starts with the operating decision the property needs to make, then coordinates the hardware, network, software and integration around it.</p></div>
    <article><span>01</span><h3>For owners</h3><p>See risk, utilisation and performance across the property. Connect evidence to ESG, asset planning and long-term improvement.</p></article>
    <article><span>02</span><h3>For operators</h3><p>Know what needs attention, where it happened and which workflow follows — through live status, floorplans, alerts and reports.</p></article>
  </div></section>

  <section class="software-home" id="software"><div class="shell">
    <div class="compact-head"><div><div class="kicker">Blutech software</div><h2>Halo for operations. Core for infrastructure.</h2><p>Two connected layers, each designed around a clear job.</p></div><a class="button secondary" href="/software">Explore software</a></div>
    <div class="software-pair"><a class="software-card" href="/software#halo"><div class="software-role">Owners & operators</div><h3>Blutech Halo</h3><p>Live status, floorplans, alerts, history, reports, roles and authorised controls — the day-to-day view of the building.</p><span>See Halo →</span></a><a class="software-card core" href="/software#core"><div class="software-role">Technical operations</div><h3>Blutech Core</h3><p>Devices, gateways, provisioning, configuration, connectivity health, rules, payloads, APIs and integrations.</p><span>See Core →</span></a></div>
  </div></section>

  <section class="home-products"><div class="shell">
    <div class="compact-head"><div><div class="kicker">Selected hardware</div><h2>Products that become part of the property.</h2><p>Commercially deployed sensing, display and control hardware, presented with clear system roles and project context.</p></div><a class="button secondary" href="/products">All products</a></div>
    <div class="product-grid home-product-grid">{featuredProducts.map((p:any) => { const image = getProductImage(p.model, p.image); return <a class="product-card" href={`/products/${p.slug}`}><div class="product-image"><img src={image} alt={`${p.model} ${p.name}`} loading="lazy" /></div><div class="product-card-copy"><div class="model">{p.model} · {p.family}</div><h3>{p.name}</h3><p>{p.summary}</p><span>Product details →</span></div></a>; })}</div>
  </div></section>

  <section class="home-projects"><div class="shell">
    <div class="compact-head"><div><div class="kicker">Selected work</div><h2>Credibility, shown in operating buildings.</h2><p>Each case study explains what was delivered, how it works and what it gives the owner or operating team.</p></div><a class="button secondary" href="/projects">All projects</a></div>
    <div class="project-grid three-up">{featuredProjects.map((p) => <a class="project-card" href={`/projects/${p.slug}`}><img src={p.image} alt={p.title} loading="lazy" /><div class="card-body"><div class="meta">{p.category} · {p.location}</div><h3>{p.title}</h3><p>{p.outcome}</p><div class="mini-kpis">{p.kpis.slice(0,2).map((k)=><span><b>{k.value}</b>{k.label}</span>)}</div><i>View case study →</i></div></a>)}</div>
  </div></section>

  <section class="recognition-strip"><div class="shell recognition-grid"><div><div class="kicker">Recognition</div><h2>Engineering credibility since 2019.</h2></div><div><b>Hong Kong ICT Awards</b><span>2020 · Award of the Year and ICT Startup Grand Award recognition</span></div><div><b>APICTA</b><span>2021 · Start Up of the Year recognition</span></div><div><b class="award-red">iF DESIGN AWARD</b><span>2024 · Smart Washroom AIoT Solution</span></div></div></section>

  <section class="final-cta"><div class="shell cta-panel"><div><div class="kicker">Work with Blutech</div><h2>Have a building problem that does not fit a catalogue?</h2><p>That is usually where our engineering work starts.</p></div><a class="button" href="/contact">Talk to Blutech</a></div></section>
</BaseLayout>

<style>
.home-hero{position:relative;min-height:680px;color:#fff;display:flex;align-items:flex-end;background:#071419;overflow:hidden}.home-hero-image,.home-hero-shade{position:absolute;inset:0;width:100%;height:100%}.home-hero-image{object-fit:cover}.home-hero-shade{background:linear-gradient(90deg,rgba(2,18,22,.94) 0%,rgba(2,18,22,.78) 42%,rgba(2,18,22,.18) 76%)}.home-hero-content{position:relative;padding:115px 0 92px}.home-hero h1{font-size:clamp(52px,6.2vw,84px);line-height:.96;letter-spacing:-.055em;margin:10px 0 26px;max-width:820px}.home-hero p{max-width:660px;font-size:20px;line-height:1.55;color:#ced8da}.button.light{background:#fff;border-color:#fff;color:#111}.text-link{font-weight:750;padding:12px 4px;border-bottom:1px solid rgba(255,255,255,.5)}
.proof-bar{padding:0;background:#fff;border-bottom:1px solid var(--line)}.proof-bar-grid{display:grid;grid-template-columns:repeat(4,1fr)}.proof-bar-grid>div{padding:23px 24px;border-right:1px solid var(--line)}.proof-bar-grid>div:first-child{padding-left:0}.proof-bar-grid>div:last-child{border-right:0}.proof-bar strong,.proof-bar span{display:block}.proof-bar strong{font-size:15px}.proof-bar span{font-size:12px;color:var(--muted);margin-top:4px}.award-red{color:#d71920!important}
.audience-grid{display:grid;grid-template-columns:1.4fr .8fr .8fr;gap:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.audience-grid>*{padding:34px}.audience-grid>*:first-child{padding-left:0}.audience-grid article{border-left:1px solid var(--line)}.audience-grid h2,.compact-head h2,.recognition-grid h2,.cta-panel h2{font-size:clamp(34px,3.6vw,52px);line-height:1.04;letter-spacing:-.045em;margin:10px 0 14px}.audience-grid p,.compact-head p{color:var(--muted);margin:0}.audience-grid article span{font-size:10px;color:var(--brand-2);font-weight:900}.audience-grid article h3{font-size:28px;margin:44px 0 10px}
.compact-head{display:flex;justify-content:space-between;align-items:end;gap:50px;margin-bottom:34px}.compact-head>div{max-width:830px}.software-home{background:#edf0ee}.software-pair{border-radius:2px;overflow:hidden}.software-card{display:block}.software-card>span{display:inline-block;margin-top:24px;font-size:13px;border-bottom:1px solid currentColor;font-weight:800}.home-products{background:#fff}.home-product-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.product-card-copy{padding:18px 20px 22px;display:flex;flex-direction:column;flex:1}.product-card-copy h3{font-size:22px;margin:7px 0 8px}.product-card-copy p{font-size:13px}.product-card-copy>span{margin-top:auto;padding-top:20px;font-size:12px;font-weight:800}
.home-projects{background:#f0f1ee}.project-grid.three-up{grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.project-card{background:#fff}.project-card img{aspect-ratio:16/10}.project-card .card-body{padding:20px}.project-card h3{font-size:27px}.mini-kpis{display:flex;gap:20px;border-top:1px solid var(--line);margin-top:18px;padding-top:14px}.mini-kpis span{font-size:10px;color:var(--muted)}.mini-kpis b{display:block;color:var(--ink);font-size:16px}.project-card i{display:inline-block;margin-top:18px;font-size:12px;font-style:normal;font-weight:800}
.recognition-strip{background:#fff}.recognition-grid{display:grid;grid-template-columns:1.15fr repeat(3,.75fr);gap:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.recognition-grid>div{padding:28px}.recognition-grid>div:first-child{padding-left:0}.recognition-grid>div+div{border-left:1px solid var(--line);display:flex;flex-direction:column;justify-content:center}.recognition-grid b,.recognition-grid span{display:block}.recognition-grid span{font-size:12px;color:var(--muted);margin-top:8px}.final-cta{background:#f7f7f4}.cta-panel{border:1px solid var(--line);background:#fff;padding:40px;display:flex;align-items:end;justify-content:space-between;gap:48px}.cta-panel p{color:var(--muted);margin:0}
@media(max-width:1000px){.audience-grid{grid-template-columns:1fr 1fr}.audience-grid .section-intro{grid-column:1/-1}.audience-grid article:nth-child(2){border-left:0}.home-product-grid{grid-template-columns:repeat(2,1fr)}.project-grid.three-up{grid-template-columns:1fr 1fr}.recognition-grid{grid-template-columns:1fr 1fr}.recognition-grid>div:nth-child(3){border-left:0}}
@media(max-width:700px){.home-hero{min-height:610px}.home-hero-content{padding:88px 0 64px}.home-hero p{font-size:17px}.proof-bar-grid,.audience-grid,.home-product-grid,.project-grid.three-up,.recognition-grid{grid-template-columns:1fr}.proof-bar-grid>div,.audience-grid>*{padding:18px 0;border-right:0!important;border-left:0!important;border-bottom:1px solid var(--line)}.compact-head,.cta-panel{display:block}.compact-head .button,.cta-panel .button{margin-top:22px}.recognition-grid>div{padding:22px 0;border-left:0!important}.cta-panel{padding:28px}.project-grid.three-up{gap:24px}}
</style>
