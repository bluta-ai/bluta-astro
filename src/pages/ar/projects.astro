astro
---
import { Image } from "astro:assets";
import project1 from "../../assets/bluta-project1.webp";
import project2 from "../../assets/bluta-project2.webp";
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <title>مشاريعنا | بلوتا</title>
  <meta name="description" content="مشاريع بلوتا الناجحة في قطر ودول الخليج - أتمتة المباني والتحكم الذكي في الطاقة" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b1020" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">

  <style>
    /* [Same CSS styles as above] */
    :root{
      --bg:#0b1020; --panel:#121a2e; --ink:#e5e7eb; --muted:#9aa3b2;
      --line:#1f2a44; --brand:#00C3D8; --brand2:#a78bfa; --nav-h:68px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:linear-gradient(180deg,#0a0f1f 0%,#0b1020 18%,#0b1020 100%);color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial}
    a{color:var(--ink);text-decoration:none}
    .container{max-width:1200px;margin:0 auto;padding:0 20px}
    :root[lang="ar"] body {font-family: 'Tajawal', ui-sans-serif, system-ui, sans-serif;}
    .nav{position:sticky;top:0;z-index:50;height:var(--nav-h);backdrop-filter:saturate(1.2) blur(8px);background:rgba(10,14,28,.7);border-bottom:1px solid var(--line)}
    .nav-inner{display:flex;gap:16px;align-items:center;justify-content:space-between;height:100%}
    .brand{display:flex;gap:10px;align-items:center;font-weight:800;font-family:'Comfortaa', ui-sans-serif, system-ui}
    .wordmark{font-weight:800;font-size:24px;letter-spacing:.2px;text-transform:lowercase}
    .wordmark .blu{color:var(--brand)}
    .wordmark .ta{color:#fff}
    .nav-links{display:flex;align-items:center;gap:10px}
    .nav-links a{display:inline-block;padding:10px 12px;border-radius:10px;font-weight:700;color:#dbe3f3}
    .nav-links a:hover{background:rgba(255,255,255,.06)}
    .nav-links a.active{background:rgba(255,255,255,.1)}
    .language-switcher {display: flex;gap: 8px;align-items: center;margin-left: 20px;padding-left: 20px;border-left: 1px solid var(--line)}
    .language-switcher a {text-decoration: none;color: #9aa3b2;font-weight: 600;font-size: 14px;padding: 4px 8px;border-radius: 6px}
    .language-switcher a:hover {color: #00C3D8;background: rgba(255,255,255,0.05)}
    section{padding:80px 0}
    .grid{display:grid;gap:30px}
    .col-2{grid-template-columns:1fr 1fr}
    .col-3{grid-template-columns:repeat(3,1fr)}
    @media(max-width:980px){.col-2,.col-3{grid-template-columns:1fr}}
    .card{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));border:1px solid var(--line);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.25);transition:transform 0.3s ease}
    .card:hover{transform:translateY(-5px)}
    .p-6{padding:24px}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:12px;font-weight:800;border:1px solid var(--line);background:rgba(255,255,255,.04);cursor:pointer;transition:all 0.3s ease}
    .btn.primary{background:linear-gradient(120deg,var(--brand),var(--brand2));color:#0b1020;border-color:transparent}
    .btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(0,195,216,0.3)}
    .subtitle{color:var(--muted);font-size:20px;text-align:center;max-width:900px;margin:0px auto 0;line-height:1.6}
    .h1{font-size:clamp(32px,4vw,56px);line-height:1.1;margin:10px 0;text-align:center;font-weight:900}
    .h2{font-size:36px;margin:0 0 16px;font-weight:800}
    .h3{font-size:24px;margin:0 0 12px;font-weight:700}
    .pill{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;background:rgba(96,165,250,.12);color:#c7d2fe;font-weight:800;font-size:14px;border:1px solid var(--line)}
    .muted{color:var(--muted);line-height:1.6}
    .image{overflow:hidden;border-radius:16px;border:1px solid var(--line);background:#050814}
    .image img, .image picture{display:block;width:100%;height:100%;object-fit:cover;transition:transform 0.3s ease}
    .image:hover img{transform:scale(1.05)}
    :root[dir="rtl"] .nav-links {margin-right: auto;margin-left: 0;}
    .project-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin:40px 0}
    @media(max-width:768px){.project-stats{grid-template-columns:repeat(2,1fr)}}
    .stat-box{text-align:center;padding:20px}
    .stat-number{font-size:36px;font-weight:900;color:var(--brand);margin-bottom:8px}
    .stat-label{color:var(--muted);font-size:14px;font-weight:600}
  </style>
</head>

<body>
  <!-- التنقل -->
  <div class="nav">
    <div class="container nav-inner">
      <a href="/ar/" class="brand" aria-label="بلوتا الرئيسية">
        <span class="wordmark"><span class="blu">blu</span><span class="ta">ta</span></span>
      </a>
      <div class="nav-links">
        <a href="/ar/" data-nav="home">الرئيسية</a>
        <a href="/ar/solutions" data-nav="solutions">الحلول</a>
        <a href="/ar/hardware" data-nav="hardware">الأجهزة</a>
        <a href="/ar/projects" data-nav="projects" class="active">المشاريع</a>
        <a href="/ar/#contact" data-nav="contact">اتصل بنا</a>
        <div class="language-switcher">
          <a href="/projects">EN</a>
          <span>|</span>
          <a href="/ar/projects">AR</a>
        </div>
      </div>
    </div>
  </div>

  <!-- قسم البطل -->
  <section>
    <div class="container">
      <div style="text-align:center">
        <span class="pill">نجاحاتنا في الخليج العربي</span>
        <h1 class="h1">مشاريع بلوتا الناجحة<br>في المنطقة</h1>
        <p class="subtitle">
          اكتشف كيف ساعدت حلول بلوتا في تحويل عمليات المباني وتحقيق توفير كبير في التكاليف across الخليج العربي
        </p>
      </div>
    </div>
  </section>

  <!-- إحصائيات المشاريع -->
  <section>
    <div class="container">
      <div class="project-stats">
        <div class="stat-box">
          <div class="stat-number">50+</div>
          <div class="stat-label">مشروع منفذ</div>
        </div>
        <div class="stat-box">
          <div class="stat-number">35%</div>
          <div class="stat-label">متوسط توفير الطاقة</div>
        </div>
        <div class="stat-box">
          <div class="stat-number">98%</div>
          <div class="stat-label">رضا العملاء</div>
        </div>
        <div class="stat-box">
          <div class="stat-number">24/7</div>
          <div class="stat-label">دعم فني عربي</div>
        </div>
      </div>
    </div>
  </section>

  <!-- المشاريع البارزة -->
  <section>
    <div class="container">
      <div class="h2" style="text-align:center">مشاريعنا البارزة</div>
      
      <div class="grid col-2" style="margin-top:40px">
        <!-- مشروع 1 -->
        <div class="card" style="overflow:hidden">
          <div class="image" style="height:300px">
            <div style="display:flex;align-items:center;justify-content:center;height:100%;background:linear-gradient(135deg,#121a2e,#1f2a44);color:var(--muted);font-size:18px">
              مشروع مركز تجاري في الدوحة
            </div>
          </div>
          <div class="p-6">
            <span class="pill">مركز تسوق - الدوحة</span>
            <h3>مجمع التسوق الحديث - الدوحة</h3>
            <p class="muted">أتمتة متكاملة لمركز تسوق بمساحة 85,000 متر مربع في قلب الدوحة.</p>
            <div style="margin-top:20px">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:15px">
                <div><strong>التوفير المحقق:</strong></div>
                <div>28% في استهلاك الطاقة</div>
                <div><strong>مدة التنفيذ:</strong></div>
                <div>6 أسابيع</div>
                <div><strong>التكاملات:</strong></div>
                <div>أنظمة التكييف، المراقبة، مواقف السيارات</div>
              </div>
              <p class="muted">تم تركيب 120 جهاز استشعار لمراقبة جودة الهواء والإشغال، مما أدى إلى تحسين تجربة المتسوقين وخفض التكاليف التشغيلية.</p>
            </div>
          </div>
        </div>

        <!-- مشروع 2 -->
        <div class="card" style="overflow:hidden">
          <div class="image" style="height:300px">
            <div style="display:flex;align-items:center;justify-content:center;height:100%;background:linear-gradient(135deg,#1f2a44,#121a2e);color:var(--muted);font-size:18px">
              مشروع برج مكاتب في أبوظبي
            </div>
          </div>
          <div class="p-6">
            <span class="pill">برج مكاتب - أبوظبي</span>
            <h3>برج الأعمال الدولي</h3>
            <p class="muted">نظام إدارة مباني ذكي لبرج مكاتع مكون من 40 طابقًا في أبوظبي.</p>
            <div style="margin-top:20px">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:15px">
                <div><strong>التوفير المحقق:</strong></div>
                <div>32% في تكاليف التشغيل</div>
                <div><strong>مدة التنفيذ:</strong></div>
                <div>8 أسابيع</div>
                <div><strong>التكاملات:</strong></div>
                <div>المصاعد، التحكم في الوصول، الطاقة</div>
              </div>
              <p class="muted">تحسين كفاءة الطاقة وتجربة المستأجرين من خلال التحكم الذكي في التكييف والإضاءة بناءً على أنماط الإشغال.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- المزيد من المشاريع -->
      <div class="grid col-3" style="margin-top:40px">
        <div class="card p-6">
          <span class="pill">مستشفى - الرياض</span>
          <h4>المجمع الطبي المتخصص</h4>
          <p class="muted">نظام مراقبة جودة الهواء والإشغال للمناطق الحرجة في المستشفى.</p>
          <div style="margin-top:15px">
            <div style="color:var(--brand);font-weight:700">22% توفير في الطاقة</div>
            <div class="muted" style="font-size:12px;margin-top:5px">تحسين جودة الهواء في غرف العمليات والعناية المركزة</div>
          </div>
        </div>

        <div class="card p-6">
          <span class="pill">فندق - دبي</span>
          <h4>منتجع الخمس نجوم</h4>
          <p class="muted">أتمتة الغرف والمناطق العامة لتحسين تجربة النزيل وتقليل الهدر.</p>
          <div style="margin-top:15px">
            <div style="color:var(--brand);font-weight:700">40% تخفيض عمالة</div>
            <div class="muted" style="font-size:12px;margin-top:5px">أتمتة عمليات الصيانة والتنظيف</div>
          </div>
        </div>

        <div class="card p-6">
          <span class="pill>جامعة - مسقط</span>
          <h4>الحرم الجامعي الذكي</h4>
          <p class="muted">إدارة الطاقة والإشغال across 15 مبنى في الحرم الجامعي.</p>
          <div style="margin-top:15px">
            <div style="color:var(--brand);font-weight:700">25% توفير طاقة</div>
            <div class="muted" style="font-size:12px;margin-top:5px">تحسين راحة الطلاب والعاملين</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- قصص النجاح -->
  <section style="background:linear-gradient(135deg,rgba(0,195,216,0.05),rgba(167,139,250,0.05))">
    <div class="container">
      <div class="h2" style="text-align:center">قصص نجاح عملائنا</div>
      <div class="grid col-2" style="margin-top:40px">
        <div class="card p-6">
          <div style="display:flex;align-items:center;gap:15px;margin-bottom:20px">
            <div style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,var(--brand),var(--brand2));display:flex;align-items:center;justify-content:center;color:white;font-weight:800">م.ع</div>
            <div>
              <div style="font-weight:800">المهندس أحمد السيد</div>
              <div class="muted">مدير المرافق - مجموعة عقارية</div>
            </div>
          </div>
          <p class="muted">"بلوتا غيرت طريقة إدارتنا للمباني. وفرت لنا أكثر من 30% في تكاليف الطاقة وخفضت شكاوى المستأجرين بنسبة 60%. الدعم باللغة العربية كان عاملًا حاسمًا لفريقنا."</p>
        </div>

        <div class="card p-6">
          <div style="display:flex;align-items:center;gap:15px;margin-bottom:20px">
            <div style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,var(--brand2),var(--brand));display:flex;align-items:center;justify-content:center;color:white;font-weight:800">د.م</div>
            <div>
              <div style="font-weight:800">الدكتورة منى الخليفي</div>
              <div class="muted">مديرة المستشفى - القطاع الصحي</div>
            </div>
          </div>
          <p class="muted">"الحل حافظ على خصوصية المرضى والعاملين مع توفير بيانات دقيقة ساعدتنا في تحسين توزيع الموارد. النظام سهل الاستخدام بالعربية وكان التدريب سريعًا وفعالًا."</p>
        </div>
      </div>
    </div>
  </section>

  <!-- دعوة للعمل -->
  <section>
    <div class="container">
      <div class="card p-6" style="background:linear-gradient(135deg,rgba(167,139,250,.15),rgba(0,195,216,.15));text-align:center">
        <h2>اجعل مشروعك القادم قصة نجاح</h2>
        <p class="muted" style="max-width:600px;margin:20px auto">انضم إلى قائمة عملائنا الراضين في الخليج العربي. دعنا نناقش كيف يمكن لبلوتا تحويل مبناك.</p>
        <div style="margin-top:30px;display:flex;gap:15px;flex-wrap:wrap;justify-content:center">
          <a class="btn primary" href="/ar/#contact">ابدأ مشروعك</a>
          <a class="btn" href="/ar/solutions">استكشاف الحلول</a>
        </div>
      </div>
    </div>
  </section>

</body>
</html>