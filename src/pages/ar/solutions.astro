astro
---
import { Image } from "astro:assets";

// Import images
import solutionsHero from "../../assets/bluta-solutions-hero.webp";
import aiDashboard from "../../assets/bluta-ai-dashboard.webp";
import energyManagement from "../../assets/bluta-energy-management.webp";
import commandCenter from "../../assets/bluta-command-center.webp";
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <title>حلول المباني الذكية بالذكاء الاصطناعي لدول الخليج وقطر | بلوتا</title>
  <meta name="description" content="حلول ذكية بالذكاء الاصطناعي مصممة خصيصًا لقطر ومنطقة الخليج. تحسين الطاقة، دعم اللغة العربية، وأتمتة المباني مع الحفاظ على الخصوصية." />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b1020" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0b1020; --panel:#121a2e; --ink:#e5e7eb; --muted:#9aa3b2;
      --line:#1f2a44; --brand:#00C3D8; --brand2:#a78bfa; --nav-h:68px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:linear-gradient(180deg,#0a0f1f 0%,#0b1020 18%,#0b1020 100%);color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial}
    a{color:var(--ink);text-decoration:none}
    .container{max-width:1200px;margin:0 auto;padding:0 20px}

    /* Arabic font support */
    :root[lang="ar"] body {
      font-family: 'Tajawal', ui-sans-serif, system-ui, sans-serif;
    }

    /* NAV */
    .nav{position:sticky;top:0;z-index:50;height:var(--nav-h);backdrop-filter:saturate(1.2) blur(8px);background:rgba(10,14,28,.7);border-bottom:1px solid var(--line)}
    .nav-inner{display:flex;gap:16px;align-items:center;justify-content:space-between;height:100%}
    .brand{display:flex;gap:10px;align-items:center;font-weight:800;font-family:'Comfortaa', ui-sans-serif, system-ui}
    .wordmark{font-weight:800;font-size:24px;letter-spacing:.2px;text-transform:lowercase}
    .wordmark .blu{color:var(--brand)}
    .wordmark .ta{color:#fff}
    .nav-links{display:flex;align-items:center;gap:10px}
    .nav-links a{display:inline-block;padding:10px 12px;border-radius:10px;font-weight:700;color:#dbe3f3}
    .nav-links a:hover{background:rgba(255,255,255,.06)}
    .nav-links a.active{background:rgba(255,255,255,.1)}

    /* Language Switcher */
    .language-switcher {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-left: 20px;
      padding-left: 20px;
      border-left: 1px solid var(--line);
    }
    .language-switcher a {
      text-decoration: none;
      color: #9aa3b2;
      font-weight: 600;
      font-size: 14px;
      padding: 4px 8px;
      border-radius: 6px;
    }
    .language-switcher a:hover {
      color: #00C3D8;
      background: rgba(255,255,255,0.05);
    }

    /* LAYOUT */
    section{padding:80px 0}
    .grid{display:grid;gap:30px}
    .col-2{grid-template-columns:1fr 1fr}
    .col-3{grid-template-columns:repeat(3,1fr)}
    @media(max-width:980px){.col-2,.col-3{grid-template-columns:1fr}}
    .card{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));border:1px solid var(--line);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.25);transition:transform 0.3s ease}
    .card:hover{transform:translateY(-5px)}
    .p-6{padding:24px}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:12px;font-weight:800;border:1px solid var(--line);background:rgba(255,255,255,.04);cursor:pointer;transition:all 0.3s ease}
    .btn.primary{background:linear-gradient(120deg,var(--brand),var(--brand2));color:#0b1020;border-color:transparent}
    .btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(0,195,216,0.3)}
    .subtitle{color:var(--muted);font-size:20px;text-align:center;max-width:900px;margin:0px auto 0;line-height:1.6}
    .h1{font-size:clamp(32px,4vw,56px);line-height:1.1;margin:10px 0;text-align:center;font-weight:900}
    .h2{font-size:36px;margin:0 0 16px;font-weight:800}
    .h3{font-size:24px;margin:0 0 12px;font-weight:700}
    .pill{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;background:rgba(96,165,250,.12);color:#c7d2fe;font-weight:800;font-size:14px;border:1px solid var(--line)}
    .muted{color:var(--muted);line-height:1.6}

    .image{overflow:hidden;border-radius:16px;border:1px solid var(--line);background:#050814}
    .image img, .image picture{display:block;width:100%;height:100%;object-fit:cover;transition:transform 0.3s ease}
    .image:hover img{transform:scale(1.05)}

    /* Solutions Specific Styles */
    .solution-hero{position:relative;padding:120px 0 80px;text-align:center}
    .solution-hero-bg{position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(135deg,rgba(0,195,216,0.1),rgba(167,139,250,0.1))}
    
    .feature-grid{display:grid;gap:24px;margin-top:40px}
    .feature-card{text-align:center;padding:30px}
    .feature-icon{width:80px;height:80px;margin:0 auto 20px;background:linear-gradient(135deg,var(--brand),var(--brand2));border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:32px}
    
    .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin:40px 0}
    @media(max-width:768px){.stats-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:480px){.stats-grid{grid-template-columns:1fr}}
    .stat-card{text-align:center;padding:20px}
    .stat-number{font-size:36px;font-weight:900;color:var(--brand);margin-bottom:8px}
    .stat-label{color:var(--muted);font-size:14px;font-weight:600}
    
    .use-case{background:rgba(255,255,255,.02);border-radius:16px;padding:30px;margin:20px 0}
    .use-case h4{color:var(--brand);margin-bottom:12px}
    
    .integration-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:rgba(255,255,255,.05);border-radius:8px;font-size:12px;font-weight:600;margin:4px}

    /* RTL Adjustments */
    :root[dir="rtl"] .nav-links {
      margin-right: auto;
      margin-left: 0;
    }
    :root[dir="rtl"] .stats-grid,
    :root[dir="rtl"] .feature-grid {
      text-align: center;
    }
  </style>
</head>

<body>
  <!-- NAV -->
  <div class="nav">
    <div class="container nav-inner">
      <a href="/ar/" class="brand" aria-label="bluta home">
        <span class="wordmark"><span class="blu">blu</span><span class="ta">ta</span></span>
      </a>
      <div class="nav-links">
        <a href="/ar/" data-nav="home">الرئيسية</a>
        <a href="/ar/solutions" data-nav="solutions" class="active">الحلول</a>
        <a href="/ar/hardware" data-nav="hardware">الأجهزة</a>
        <a href="/ar/projects" data-nav="projects">المشاريع</a>
        <a href="/ar/#contact" data-nav="contact">اتصل بنا</a>
        <div class="language-switcher">
          <a href="/solutions">EN</a>
          <span>|</span>
          <a href="/ar/solutions">AR</a>
        </div>
      </div>
    </div>
  </div>

  <!-- SOLUTIONS HERO -->
  <section class="solution-hero">
    <div class="solution-hero-bg"></div>
    <div class="container">
      <div style="position:relative;z-index:2">
        <span class="pill">مصمم خصيصًا لقطر ومنطقة الخليج</span>
        <h1 class="h1">حلول الذكاء الاصطناعي<br>لمباني أكثر ذكاءً في الشرق الأوسط</h1>
        <p class="subtitle">
          تقدم بلوتا أتمتة المباني الذكية مع دعم اللغة العربية، مصممة خصيصًا لاحتياجات المناخ والعمليات في دول الخليج.
        </p>
        <div style="margin-top:30px;display:flex;gap:15px;flex-wrap:wrap;justify-content:center">
          <a class="btn primary" href="#demo">طلب عرض توضيحي للخليج</a>
          <a class="btn" href="#solutions">استكشاف الحلول</a>
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK STATS -->
  <section>
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">50-30%</div>
          <div class="stat-label">تخفيض تكاليف العمالة</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">25-15%</div>
          <div class="stat-label">توفير في الطاقة</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">24/7</div>
          <div class="stat-label">دعم اللغة العربية</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">100%</div>
          <div class="stat-label">متوافق مع الخصوصية</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CORE SOLUTIONS -->
  <section id="solutions">
    <div class="container">
      <div class="h2" style="text-align:center">حلول المباني الشاملة بالذكاء الاصطناعي</div>
      <p class="subtitle">منصة أتمتة متكاملة مصممة لمتطلبات المباني في الشرق الأوسط</p>
      
      <div class="grid col-3" style="margin-top:50px">
        <!-- Solution 1 -->
        <div class="card p-6">
          <div class="feature-icon">🌡️</div>
          <h3>الطاقة الذكية والتكييف</h3>
          <p class="muted">التحكم المناخي بالذكاء الاصطناعي المُحسَّن لدرجات الحرارة القصوى في الخليج. خفض تكاليف التبريد مع الحفاظ على مستويات الراحة المثالية.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">أنظمة التكييف</span>
            <span class="integration-badge">عدادات الطاقة</span>
            <span class="integration-badge">بيانات الطقس</span>
          </div>
          <div class="use-case">
            <h4>حالة استخدام قطر</h4>
            <p class="muted">ضبط التبريد تلقائيًا بناءً على أوقات الصلاة وأنماط الإشغال في المساجد والمباني العامة.</p>
          </div>
        </div>

        <!-- Solution 2 -->
        <div class="card p-6">
          <div class="feature-icon">👥</div>
          <h3>تحليلات الأشخاص والمساحات</h3>
          <p class="muted">تتبع الإشغال مع الحفاظ على الخصوصية وإدارة الحشود. تحسين استخدام المساحات دون المساس بالبيانات الشخصية.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">عد الأشخاص</span>
            <span class="integration-badge">إدارة الطوابير</span>
            <span class="integration-badge">استخدام المساحات</span>
          </div>
          <div class="use-case">
            <h4>مراكز التسوق والتجزئة</h4>
            <p class="muted">إدارة ساعات التسوق الذروة وتحسين عمليات المطاعم خلال الازدحام في عطلات نهاية الأسبوع.</p>
          </div>
        </div>

        <!-- Solution 3 -->
        <div class="card p-6">
          <div class="feature-icon">🛡️</div>
          <h3>مركز العمليات الموحد</h3>
          <p class="muted">التحكم المركزي لجميع أنظمة المبنى مع واجهة عربية. منصة واحدة لفرق الصيانة والأمن والمرافق.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">تكامل أنظمة إدارة المباني</span>
            <span class="integration-badge">أنظمة المراقبة</span>
            <span class="integration-badge">التحكم في الوصول</span>
          </div>
          <div class="use-case">
            <h4>المباني الحكومية</h4>
            <p class="muted">عمليات أمنية وصيانة موحدة لمباني الوزارات والمرافق العامة.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARABIC LANGUAGE SUPPORT -->
  <section style="background:linear-gradient(135deg,rgba(0,195,216,0.05),rgba(167,139,250,0.05))">
    <div class="container">
      <div class="grid col-2" style="align-items:center">
        <div>
          <span class="pill">تصميم عربي أولاً</span>
          <h2>مبني لسوق الشرق الأوسط</h2>
          <p class="muted">دعم كامل للغة العربية مع فهم اللهجات الإقليمية والسياق الثقافي.</p>
          <ul class="muted" style="line-height:2;margin-top:20px">
            <li>✓ واجهة باللغة العربية الفصحى</li>
            <li>✓ فهم اللهجات الخليجية في نماذج الذكاء الاصطناعي</li>
            <li>✓ دعم التخطيط من اليمين لليسار</li>
            <li>✓ الامتثال المحلي وسيادة البيانات</li>
            <li>✓ وثائق ودعم باللغة العربية</li>
          </ul>
        </div>
        <div class="image" style="height:400px">
          <div style="display:flex;align-items:center;justify-content:center;height:100%;background:linear-gradient(135deg,#121a2e,#1f2a44);color:var(--muted);font-size:18px">
            لوحة تحكم الذكاء الاصطناعي بالعربية
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRY SOLUTIONS -->
  <section>
    <div class="container">
      <div class="h2" style="text-align:center">حلول مصممة حسب القطاع</div>
      <p class="subtitle">أتمتة مخصصة للقطاعات الرئيسية في قطر</p>
      
      <div class="grid col-3" style="margin-top:40px">
        <div class="card p-6">
          <h3>🏢 العقارات التجارية</h3>
          <p class="muted">إدارة الطاقة على مستوى المحفظة وتحسين راحة المستأجرين للأبراج المكتبية والمناطق التجارية.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">فوترة المستأجرين</span>
            <span class="integration-badge">تقارير ESG</span>
            <span class="integration-badge">الصيانة الوقائية</span>
          </div>
        </div>

        <div class="card p-6">
          <h3>🛍️ التجزئة ومراكز التسوق</h3>
          <p class="muted">تعزيز تجربة العملاء والكفاءة التشغيلية للمولات ومراكز التسوق.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">تحليلات تدفق العملاء</span>
            <span class="integration-badge">مواقف السيارات الذكية</span>
            <span class="integration-badge">خرائط حرارة المتاجر</span>
          </div>
        </div>

        <div class="card p-6">
          <h3>🏥 المنشآت الصحية</h3>
          <p class="muted">راحة المرضى والتميز التشغيلي للمستشفيات والمراكز الطبية.</p>
          <div style="margin-top:20px">
            <span class="integration-badge">مراقبة جودة الهواء الداخلي</span>
            <span class="integration-badge">تتبع المعدات</span>
            <span class="integration-badge">تقارير الامتثال</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TECHNOLOGY STACK -->
  <section>
    <div class="container">
      <div class="h2" style="text-align:center">مجموعة التقنيات المتقدمة</div>
      <div class="grid col-2" style="margin-top:40px">
        <div class="card p-6">
          <h3>الذكاء الاصطناعي وتعلم الآلة</h3>
          <ul class="muted" style="line-height:2;margin-top:15px">
            <li>• خوارزميات الصيانة التنبؤية</li>
            <li>• كشف الشذوذ في أنظمة المباني</li>
            <li>• معالجة اللغة العربية للأوامر الصوتية</li>
            <li>• الرؤية الحاسوبية لتحليلات المساحات</li>
            <li>• توقع استهلاك الطاقة</li>
          </ul>
        </div>
        <div class="card p-6">
          <h3>الخصوصية والأمان</h3>
          <ul class="muted" style="line-height:2;margin-top:15px">
            <li>• خيارات النشر داخل الموقع</li>
            <li>• الامتثال للمعايير المحلية وأوروبا</li>
            <li>• التشفير من الطرف إلى الطرف</li>
            <li>• عدم جمع البيانات الشخصية</li>
            <li>• تدقيق أمني منتظم</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section id="demo">
    <div class="container">
      <div class="card p-6" style="background:linear-gradient(135deg,rgba(167,139,250,.15),rgba(0,195,216,.15));text-align:center">
        <h2>مستعد لتحويل عمليات مبناك؟</h2>
        <p class="muted" style="max-width:600px;margin:20px auto">شاهد كيف يمكن لبلوتا تقليل التكاليف وتحسين الكفاءة في منشأتك القطرية أو الخليجية.</p>
        <div style="margin-top:30px;display:flex;gap:15px;flex-wrap:wrap;justify-content:center">
          <a class="btn primary js-request-demo" href="#demo-modal">طلب عرض توضيحي للخليج</a>
          <a class="btn" href="/ar/contact">اتصل بفريق قطر</a>
        </div>
        <p class="muted" style="margin-top:20px;font-size:14px">فريق دعم ناطق بالعربية متاح</p>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section>
    <div class="container">
      <div class="h2" style="text-align:center">الأسئلة الشائعة</div>
      <div class="grid col-2" style="margin-top:40px;gap:40px">
        <div>
          <h4>هل تدعمون اللغة العربية بالكامل؟</h4>
          <p class="muted">نعم، واجهة عربية كاملة مع دعم للعربية الفصحى وفهم اللهجات الخليجية في نماذج الذكاء الاصطناعي.</p>
        </div>
        <div>
          <h4>هل يتم تخزين بياناتي محليًا في قطر؟</h4>
          <p class="muted">نقدم خيارات نشر سحابية وداخلية لتلبية متطلبات سيادة البيانات في قطر.</p>
        </div>
        <div>
          <h4>كم تستغرق عملية التنفيذ؟</h4>
          <p class="muted">عادة من 4 إلى 8 أسابيع حسب حجم المبنى ومتطلبات تكامل الأنظمة.</p>
        </div>
        <div>
          <h4>هل تقدمون تدريبًا باللغة العربية؟</h4>
          <p class="muted">نعم، تدريب شامل ووثائق متاحة باللغة العربية لفريقك.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Demo Modal -->
  <div id="demo-modal" class="modal hidden">
    <div class="modal-backdrop js-close-demo"></div>
    <div class="modal-panel">
      <button class="modal-close js-close-demo">✕</button>
      <h3 class="modal-title">طلب عرض توضيحي للخليج</h3>
      <p class="modal-sub">سيتصل بك فريق قطر لجدولة عرض توضيحي مخصص.</p>
      <form class="demo-form" action="https://formspree.io/f/xyznyolp" method="POST">
        <input type="text" name="_gotcha" style="display:none">
        <div class="field">
          <label for="demo-name">الاسم</label>
          <input id="demo-name" name="name" type="text" required placeholder="اسمك">
        </div>
        <div class="field">
          <label for="demo-email">البريد الإلكتروني</label>
          <input id="demo-email" name="email" type="email" required placeholder="you@example.com">
        </div>
        <div class="field">
          <label for="demo-company">الشركة</label>
          <input id="demo-company" name="company" type="text" placeholder="اسم الشركة">
        </div>
        <div class="field">
          <label for="demo-building">نوع المبنى</label>
          <select id="demo-building" name="building_type">
            <option value="">اختر نوع المبنى</option>
            <option value="commercial">مكتب تجاري</option>
            <option value="retail">مركز تسوق/تجزئة</option>
            <option value="healthcare">مستشفى/رعاية صحية</option>
            <option value="hospitality">فندق/منتجع</option>
            <option value="government">مبنى حكومي</option>
            <option value="other">أخرى</option>
          </select>
        </div>
        <button type="submit" class="btn primary" style="width:100%">طلب العرض التوضيحي</button>
      </form>
    </div>
  </div>

  <script>
    // Modal functionality
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('demo-modal');
      const openers = document.querySelectorAll('.js-request-demo');
      const closers = document.querySelectorAll('.js-close-demo');

      openers.forEach(opener => {
        opener.addEventListener('click', function(e) {
          e.preventDefault();
          modal.classList.remove('hidden');
        });
      });

      closers.forEach(closer => {
        closer.addEventListener('click', function() {
          modal.classList.add('hidden');
        });
      });
    });
  </script>

</body>
</html>