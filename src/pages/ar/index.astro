astro
---
import { Image } from "astro:assets";

// الصور المحلية
import hero from "../../assets/bluta-hero-city.webp";
import integrations from "../../assets/bluta-integrations-collage.webp";
import indOffice from "../../assets/bluta-industry-office.webp";
import indMall from "../../assets/bluta-industry-mall.webp";
import indHospital from "../../assets/bluta-industry-hospital.webp";
import iaqSensor from "../../assets/bluta-iaq-sensor.webp";
import heatmapFusion from "../../assets/bluta-heatmap-fusion-sensor.webp";
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <title>بلوتا — نظام تشغيل المباني من Blutech.io</title>
  <meta name="description" content="بلوتا توحد أنظمة المباني وتؤتمت العمليات باستخدام الذكاء الاصطناعي مع الحفاظ على الخصوصية لمنطقة الخليج العربي." />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b1020" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0b1020; --panel:#121a2e; --ink:#e5e7eb; --muted:#9aa3b2;
      --line:#1f2a44; --brand:#00C3D8; --brand2:#a78bfa; --nav-h:68px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:linear-gradient(180deg,#0a0f1f 0%,#0b1020 18%,#0b1020 100%);color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial}
    a{color:var(--ink);text-decoration:none}
    .container{max-width:1200px;margin:0 auto;padding:0 20px}

    /* دعم الخط العربي */
    :root[lang="ar"] body {
      font-family: 'Tajawal', ui-sans-serif, system-ui, sans-serif;
    }

    /* التنقل */
    .nav{position:sticky;top:0;z-index:50;height:var(--nav-h);backdrop-filter:saturate(1.2) blur(8px);background:rgba(10,14,28,.7);border-bottom:1px solid var(--line)}
    .nav-inner{display:flex;gap:16px;align-items:center;justify-content:space-between;height:100%}
    .brand{display:flex;gap:10px;align-items:center;font-weight:800;font-family:'Comfortaa', ui-sans-serif, system-ui}
    .wordmark{font-weight:800;font-size:24px;letter-spacing:.2px;text-transform:lowercase}
    .wordmark .blu{color:var(--brand)}
    .wordmark .ta{color:#fff}
    .nav-links{display:flex;align-items:center;gap:10px}
    .nav-links a{display:inline-block;padding:10px 12px;border-radius:10px;font-weight:700;color:#dbe3f3}
    .nav-links a:hover{background:rgba(255,255,255,.06)}
    .nav-links a.active{background:rgba(255,255,255,.1)}

    /* محول اللغة */
    .language-switcher {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-left: 20px;
      padding-left: 20px;
      border-left: 1px solid var(--line);
    }
    .language-switcher a {
      text-decoration: none;
      color: #9aa3b2;
      font-weight: 600;
      font-size: 14px;
      padding: 4px 8px;
      border-radius: 6px;
    }
    .language-switcher a:hover {
      color: #00C3D8;
      background: rgba(255,255,255,0.05);
    }

    /* التخطيط */
    section{padding:64px 0}
    .grid{display:grid;gap:20px}
    .col-2{grid-template-columns:1fr 1fr}
    .col-3{grid-template-columns:repeat(3,1fr)}
    @media(max-width:980px){.col-2,.col-3{grid-template-columns:1fr}}
    .card{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));border:1px solid var(--line);border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.25)}
    .p-6{padding:18px}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 16px;border-radius:12px;font-weight:800;border:1px solid var(--line);background:rgba(255,255,255,.04);cursor:pointer}
    .btn.primary{background:linear-gradient(120deg,var(--brand),var(--brand2));color:#0b1020;border-color:transparent}
    .subtitle{color:var(--muted);font-size:18px;text-align:center;max-width:900px;margin:0px auto 0}
    .h1{font-size:clamp(28px,3.6vw,48px);line-height:1.1;margin:10px 0;text-align:center}
    .h2{font-size:30px;margin:0 0 8px}
    .pill{display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;background:rgba(96,165,250,.12);color:#c7d2fe;font-weight:800;font-size:12px;border:1px solid var(--line)}
    .muted{color:var(--muted)}

    .image{overflow:hidden;border-radius:16px;border:1px solid var(--line);background:#050814}
    .image img, .image picture{display:block;width:100%;height:100%;object-fit:cover}

    .specs{width:100%;border-collapse:collapse;font-size:14px;margin-top:8px}
    .specs td{padding:12px;border-bottom:1px solid var(--line)}
    .specs td:first-child{width:220px;font-weight:700;color:#bfd1ff}

    /* البطاقات الإحصائية القديمة */
    .stat{display:flex;gap:12px;align-items:center;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.02));padding:10px}
    .stat .thumb{width:64px;height:64px;flex:0 0 64px;background:#091126;border-radius:12px}

    .footer{border-top:1px solid var(--line);padding:40px 0;color:var(--muted)}

    /* البطل (الصفحة الرئيسية) */
    .hero{position:relative;padding:0;min-height:calc(68vh + var(--nav-h));}
    .hero-media{position:absolute;inset:0;overflow:hidden}
    .hero-overlay{position:relative;z-index:1;display:flex;align-items:center;justify-content: center;min-height:calc(68vh + var(--nav-h));background:linear-gradient(180deg,rgba(5,8,20,.15) 0%, rgba(11,16,32,.55) 40%, rgba(11,16,32,.80) 100%)}
    .hero-overlay .content{padding:64px 0}

    .lead{font-size:18px;line-height:1.55;color:var(--muted)}
    .eyebrow{font-size:12px;color:#c7d2fe;letter-spacing:.08em;text-transform:uppercase;font-weight:800;margin-bottom:6px}
    .icon{font-size:28px;margin-bottom:10px;display:inline-block}

    /* الإحصائيات النصية الجديدة */
    .stats-words{
      display:grid;
      row-gap: 18px;
      column-gap: 40px;
      grid-template-columns:repeat(4,1fr);
      margin-top:18px;
      text-align:right;
    }
    @media(max-width:1280px){.stats-words{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:640px){.stats-words{grid-template-columns:1fr}}
    .stats-words li{
      display:flex;
      align-items:center;
      gap:12px;
      justify-content:flex-start;
    }
    .stats-words .iconbox{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;border:1px solid var(--line);background:#121a2e}
    .stats-words .label{font-weight:800}
    .stats-words .sub{color:var(--muted);font-size:13px}

    /* تباعد المحتوى الرئيسي */
    .hero-overlay .content > div {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    /* بطاقات البطل المدمجة */
    .hero-cards-tight{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:16px;
      margin-top:0;
    }
    @media (max-width: 1024px){
      .hero-cards-tight{ grid-template-columns:repeat(2,1fr); gap:14px; }
    }
    @media (max-width: 640px){
      .hero-cards-tight{ grid-template-columns:1fr; gap:12px; }
    }
    .hc-card{
      display:flex; align-items:center;
      padding:10px 10px;
      border-radius:20px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
    }
    .hc-thumb{
      width:64px; height:64px;
      border-radius:12px; overflow:hidden;
      margin-left:10px; flex:0 0 64px;
      background:#091126;
    }
    .hc-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
    .hc-value{ font-weight:800; font-size:20px; line-height:1.1; }
    .hc-label{ font-size:13px; opacity:.75; margin-top:2px; line-height:1.2; }

    /* تعديلات RTL */
    :root[dir="rtl"] .nav-links {
      margin-right: auto;
      margin-left: 0;
    }
    :root[dir="rtl"] .stats-words {
      text-align: right;
    }
  </style>
</head>

<body>
  <!-- التنقل -->
  <div class="nav">
    <div class="container nav-inner">
      <a href="/ar/" class="brand" aria-label="بلوتا الرئيسية">
        <span class="wordmark"><span class="blu">blu</span><span class="ta">ta</span></span>
      </a>
      <div class="nav-links">
        <a href="/ar/" data-nav="home" class="active">الرئيسية</a>
        <a href="/ar/solutions" data-nav="solutions">الحلول</a>
        <a href="/ar/hardware" data-nav="hardware">الأجهزة</a>
        <a href="/ar/projects" data-nav="projects">المشاريع</a>
        <a href="/ar/#contact" data-nav="contact">اتصل بنا</a>
        <div class="language-switcher">
          <a href="/">EN</a>
          <span>|</span>
          <a href="/ar/">AR</a>
        </div>
      </div>
    </div>
  </div>

  <!-- البطل الرئيسي -->
  <section id="home" class="hero" aria-label="الرئيسية">
    <div class="hero-media">
      <Image
        src={hero}
        alt="أفق المدينة البطولي"
        widths={[960, 1280, 1600, 1920]}
        sizes="100vw"
        format="webp"
        style="width:100%;height:100%;object-fit:cover;transform:scale(1.02)"
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="hero-overlay">
      <div class="container content">
        <div style="max-width:900px;margin:0 auto;text-align:center">
          <span class="pill"><span class="wordmark"><span class="blu">blu</span><span class="ta">ta</span></span> • نظام تشغيل المباني</span>

          <!-- البطل ذو السطرين -->
          <h1 class="h1">
            <span style="display:block">نظام تشغيل المباني بالذكاء الاصطناعي</span>
          </h1>

          <!-- العنوان الفرعي ذو الجملة الواحدة -->
          <p class="subtitle">
            بلوتا تدمج الأنظمة المختلفة لأتمتة القرارات وخفض التكاليف التشغيلية
          </p>

          <!-- الزر الأساسي المتمركز -->
          <div style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
            <a class="btn primary" href="/ar/solutions">استكشاف الحلول</a>
          </div>

          <!-- بطاقات البطل: صورة مضغوطة + نص -->
          <div class="hero-cards-tight">
            <div class="hc-card">
              <div class="hc-thumb">
                <img src="https://images.unsplash.com/photo-1566245024852-04fbf7842ce9?q=80&w=480&auto=format&fit=crop" alt="">
              </div>
              <div>
                <div class="hc-value">50-30%</div>
                <div class="hc-label">كفاءة العمالة</div>
              </div>
            </div>

            <div class="hc-card">
              <div class="hc-thumb">
                <img src="https://images.unsplash.com/photo-1529310399831-ed472b81d589?&q=80&w=480&auto=format&fit=crop" alt="">
              </div>
              <div>
                <div class="hc-value">20-15%</div>
                <div class="hc-label">توفير الطاقة</div>
              </div>
            </div>

            <div class="hc-card">
              <div class="hc-thumb">
                <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=480&auto=format&fit=crop" alt="">
              </div>
              <div>
                <div class="hc-value">&gt;100</div>
                <div class="hc-label">نشر عبر آسيا والمحيط الهادئ</div>
              </div>
            </div>

            <div class="hc-card">
              <div class="hc-thumb">
                <img src="https://images.unsplash.com/photo-1528312635006-8ea0bc49ec63?q=80&w=480&auto=format&fit=crop" alt="">
              </div>
              <div>
                <div class="hc-value">خصوصية أولاً</div>
                <div class="hc-label">بدون معرفات شخصية</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- نواة بلوتا -->
  <section>
    <div class="container">
      <div class="h2">بلوتا — منصة واحدة. تحكم كامل.</div>
      <p class="muted">اتصل وحلل وأتمت العمليات عبر محفظتك. كسر الحواجز بين أنظمة إدارة المباني والمراقبة والتكييف والتحكم في الوصول والمصاعد وإنترنت الأشياء.</p>
      <div class="grid col-2" style="margin-top:40px">
        <div class="grid col-2">
          <div class="card p-6"><strong>خفض تكاليف العمالة</strong><div class="muted" style="margin-top:6px">أتمتة الدوريات والفحوصات والتقارير والتنبيهات. حرر فريقك من المهام المتكررة.</div></div>
          <div class="card p-6"><strong>تقليل التكاليف التشغيلية</strong><div class="muted" style="margin-top:6px">وحد البيانات وسير العمل في نظام تشغيل واحد. تخلص من الأنظمة والتراخيص المكررة.</div></div>
          <div class="card p-6"><strong>توفير الطاقة</strong><div class="muted" style="margin-top:6px">تحسين الذكاء الاصطناعي لأنظمة التكييف والإضاءة ووقت التشغيل بناءً على الإشغال والطقس.</div></div>
          <div class="card p-6"><strong>رؤى قابلة للتنفيذ</strong><div class="muted" style="margin-top:6px">مؤشرات الأداء الرئيسية والشذوذ ولوحات تحليل العائد على الاستثمار للإدارة وفرق العمل الميدانية.</div></div>
        </div>
        <div class="card p-6">
          <div style="font-weight:800;margin-bottom:8px">التكاملات</div>
          <div class="grid col-3">
            <div class="card p-6" style="padding:12px;text-align:center">أنظمة المراقبة</div>
            <div class="card p-6" style="padding:12px;text-align:center">التكييف وجودة الهواء</div>
            <div class="card p-6" style="padding:12px;text-align:center">أوامر العمل</div>
            <div class="card p-6" style="padding:12px;text-align:center">الطاقة والعدادات</div>
            <div class="card p-6" style="padding:12px;text-align:center">التحكم في الوصول</div>
            <div class="card p-6" style="padding:12px;text-align:center">إنترنت الأشياء</div>
          </div>
          <div class="image" style="height:160px;margin-top:12px">
            <Image
              src={integrations}
              alt="كولاج التكاملات"
              widths={[640, 960, 1200]}
              sizes="(max-width: 980px) 100vw, 1200px"
              format="webp"
              style="width:100%;height:100%;object-fit:cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- بلاطات الصناعة -->
  <section>
    <div class="container">
      <div class="h2">خطط الصناعة</div>
      <p class="muted">قوالب ومؤشرات أداء رئيسية وأتمتة مصممة خصيصًا لبيئتك.</p>
      <div class="grid col-3" style="margin-top:16px">
        <div class="card" style="overflow:hidden">
          <div class="image" style="height:160px">
            <Image
              src={indOffice}
              alt="العقارات التجارية"
              widths={[480, 800, 1200]}
              sizes="(max-width: 980px) 100vw, 380px"
              format="webp"
              style="width:100%;height:100%;object-fit:cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6"><div style="font-weight:700">العقارات التجارية</div>
            <ul class="muted" style="margin:8px 0 0 18px;line-height:1.6">
              <li>تحسين الطاقة على مستوى المحفظة</li><li>راحة المستأجرين ومراقبة جودة الهواء الداخلي</li><li>تنبيهات موحدة وسير عمل اتفاقيات مستوى الخدمة</li>
            </ul>
          </div>
        </div>

        <div class="card" style="overflow:hidden">
          <div class="image" style="height:160px">
            <Image
              src={indMall}
              alt="مراكز التسوق"
              widths={[480, 800, 1200]}
              sizes="(max-width: 980px) 100vw, 380px"
              format="webp"
              style="width:100%;height:100%;object-fit:cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6"><div style="font-weight:700">مراكز التسوق</div>
            <ul class="muted" style="margin:8px 0 0 18px;line-height:1.6">
              <li>تحليلات تدفق الأشخاص والطوابير</li><li>التنظيف الذكي للدورات المائية</li><li>جدولة التكييف حسب الإشغال</li>
            </ul>
          </div>
        </div>

        <div class="card" style="overflow:hidden">
          <div class="image" style="height:160px">
            <Image
              src={indHospital}
              alt="المستشفيات ورعاية المسنين"
              widths={[480, 800, 1200]}
              sizes="(max-width: 980px) 100vw, 380px"
              format="webp"
              style="width:100%;height:100%;object-fit:cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6"><div style="font-weight:700">المستشفيات ورعاية المسنين</div>
            <ul class="muted" style="margin:8px 0 0 18px;line-height:1.6">
              <li>إشارات الإشغال مع الحفاظ على الخصوصية</li><li>سير عمل التنظيف والتعقيم</li><li>تقليل إرهاق التنبيهات</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- الأجهزة -->
  <section id="hardware">
    <div class="container">
      <h2><a href="/ar/hardware">الأجهزة</a></h2>
      <p class="muted">أجهزة تراعي الخصوصية تنقل إشارات موثوقة إلى بلوتا.</p>

      <div class="grid col-2" style="margin-top:16px">
        <div class="card" style="overflow:hidden;position:relative">
          <div class="image" style="height:380px">
            <Image
              src={iaqSensor}
              alt="جهاز استشعار جودة الهواء الداخلي"
              widths={[640, 960, 1200]}
              sizes="(max-width: 980px) 100vw, 580px"
              format="webp" 
              style="width:100%;height:100%;object-fit:cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6">
            <div style="font-weight:800">جهاز استشعار جودة الهواء الداخلي</div>
            <div class="muted" style="margin-top:6px">جودة هواء داخلي مستمرة لمباني أكثر صحة وكفاءة. يمكن التحكم في التهوية بناءً على الطلب وإعداد تقارير ESG.</div>
            <table class="specs"><tbody>
              <tr><td>الميزة الخاصة</td><td>الكشف عن التدخين والتبخير بالذكاء الاصطناعي</td></tr>
              <tr><td>المعايير</td><td>ثاني أكسيد الكربون، الجسيمات الدقيقة، المركبات العضوية المتطايرة، درجة الحرارة، الرطوبة، كبريتيد الهيدروجين، الأمونيا</td></tr>
              <tr><td>الاتصال</td><td>LoRaWAN</td></tr>
              <tr><td>الطاقة</td><td>12V DC</td></tr>
              <tr><td>البيانات</td><td>MQTT/HTTPS</td></tr>
            </tbody></table>
          </div>
        </div>

        <div class="card" style="overflow:hidden;position:relative">
          <div class="image" style="height:380px">
            <Image
              src={heatmapFusion}
              alt="خريطة الحرارة فيوجن وبرو"
              widths={[640, 960, 1200]}
              sizes="(max-width: 980px) 100vw, 580px"
              format="webp"
              style="width:100%;height:100%;object-fit:cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6">
            <div style="font-weight:800">خريطة الحرارة فيوجن وبرو</div>
            <div class="muted" style="margin-top:6px">استخدام المساحات، مراقبة الطوابير، كشف السقوط بدون كاميرات في المناطق الحساسة.</div>
            <table class="specs"><tbody>
              <tr><td>الميزة</td><td>دمج أجهزة الاستشعار بالذكاء الاصطناعي يجمع بين المستشعر الحراري ومستشعر mmWave</td></tr>
              <tr><td>الخصوصية</td><td>حماية عالمية للخصوصية، لا يتم الكشف عن أي معرفات شخصية</td></tr>
