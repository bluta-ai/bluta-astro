astro
---
// src/pages/ar/hardware.astro
import { Image } from "astro:assets";
// Import your images here
import ioBox from "../../assets/bluta-io-box.webp";
import waterLeakage from "../../assets/bluta-water-leakage.webp";
import slender from "../../assets/bluta-slender.webp";
import iaqSensor from "../../assets/bluta-iaq-sensor.webp";
import heatmapFusion from "../../assets/bluta-heatmap-fusion.webp";
import heatmapPro from "../../assets/bluta-heatmap-pro.webp";
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <title>أجهزة استشعار المباني الذكية | بلوتا</title>
  <meta name="description" content="أجهزة استشعار ذكية تحافظ على الخصوصية لأتمتة المباني في منطقة الخليج. مراقبة جودة الهواء الداخلي، تتبع الإشغال، وإدارة الطاقة." />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b1020" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0b1020; --panel:#121a2e; --ink:#e5e7eb; --muted:#9aa3b2;
      --line:#1f2a44; --brand:#00C3D8; --brand2:#a78bfa; --nav-h:68px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:linear-gradient(180deg,#0a0f1f 0%,#0b1020 18%,#0b1020 100%);color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial}
    a{color:var(--ink);text-decoration:none}
    .container{max-width:1200px;margin:0 auto;padding:0 20px}

    /* دعم الخط العربي */
    :root[lang="ar"] body {
      font-family: 'Tajawal', ui-sans-serif, system-ui, sans-serif;
    }

    /* التنقل */
    .nav{position:sticky;top:0;z-index:50;height:var(--nav-h);backdrop-filter:saturate(1.2) blur(8px);background:rgba(10,14,28,.7);border-bottom:1px solid var(--line)}
    .nav-inner{display:flex;gap:16px;align-items:center;justify-content:space-between;height:100%}
    .brand{display:flex;gap:10px;align-items:center;font-weight:800;font-family:'Comfortaa', ui-sans-serif, system-ui}
    .wordmark{font-weight:800;font-size:24px;letter-spacing:.2px;text-transform:lowercase}
    .wordmark .blu{color:var(--brand)}
    .wordmark .ta{color:#fff}
    .nav-links{display:flex;align-items:center;gap:10px}
    .nav-links a{display:inline-block;padding:10px 12px;border-radius:10px;font-weight:700;color:#dbe3f3}
    .nav-links a:hover{background:rgba(255,255,255,.06)}
    .nav-links a.active{background:rgba(255,255,255,.1)}

    /* محول اللغة */
    .language-switcher {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-left: 20px;
      padding-left: 20px;
      border-left: 1px solid var(--line);
    }
    .language-switcher a {
      text-decoration: none;
      color: #9aa3b2;
      font-weight: 600;
      font-size: 14px;
      padding: 4px 8px;
      border-radius: 6px;
    }
    .language-switcher a:hover {
      color: #00C3D8;
      background: rgba(255,255,255,0.05);
    }

    /* التخطيط */
    section{padding:80px 0}
    .grid{display:grid;gap:30px}
    .col-2{grid-template-columns:1fr 1fr}
    .col-3{grid-template-columns:repeat(3,1fr)}
    @media(max-width:980px){.col-2,.col-3{grid-template-columns:1fr}}
    .card{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));border:1px solid var(--line);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.25);transition:transform 0.3s ease}
    .card:hover{transform:translateY(-5px)}
    .p-6{padding:24px}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:12px;font-weight:800;border:1px solid var(--line);background:rgba(255,255,255,.04);cursor:pointer;transition:all 0.3s ease}
    .btn.primary{background:linear-gradient(120deg,var(--brand),var(--brand2));color:#0b1020;border-color:transparent}
    .btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(0,195,216,0.3)}
    .subtitle{color:var(--muted);font-size:20px;text-align:center;max-width:900px;margin:0px auto 0;line-height:1.6}
    .h1{font-size:clamp(32px,4vw,56px);line-height:1.1;margin:10px 0;text-align:center;font-weight:900}
    .h2{font-size:36px;margin:0 0 16px;font-weight:800}
    .h3{font-size:24px;margin:0 0 12px;font-weight:700}
    .pill{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;background:rgba(96,165,250,.12);color:#c7d2fe;font-weight:800;font-size:14px;border:1px solid var(--line)}
    .muted{color:var(--muted);line-height:1.6}

    .image{overflow:hidden;border-radius:16px;border:1px solid var(--line);background:#050814}
    .image img, .image picture{display:block;width:100%;height:100%;object-fit:cover;transition:transform 0.3s ease}
    .image:hover img{transform:scale(1.05)}

    .specs{width:100%;border-collapse:collapse;font-size:14px;margin-top:8px}
    .specs td{padding:12px;border-bottom:1px solid var(--line)}
    .specs td:first-child{width:220px;font-weight:700;color:#bfd1ff}

    /* أنماط خاصة بالأجهزة */
    .hardware-grid{display:grid;gap:40px;margin-top:50px}
    .hardware-feature{display:flex;align-items:center;gap:20px;padding:30px;background:rgba(255,255,255,.02);border-radius:16px;border:1px solid var(--line)}
    .hardware-icon{width:80px;height:80px;flex-shrink:0;background:linear-gradient(135deg,var(--brand),var(--brand2));border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:32px}
    .feature-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:20px}
    .feature-item{display:flex;align-items:center;gap:10px}
    .feature-item .icon{width:24px;height:24px;background:var(--brand);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:12px}

    /* شارات الجوائز */
    .award-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:linear-gradient(135deg,#f59e0b,#d97706);border-radius:8px;font-size:12px;font-weight:700;color:white;margin-right:10px}

    /* تعديلات RTL */
    :root[dir="rtl"] .nav-links {
      margin-right: auto;
      margin-left: 0;
    }
    :root[dir="rtl"] .hardware-feature {
      flex-direction: row-reverse;
    }
  </style>
</head>

<body>
  <!-- التنقل -->
  <div class="nav">
    <div class="container nav-inner">
      <a href="/ar/" class="brand" aria-label="بلوتا الرئيسية">
        <span class="wordmark"><span class="blu">blu</span><span class="ta">ta</span></span>
      </a>
      <div class="nav-links">
        <a href="/ar/" data-nav="home">الرئيسية</a>
        <a href="/ar/solutions" data-nav="solutions">الحلول</a>
        <a href="/ar/hardware" data-nav="hardware" class="active">الأجهزة</a>
        <a href="/ar/projects" data-nav="projects">المشاريع</a>
        <a href="/ar/#contact" data-nav="contact">اتصل بنا</a>
        <div class="language-switcher">
          <a href="/hardware">EN</a>
          <span>|</span>
          <a href="/ar/hardware">AR</a>
        </div>
      </div>
    </div>
  </div>

  <!-- قسم البطل -->
  <section>
    <div class="container">
      <div style="text-align:center">
        <span class="pill">أجهزة استشعار تحافظ على الخصوصية</span>
        <h1 class="h1">أجهزة المباني الذكية<br>للبنية التحتية الحديثة</h1>
        <p class="subtitle">
          أجهزة استشعار ووحدات تحكم متطورة توفر بيانات دقيقة مع الحفاظ الكامل على الخصوصية، مصممة خصيصًا لبيئات المباني في الخليج
        </p>
      </div>
    </div>
  </section>

  <!-- المنتجات الرئيسية للأجهزة -->
  <section>
    <div class="container">
      <div class="hardware-grid">
        
        <!-- صندوق الإدخال والإخراج بلوتا -->
        <div class="hardware-feature">
          <div class="hardware-icon">🔌</div>
          <div style="flex:1">
            <h3>صندوق الإدخال والإخراج بلوتا <span style="font-weight:400;color:var(--muted)">• الشاشة الزرقاء</span></h3>
            <p class="muted">يؤمن، يوحد ويجسر البروتوكولات القديمة في بروتوكول التحكم المتعدد (MCP).</p>
            <div class="feature-grid">
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تكامل المشاريع الذكية</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>جسر البروتوكولات القديمة</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>خيارات اتصال متعددة</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تكوين آمن</span>
              </div>
            </div>
            <table class="specs">
              <tbody>
                <tr><td>الميزة الخاصة</td><td>التحويل بين البروتوكولات المختلفة، توحيد تنسيق البيانات، جمع البيانات لتغذية الذكاء الاصطناعي.</td></tr>
                <tr><td>البروتوكولات</td><td>LoRaWAN, Dry Contact, RS485, RS232, Bluetooth, MQTT, BacNET, Modbus</td></tr>
                <tr><td>الأمان</td><td>TLS, تهيئات موقعة, RBAC محلي</td></tr>
                <tr><td>مصدر الطاقة</td><td>12DC أو طاقة البطارية</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- جهاز استشعار تسرب المياه -->
        <div class="hardware-feature">
          <div class="hardware-icon">💧</div>
          <div style="flex:1">
            <h3>جهاز استشعار تسرب المياه</h3>
            <p class="muted">جهاز استشعار تسرب المياه المصمم بأصالة مع دقة عالية للكشف الموثوق عن التسرب في المناطق الحرجة.</p>
            <div class="feature-grid">
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>كشف عالي الدقة</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>مقاوم للعوامل الجوية</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تركيب مرن</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تركيب سهل</span>
              </div>
            </div>
            <table class="specs">
              <tbody>
                <tr><td>الميزة الخاصة</td><td>استخدام مسبار التيتانيوم لتحسين الدقة وتجنب صدأ النحاس</td></tr>
                <tr><td>البروتوكولات</td><td>LoRaWAN, 4G</td></tr>
                <tr><td>مقاومة الماء</td><td>IP67</td></tr>
                <tr><td>التركيب</td><td>تركيب على الأرض أو على الحائط مع قوس غير مرئي</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- الحمام الذكي - محطة المعلومات -->
        <div class="hardware-feature">
          <div class="hardware-icon">📟</div>
          <div style="flex:1">
            <h3>محطة المعلومات <span style="font-weight:400;color:var(--muted)">• الحمام الذكي</span></h3>
            <p class="muted">شاشة عرض حائزة على جوائز تصميم عالمية مع طلاء عاكس.</p>
            <div class="feature-grid">
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>طلاء عاكس</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تصميم احترافي</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تكامل سهل</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تركيب على الحائط</span>
              </div>
            </div>
            <table class="specs">
              <tbody>
                <tr><td>الميزة الخاصة</td><td>مع نظام نشر محتوى مدمج</td></tr>
                <tr><td>مراجع العمل</td><td>IFC Mall, Metroplaza, KTR350, إلخ</td></tr>
                <tr><td>التكامل</td><td>سحب المحتوى والمعلومات من بلوتا</td></tr>
                <tr><td>التركيب</td><td>مثبت على الحائط مع مصدر طاقة</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- جهاز استشعار جودة الهواء -->
        <div class="hardware-feature">
          <div class="hardware-icon">🌬️</div>
          <div style="flex:1">
            <h3>جهاز استشعار جودة الهواء <span class="award-badge">IF DESIGN AWARD الفائز</span></h3>
            <p class="muted">قياس معايير الهواء المختلفة للتحكم الفوري في التكييف وتحسين استخدام الطاقة. تمكن الحوسبة الطرفية للذكاء الاصطناعي المستشعر من اكتشاف التدخين والتبخير.</p>
            <div class="feature-grid">
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>الكشف عن التدخين والتبخير</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>مراقبة متعددة المعايير</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>الحوسبة الطرفية للذكاء الاصطناعي</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تحسين الطاقة</span>
              </div>
            </div>
            <table class="specs">
              <tbody>
                <tr><td>الميزة الخاصة</td><td>الكشف عن التدخين والتبخير بالذكاء الاصطناعي</td></tr>
                <tr><td>المعايير</td><td>CO₂, PM₂.₅/PM₁₀, TVOC, درجة الحرارة, الرطوبة, H₂S, NH₃</td></tr>
                <tr><td>الاتصال</td><td>LoRaWAN</td></tr>
                <tr><td>بروتوكول البيانات</td><td>MQTT/HTTPS</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- خريطة الحرارة فيوجن -->
        <div class="hardware-feature">
          <div class="hardware-icon">📊</div>
          <div style="flex:1">
            <h3>خريطة الحرارة فيوجن <span style="font-weight:400;color:var(--muted)">• استشعار الذكاء الاصطناعي</span></h3>
            <p class="muted">دمج أجهزة الاستشعار لوجود الأشخاص والسلامة بدون معرفات شخصية. منع الحوادث من خلال تقنية الاستشعار المتقدمة بالذكاء الاصطناعي.</p>
            <div class="feature-grid">
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تصميم يراعي الخصوصية</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>دمج أجهزة الاستشعار بالذكاء الاصطناعي</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>مخرجات متعددة</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>اتصال مرن</span>
              </div>
            </div>
            <table class="specs">
              <tbody>
                <tr><td>الميزة الخاصة</td><td>دمج أجهزة الاستشعار بالذكاء الاصطناعي الحراري + mmWave مع الحوسبة الطرفية</td></tr>
                <tr><td>الخصوصية</td><td>لا توجد معرفات شخصية</td></tr>
                <tr><td>المخرجات</td><td>الإشغال، المكوث الطويل، عدم الحركة، السقوط، الحريق، عد الأشخاص</td></tr>
                <tr><td>الاتصال</td><td>LoRaWAN وWi-Fi؛ اختياريًا البلوتوث للتحكم المحلي</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- خريطة الحرارة برو -->
        <div class="hardware-feature">
          <div class="hardware-icon">🛡️</div>
          <div style="flex:1">
            <h3>خريطة الحرارة برو <span class="award-badge">IF DESIGN AWARD الفائز</span></h3>
            <p class="muted">منع الحوادث وتحليلات تدفق الأشخاص بإشارات تراعي الخصوصية. تقنية مستشعر الشبكة الحرارية المتقدمة للكشف الموثوق.</p>
            <div class="feature-grid">
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تحليلات تراعي الخصوصية</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تقنية الشبكة الحرارية</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>منع الحوادث</span>
              </div>
              <div class="feature-item">
                <div class="icon">✓</div>
                <span>تحليلات تدفق الأشخاص</span>
              </div>
            </div>
            <table class="specs">
              <tbody>
                <tr><td>الميزة الخاصة</td><td>مستشعر شبكة حرارية 16 × 12 لضمان اكتشاف الكائنات الحية فقط</td></tr>
                <tr><td>الخصوصية</td><td>لا توجد معرفات شخصية</td></tr>
                <tr><td>المخرجات</td><td>الإشغال، المكوث الطويل، عدم الحركة، الحريق، عد الأشخاص</td></tr>
                <tr><td>الاتصال</td><td>LoRaWAN وWi-Fi؛ اختياريًا البلوتوث للتحكم المحلي</td></tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- دعوة للعمل -->
  <section>
    <div class="container">
      <div class="card p-6" style="background:linear-gradient(135deg,rgba(167,139,250,.15),rgba(0,195,216,.15));text-align:center">
        <h2>هل لديك موقع مماثل؟</h2>
        <p class="muted" style="max-width:600px;margin:20px auto">أرسل مساحة أرضيتك، وعدد وحدات ARM، والأنظمة المستخدمة. سنرد بنطاق مقترح وتقدير العائد على الاستثمار.</p>
        <div style="margin-top:30px;display:flex;gap:15px;flex-wrap:wrap;justify-content:center">
          <a class="btn primary" href="/ar/#contact">احصل على تقدير العائد على الاستثمار</a>
          <a class="btn" href="/ar/solutions">عرض الحلول</a>
        </div>
      </div>
    </div>
  </section>

</body>
</html>