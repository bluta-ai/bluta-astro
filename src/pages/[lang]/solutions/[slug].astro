---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { solutions, products } from "../../../data/site";
import { getProductImage } from "../../../data/productMedia";

export function getStaticPaths(){
  return ["zh-hk","zh-cn","ar"].flatMap((lang)=>solutions.map((solution)=>({params:{lang,slug:solution.slug},props:{lang,solution}})));
}
const { lang, solution } = Astro.props;
const ar = lang === "ar";
const prefix = `/${lang}`;
const productMap:Record<string,string[]> = {
  "smart-washroom":["BT101","BT102","BT303","BT337","BT338","BT2035","BT3022","BT3023"],
  "privacy-preserving-occupancy":["BT303","BT321","BT337","BT338"],
  "fall-long-stay-motionless":["BT337","BT338","BT317"],
  "smart-lighting":["BT321","BT315","BT316"],
  "indoor-air-quality":["BT306"],
  "water-leakage":["BT333","BT339"],
  "smart-waste":["BT353"],
  "building-iot-retrofit":["BT315","BT316","BT802","BT803"]
};
const related = products.filter((p)=>productMap[solution.slug]?.includes(p.model));
const copy:any = {
  "zh-hk":{
    "smart-washroom":["智慧洗手間","連接廁格使用、安全、環境感測、清潔流程及訪客資訊，不需要在私隱敏感空間內依賴傳統攝影機。",["廁格空置與使用狀態","長時間逗留、靜止及跌倒流程","室內空氣質素與清潔營運","顯示、報告及系統整合"]],
    "privacy-preserving-occupancy":["私隱友善空間使用感測","按實際環境選用熱感、PIR 及感測融合技術，理解空間是否有人及如何被使用。",["核心感測不產生傳統可辨識影像","本地邊緣反應","雲端歷史與警報","樓宇系統整合"]],
    "fall-long-stay-motionless":["跌倒、長時間逗留及靜止偵測","為私隱敏感環境提供安全感測，支援可配置的事件確認、警報及回應流程。",["支援感測器的跌倒偵測","長時間逗留計時","靜止狀態監測","警報升級及審計記錄"]],
    "smart-lighting":["無線智慧照明","面向改造項目的照明自動化，以本地無線感測與控制、排程、日光閾值及中央管理協同運作。",["按動作切換場景","日光閾值","排程與覆寫","BMS／API 整合"]],
    "indoor-air-quality":["室內空氣質素與 HVAC 聯動","監測環境狀況，將 IAQ 數據轉化為物管流程及 HVAC／BMS 邏輯可使用的輸入。",["溫度、濕度及 PM2.5","即時趨勢與警報","按區域監測","HVAC／BMS 聯動"]],
    "water-leakage":["漏水監測","結合感應線區域偵測及小型點式感測器，保護機房、設備區及對外觀有要求的位置。",["感應線區域覆蓋","離散點式偵測","無線警報","歷史事件記錄"]],
    "smart-waste":["智慧垃圾桶與容量監測","利用距離感測及已設定的容量閾值，讓垃圾收集狀態更清晰並可用數據管理。",["容量監測","閾值警報","電池與設備健康","趨勢及補充分析"]],
    "building-iot-retrofit":["樓宇物聯網改造","透過 LoRaWAN、Bluetooth、4G、Wi‑Fi、RS485、接點及 API 連接現有設備與樓宇系統，而不強迫所有功能使用同一協議。",["訊號接入與無線化","邊緣控制","網關與回傳設計","開放整合層"]]
  },
  "zh-cn":{
    "smart-washroom":["智能洗手间","连接厕格使用、安全、环境传感、清洁流程及访客信息，无需在隐私敏感空间内依赖传统摄像头。",["厕格空置与使用状态","长时间停留、静止及跌倒流程","室内空气质量与清洁运营","显示、报告及系统集成"]],
    "privacy-preserving-occupancy":["隐私友好空间使用传感","根据实际环境选用热感、PIR 及传感融合技术，了解空间是否有人及如何被使用。",["核心传感不产生传统可识别图像","本地边缘响应","云端历史与报警","楼宇系统集成"]],
    "fall-long-stay-motionless":["跌倒、长时间停留及静止检测","为隐私敏感环境提供安全传感，支持可配置的事件确认、报警及响应流程。",["受支持传感器的跌倒检测","长时间停留计时","静止状态监测","报警升级及审计记录"]],
    "smart-lighting":["无线智能照明","面向改造项目的照明自动化，以本地无线传感与控制、排程、日光阈值及中央管理协同运行。",["根据动作切换场景","日光阈值","排程与覆盖","BMS／API 集成"]],
    "indoor-air-quality":["室内空气质量与 HVAC 联动","监测环境状况，将 IAQ 数据转化为物管流程及 HVAC／BMS 逻辑可使用的输入。",["温度、湿度及 PM2.5","实时趋势与报警","按区域监测","HVAC／BMS 联动"]],
    "water-leakage":["漏水监测","结合感应线区域检测及小型点式传感器，保护机房、设备区及对外观有要求的位置。",["感应线区域覆盖","离散点式检测","无线报警","历史事件记录"]],
    "smart-waste":["智能垃圾桶与容量监测","利用距离传感及已设置的容量阈值，让垃圾收集状态更清晰并可用数据管理。",["容量监测","阈值报警","电池与设备健康","趋势及补充分析"]],
    "building-iot-retrofit":["楼宇物联网改造","通过 LoRaWAN、Bluetooth、4G、Wi‑Fi、RS485、接点及 API 连接现有设备与楼宇系统，而不强迫所有功能使用同一协议。",["信号接入与无线化","边缘控制","网关与回传设计","开放集成层"]]
  },
  ar:{
    "smart-washroom":["المرافق الذكية","ربط الإشغال والسلامة والاستشعار البيئي وسير التنظيف ومعلومات الزوار من دون الاعتماد على كاميرات تقليدية داخل المساحات الحساسة للخصوصية.",["حالة المقصورات والإشغال","سير البقاء الطويل والسكون والسقوط","جودة الهواء وعمليات التنظيف","الشاشات والتقارير والتكامل"]],
    "privacy-preserving-occupancy":["استشعار الإشغال مع الحفاظ على الخصوصية","فهم وجود الأشخاص واستخدام المساحة عبر الاستشعار الحراري وPIR ودمج الحساسات وفق البيئة.",["لا صور تقليدية قابلة للتعريف في الاستشعار الأساسي","استجابة محلية عند الحافة","سجل وتنبيهات مركزية","تكامل أنظمة المبنى"]],
    "fall-long-stay-motionless":["كشف السقوط والبقاء الطويل والسكون","استشعار للسلامة في البيئات الحساسة للخصوصية مع تأكيد وتنبيه واستجابة قابلة للضبط.",["كشف السقوط بالحساسات المدعومة","مؤقتات البقاء الطويل","مراقبة السكون","تصعيد التنبيه وسجل التدقيق"]],
    "smart-lighting":["الإضاءة الذكية اللاسلكية","أتمتة مناسبة للتحديث تعتمد على الاستشعار والتحكم اللاسلكي المحلي والجداول وحدود ضوء النهار والإدارة المركزية.",["مشاهد تعتمد على الحركة","حدود ضوء النهار","الجداول والتجاوز","تكامل BMS وAPI"]],
    "indoor-air-quality":["جودة الهواء والتفاعل مع HVAC","مراقبة الظروف البيئية وتحويل بيانات جودة الهواء إلى مدخلات قابلة للاستخدام في عمليات المرافق ومنطق HVAC وBMS.",["الحرارة والرطوبة وPM2.5","اتجاهات وتنبيهات حية","مراقبة حسب المنطقة","تفاعل HVAC وBMS"]],
    "water-leakage":["مراقبة تسرب المياه","الجمع بين الكشف بالكابل في المناطق والحساسات النقطية المدمجة لحماية غرف المعدات والمناطق الظاهرة.",["تغطية منطقة بالكابل","كشف نقطي منفصل","تنبيهات لاسلكية","سجل للأحداث"]],
    "smart-waste":["مراقبة النفايات والحاويات","استخدام قياس المسافة وحدود الامتلاء المضبوطة لجعل الجمع مرئياً ومداراً بالبيانات.",["مراقبة الامتلاء","تنبيهات الحدود","صحة البطارية والجهاز","تحليل الاتجاه والجمع"]],
    "building-iot-retrofit":["تحديث إنترنت الأشياء للمباني","ربط المعدات والحساسات والأنظمة القائمة عبر LoRaWAN وBluetooth و4G وWi‑Fi وRS485 والتلامسات وواجهات API من دون فرض بروتوكول واحد.",["اكتساب الإشارات وتحويلها لاسلكياً","تحكم الحافة","تصميم البوابات والربط الخلفي","طبقة تكامل مفتوحة"]]
  }
};
const c = copy[lang][solution.slug];
const ui:any={
  "zh-hk":{home:"首頁",solutions:"解決方案",how:"運作方式",howTitle:"感測、連接、回應、改善。",howBody:"現場架構按空間、私隱、反應時間及現有系統設計。需要即時處理的動作留在本地；Halo 服務營運團隊，Core 管理底層設備與整合。",configured:"作為完整項目流程的一部分配置，而不是孤立的感測點。",related:"相關產品",relatedBody:"最終產品及數量需按現場勘察、覆蓋測試和核准的營運流程確定。",view:"查看產品",cta:"要在真實樓宇內實現？",ctaBody:"提供現場條件、現有系統及營運目標，我們會先確認設計邊界再提出架構。",talk:"討論方案"},
  "zh-cn":{home:"首页",solutions:"解决方案",how:"运行方式",howTitle:"传感、连接、响应、改善。",howBody:"现场架构根据空间、隐私、响应时间及现有系统设计。需要即时处理的动作留在本地；Halo 服务运营团队，Core 管理底层设备与集成。",configured:"作为完整项目流程的一部分配置，而不是孤立的传感点。",related:"相关产品",relatedBody:"最终产品及数量需根据现场勘察、覆盖测试和批准的运营流程确定。",view:"查看产品",cta:"要在真实楼宇内实现？",ctaBody:"提供现场条件、现有系统及运营目标，我们会先确认设计边界再提出架构。",talk:"讨论方案"},
  ar:{home:"الرئيسية",solutions:"الحلول",how:"طريقة العمل",howTitle:"استشعر. اتصل. استجب. حسّن.",howBody:"تُختار البنية الميدانية وفق المساحة والخصوصية وزمن الاستجابة والأنظمة القائمة. تبقى الإجراءات الفورية محلية، ويخدم Halo فريق التشغيل بينما يدير Core الأجهزة والتكاملات.",configured:"يُضبط كجزء من سير المشروع الكامل، لا كنقطة حساس معزولة.",related:"المنتجات المرتبطة",relatedBody:"يعتمد الاختيار والعدد النهائيان على المسح واختبار التغطية وسير التشغيل المعتمد.",view:"عرض المنتج",cta:"هل تحتاجه في مبنى حقيقي؟",ctaBody:"شارك ظروف الموقع والأنظمة القائمة والهدف التشغيلي لنحدد حدود التصميم قبل اقتراح البنية.",talk:"ناقش الحل"}
}[lang];
const schema={"@context":"https://schema.org","@type":"Service",name:c[0],provider:{"@type":"Organization",name:"Blutech IoT Limited"},description:c[1],inLanguage:lang};
---
<BaseLayout title={`${c[0]} | Blutech`} description={c[1]} lang={lang} dir={ar?"rtl":"ltr"} canonicalPath={`${prefix}/solutions/${solution.slug}`} hasLocalizedVersions={true} schema={schema}>
  <section class="page-hero"><div class="shell"><div class="breadcrumb"><a href={prefix}>{ui.home}</a><span>›</span><a href={`${prefix}/solutions`}>{ui.solutions}</a><span>›</span><span>{c[0]}</span></div><div class="kicker">Building AI and IoT</div><h1>{c[0]}</h1><p>{c[1]}</p></div></section>
  <section><div class="shell solution-work"><div><div class="kicker">{ui.how}</div><h2>{ui.howTitle}</h2><p>{ui.howBody}</p></div><div class="solution-steps">{c[2].map((b:string,i:number)=><article><span>0{i+1}</span><h3>{b}</h3><p>{ui.configured}</p></article>)}</div></div></section>
  {related.length>0&&<section class="related"><div class="shell"><div class="section-head"><div><div class="kicker">{ui.related}</div><h2>{ui.related}</h2><p>{ui.relatedBody}</p></div></div><div class="product-grid">{related.map((p)=>{const image=getProductImage(p.model,p.image);return <a class="product-card" href={`${prefix}/products/${p.slug}`}><div class="product-image"><img src={image} alt={`${p.model} ${p.name}`} loading="lazy"/></div><div class="product-body"><span>{p.model}</span><h3>{p.name}</h3><b>{ui.view} →</b></div></a>})}</div></div></section>}
  <section class="solution-cta"><div class="shell cta"><div><h2>{ui.cta}</h2><p>{ui.ctaBody}</p></div><a class="button" href={`${prefix}/contact?solution=${solution.slug}`}>{ui.talk}</a></div></section>
</BaseLayout>
<style>
.solution-work{display:grid;grid-template-columns:.82fr 1.18fr;gap:80px}.solution-work h2,.section-head h2,.cta h2{font-size:clamp(34px,4vw,54px);line-height:1.03;letter-spacing:-.045em;margin:10px 0}.solution-work>div:first-child p,.section-head p{color:var(--muted)}.solution-steps{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line)}.solution-steps article{background:#fff;padding:25px}.solution-steps span,.product-body>span{font-size:10px;color:var(--brand-2);font-weight:900}.solution-steps h3{font-size:20px;margin:26px 0 10px}.solution-steps p{font-size:12px;color:var(--muted)}.related{background:#eef0ed}.product-grid{grid-template-columns:repeat(4,1fr)}.product-image img{padding:5%}.product-body{padding:18px}.product-body h3{font-size:20px;line-height:1.08}.product-body b{font-size:11px}.solution-cta{background:#06171d;color:#fff}.cta{display:flex;justify-content:space-between;align-items:end;gap:50px}.cta p{color:rgba(255,255,255,.6);max-width:720px}.cta .button{background:#fff;color:#06171d;border-color:#fff}
@media(max-width:900px){.solution-work{grid-template-columns:1fr}.product-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.solution-steps,.product-grid{grid-template-columns:1fr}.cta{display:block}.cta .button{margin-top:18px}}
</style>
