---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { projects } from "../../../data/projects";
export function getStaticPaths(){return ["zh-hk","zh-cn","ar"].flatMap((lang)=>projects.map((project)=>({params:{lang,slug:project.slug},props:{lang,project}})))}
const {lang,project}=Astro.props;const ar=lang==="ar";const prefix=`/${lang}`;
const copy:any={
"zh-hk":{
"three-garden-road":["連接超過 1,000 個設備的樓宇級系統，涵蓋智慧洗手間、漏水、室內空氣質素、樓宇感測及 ESG 數據。","佔用數據已正式用於 HVAC 聯動，物業團隊亦可在同一層面理解環境與風險訊號。"],
"hong-kong-international-airport":["以 HeatMap 系列為全機場無障礙洗手間提供旅客安全監測。","營運團隊透過樓層圖、儀表板、警報及報告，在保障私隱的同時掌握安全事件。"],
"emsd-headquarters":["於機電工程署總部 B1 至 6 樓監測 230 個廁格的使用狀態，並對接政府 GWIN 雲端。","大樓範圍的佔用數據讓設施團隊能清楚理解不同樓層的實際使用情況。"],
"metroplaza":["超過 300 個設備及 180 個廁格的智慧洗手間、通風及資訊顯示系統。","佔用與溫濕度數據支援風機、通風及 HVAC 運作，Halo 與 Core 提供完整管理。"],
"hospital-patient-safety":["於無障礙洗手間進行跌倒與意外偵測，結合本地警報、護士通知及儀表板。","LoRaWAN 與 Bluetooth 同時運作，既能即時在現場回應，也能把事件送到獲授權團隊。"],
"immigration-department-tko":["監測將軍澳入境處護照及身份證服務機器的排隊狀況，並透過 Smart Display 顯示。","訪客可在排隊前了解目前狀況，工作人員亦能更清楚掌握服務區需求。"],
"hong-kong-west-kowloon-station":["連接廁紙、洗手液、漏水、HeatMap、照明、室內空氣質素及 BT107 Smart Display。","乘客獲得更清晰資訊，營運團隊則透過 Halo 與 Core 管理物資、空間及環境狀況。"],
"olympian-city":["覆蓋奧海城一期、二期及三期的漏水、噪音、獨立 IoT 煙霧、吸煙、HeatMap 與溫濕度監測。","環境數據對接 BMS 以支援 HVAC 優化，並讓物業團隊更早掌握異常狀況。"],
"ifc-mall":["把智慧洗手間、設施狀態及公共資訊整合到大型商場與辦公目的地。","訪客可更清楚了解設施狀態，營運團隊亦能使用相同現場訊號。"]},
"zh-cn":{
"three-garden-road":["连接超过 1,000 个设备的楼宇级系统，涵盖智能洗手间、漏水、室内空气质量、楼宇传感及 ESG 数据。","占用数据已正式用于 HVAC 联动，物业团队也可在同一层面理解环境与风险信号。"],
"hong-kong-international-airport":["以 HeatMap 系列为全机场无障碍洗手间提供旅客安全监测。","运营团队通过楼层图、仪表板、报警及报告，在保障隐私的同时掌握安全事件。"],
"emsd-headquarters":["在机电工程署总部 B1 至 6 楼监测 230 个厕格的使用状态，并对接政府 GWIN 云。","全楼范围的占用数据让设施团队能清楚理解不同楼层的实际使用情况。"],
"metroplaza":["超过 300 个设备及 180 个厕格的智能洗手间、通风及信息显示系统。","占用与温湿度数据支持风机、通风及 HVAC 运行，Halo 与 Core 提供完整管理。"],
"hospital-patient-safety":["在无障碍洗手间进行跌倒与意外检测，结合本地报警、护士通知及仪表板。","LoRaWAN 与 Bluetooth 同时运行，既能即时在现场响应，也能把事件发送到获授权团队。"],
"immigration-department-tko":["监测将军澳入境处护照及身份证服务机器的排队状况，并通过 Smart Display 显示。","访客可在排队前了解当前状况，工作人员也能更清楚掌握服务区需求。"],
"hong-kong-west-kowloon-station":["连接厕纸、洗手液、漏水、HeatMap、照明、室内空气质量及 BT107 Smart Display。","乘客获得更清晰的信息，运营团队则通过 Halo 与 Core 管理物资、空间及环境状况。"],
"olympian-city":["覆盖奥海城一期、二期及三期的漏水、噪音、独立 IoT 烟雾、吸烟、HeatMap 与温湿度监测。","环境数据对接 BMS 以支持 HVAC 优化，并让物业团队更早掌握异常状况。"],
"ifc-mall":["把智能洗手间、设施状态及公共信息集成到大型商场与办公目的地。","访客可更清楚了解设施状态，运营团队也能使用相同现场信号。"]},
ar:{
"three-garden-road":["نظام على مستوى المبنى يربط أكثر من 1,000 جهاز للمرافق الذكية وتسرب المياه وجودة الهواء وإشارات المبنى وبيانات ESG.","تُستخدم بيانات الإشغال فعلياً في تنسيق HVAC، مع رؤية موحدة للمخاطر والبيئة لفريق العقار."],
"hong-kong-international-airport":["مراقبة سلامة المسافرين في دورات المياه الميسرة عبر المطار باستخدام سلسلة HeatMap.","تمنح المخططات ولوحات المتابعة والتنبيهات والتقارير الفريق رؤية واضحة مع الحفاظ على الخصوصية."],
"emsd-headquarters":["مراقبة إشغال 230 مقصورة من الطابق السفلي الأول حتى الطابق السادس وربطها بسحابة GWIN الحكومية.","توضح بيانات الإشغال استخدام المرافق عبر المبنى بدلاً من الاعتماد على الفحص اليدوي فقط."],
"metroplaza":["منظومة تضم أكثر من 300 جهاز و180 مقصورة مع مرافق ذكية وتهوية وعرض معلومات.","تدعم بيانات الإشغال والحرارة والرطوبة تشغيل المراوح والتهوية وHVAC عبر Halo وCore."],
"hospital-patient-safety":["كشف السقوط والحوادث في دورات المياه الميسرة مع إنذار محلي وإشعار للتمريض ولوحة متابعة.","يعمل LoRaWAN وBluetooth معاً للاستجابة المحلية الفورية وإيصال الحدث للفريق المخول."],
"immigration-department-tko":["مراقبة طوابير أجهزة خدمات الجوازات والهوية في تسونغ كوان أو وعرضها عبر Smart Display.","يفهم الزائر حالة الانتظار قبل اختيار الطابور ويحصل الفريق على رؤية أوضح للطلب."],
"hong-kong-west-kowloon-station":["ربط ورق الحمام والصابون وتسرب المياه وHeatMap والإضاءة وجودة الهواء وشاشة BT107.","يحصل المسافر على معلومات أوضح بينما يدير الفريق المواد والمساحات والبيئة عبر Halo وCore."],
"olympian-city":["تغطية المراحل 1 و2 و3 لتسرب المياه والضوضاء ومراقبة الدخان المستقلة والتدخين وHeatMap والحرارة والرطوبة.","ترتبط البيانات البيئية بنظام BMS لدعم تحسين HVAC وإظهار الحالات غير الطبيعية مبكراً."],
"ifc-mall":["دمج المرافق الذكية وحالة الخدمات والمعلومات العامة في وجهة كبيرة للتسوق والمكاتب.","توضح المعلومات حالة المرافق للزوار وتدعم رؤية فريق التشغيل في الوقت نفسه."]}}
const c=copy[lang][project.slug];
const kpiLabels:any={
"zh-hk":{"three-garden-road":["連接設備","正式運行","ESG 報告"],"hong-kong-international-airport":["全機場範圍","監測空間","營運流程"],"emsd-headquarters":["監測廁格","覆蓋樓層","政府雲端"],metroplaza:["連接設備","廁格","軟件層"],"hospital-patient-safety":["醫院項目","本地警報","護士與儀表板通知"],"immigration-department-tko":["即時排隊狀態","公共資訊","服務地點"],"hong-kong-west-kowloon-station":["連接功能","智慧顯示器","軟件層"],"olympian-city":["三期覆蓋","HVAC 整合","多風險監測"],"ifc-mall":["即時資訊","智慧洗手間","公共介面"]},
"zh-cn":{"three-garden-road":["连接设备","正式运行","ESG 报告"],"hong-kong-international-airport":["全机场范围","监测空间","运营流程"],"emsd-headquarters":["监测厕格","覆盖楼层","政府云"],metroplaza:["连接设备","厕格","软件层"],"hospital-patient-safety":["医院项目","本地报警","护士与仪表板通知"],"immigration-department-tko":["实时排队状态","公共信息","服务地点"],"hong-kong-west-kowloon-station":["连接功能","智能显示器","软件层"],"olympian-city":["三期覆盖","HVAC 集成","多风险监测"],"ifc-mall":["实时信息","智能洗手间","公共界面"]},
ar:{"three-garden-road":["أجهزة متصلة","تشغيل فعلي","تقارير ESG"],"hong-kong-international-airport":["نطاق المطار","مساحات مراقبة","مسارات تشغيل"],"emsd-headquarters":["مقصورات مراقبة","تغطية الطوابق","سحابة حكومية"],metroplaza:["أجهزة متصلة","مقصورة","طبقتا البرمجيات"],"hospital-patient-safety":["مواقع مستشفيات","إنذار محلي","إشعار التمريض ولوحة المتابعة"],"immigration-department-tko":["حالة الطابور","معلومات عامة","موقع الخدمة"],"hong-kong-west-kowloon-station":["وظائف متصلة","شاشة ذكية","طبقتا البرمجيات"],"olympian-city":["تغطية ثلاث مراحل","تكامل HVAC","مراقبة متعددة المخاطر"],"ifc-mall":["معلومات حية","مرافق ذكية","واجهة عامة"]}}
const kl=kpiLabels[lang][project.slug];
const kpiValues:any={
"zh-hk":{"three-garden-road":["1,000+","正式運行","ESG"],"hong-kong-international-airport":["全機場","74","4"],"emsd-headquarters":["230","B1–6/F","GWIN"],metroplaza:["300+","180","Halo + Core"],"hospital-patient-safety":["7","本地","已連接"],"immigration-department-tko":["即時","Smart Display","將軍澳"],"hong-kong-west-kowloon-station":["7","BT107","Halo + Core"],"olympian-city":["三期","BMS","多風險"],"ifc-mall":["即時","已整合","公共介面"]},
"zh-cn":{"three-garden-road":["1,000+","正式运行","ESG"],"hong-kong-international-airport":["全机场","74","4"],"emsd-headquarters":["230","B1–6/F","GWIN"],metroplaza:["300+","180","Halo + Core"],"hospital-patient-safety":["7","本地","已连接"],"immigration-department-tko":["实时","Smart Display","将军澳"],"hong-kong-west-kowloon-station":["7","BT107","Halo + Core"],"olympian-city":["三期","BMS","多风险"],"ifc-mall":["实时","已集成","公共界面"]},
ar:{"three-garden-road":["1,000+","تشغيل فعلي","ESG"],"hong-kong-international-airport":["كامل المطار","74","4"],"emsd-headquarters":["230","B1–6/F","GWIN"],metroplaza:["300+","180","Halo + Core"],"hospital-patient-safety":["7","محلي","متصل"],"immigration-department-tko":["حي","Smart Display","تسونغ كوان أو"],"hong-kong-west-kowloon-station":["7","BT107","Halo + Core"],"olympian-city":["3 مراحل","BMS","مخاطر متعددة"],"ifc-mall":["حي","متكامل","واجهة عامة"]}}
const kv=kpiValues[lang][project.slug];
const scopeItems=ar?[c[0],c[1],"تم تنسيق الأجهزة والاتصال والبرمجيات وفق حدود المشروع المؤكدة."]:lang==="zh-hk"?[c[0],c[1],"硬件、連接及軟件按已確認的項目邊界協調。"]:[c[0],c[1],"硬件、连接及软件按已确认的项目边界协调。"];
const ui:any={"zh-hk":{home:"首頁",projects:"項目",outcome:"營運成效",scope:"已確認的項目範圍",scopeBody:"以下只包括已確認並可公開的交付內容。",value:"對物業的價值",v1:"更清晰的現場狀況",v1b:"把分散的設備事件轉成有位置、有優先次序的營運資訊。",v2:"更快的回應",v2b:"本地控制與雲端可視性各自處理最合適的工作。",v3:"可長期管理",v3b:"設備、網關、歷史、設定與整合維持在同一系統架構內。",cta:"把你的樓宇要求帶給我們。",ctaB:"我們可以按樓面圖、營運流程、網絡邊界及整合需要定義方案。",talk:"討論項目"},"zh-cn":{home:"首页",projects:"项目",outcome:"运营成效",scope:"已确认的项目范围",scopeBody:"以下只包括已确认并可公开的交付内容。",value:"对物业的价值",v1:"更清晰的现场状况",v1b:"把分散的设备事件转成有位置、有优先级的运营信息。",v2:"更快的响应",v2b:"本地控制与云端可视性各自处理最合适的工作。",v3:"可长期管理",v3b:"设备、网关、历史、设置与集成保持在同一系统架构内。",cta:"把你的楼宇要求带给我们。",ctaB:"我们可以根据楼层图、运营流程、网络边界及集成需求定义方案。",talk:"讨论项目"},ar:{home:"الرئيسية",projects:"المشاريع",outcome:"النتيجة التشغيلية",scope:"نطاق المشروع المؤكد",scopeBody:"يتضمن ما يلي فقط الأعمال المؤكدة والمسموح نشرها.",value:"القيمة للعقار",v1:"حالة ميدانية أوضح",v1b:"تحويل أحداث الأجهزة المتفرقة إلى معلومات تشغيلية ذات موقع وأولوية.",v2:"استجابة أسرع",v2b:"يتولى التحكم المحلي والرؤية السحابية الدور الأنسب لكل منهما.",v3:"إدارة طويلة الأجل",v3b:"تبقى الأجهزة والبوابات والسجل والإعدادات والتكاملات ضمن بنية واحدة.",cta:"أحضر متطلبات المبنى إلينا.",ctaB:"نحدد الحل وفق المخططات وسير التشغيل وحدود الشبكة والتكامل.",talk:"ناقش المشروع"}}[lang];
---
<BaseLayout title={`${project.title} | Blutech`} description={c[1]} lang={lang} dir={ar?"rtl":"ltr"} canonicalPath={`${prefix}/projects/${project.slug}`} hasLocalizedVersions={true} image={project.image}>
<section class="lp-hero"><div class="shell"><div class="breadcrumb"><a href={prefix}>{ui.home}</a><span>›</span><a href={`${prefix}/projects`}>{ui.projects}</a><span>›</span><span>{project.title}</span></div><div class="lp-title"><div><div class="kicker">Blutech · {ui.projects}</div><h1>{project.title}</h1><p>{c[0]}</p></div><div class="outcome"><span>{ui.outcome}</span><b>{c[1]}</b></div></div><img src={project.image} alt={project.title}/></div></section>
<section class="lp-proof"><div class="shell kpis">{project.kpis.map((k,i)=><div><b>{kv[i]}</b><span>{kl[i]}</span></div>)}</div></section>
<section><div class="shell scope"><div><div class="kicker">{ui.scope}</div><h2>{ui.scope}</h2><p>{ui.scopeBody}</p></div><ul>{scopeItems.map((d)=><li>{d}</li>)}</ul></div></section>
<section class="value"><div class="shell"><div class="kicker">{ui.value}</div><div class="values"><article><span>01</span><h2>{ui.v1}</h2><p>{ui.v1b}</p></article><article><span>02</span><h2>{ui.v2}</h2><p>{ui.v2b}</p></article><article><span>03</span><h2>{ui.v3}</h2><p>{ui.v3b}</p></article></div>{project.slug==="olympian-city"&&<p class="note">{ar?"مراقبة الدخان عبر إنترنت الأشياء منفصلة عن نظام إنذار الحريق النظامي.":lang==="zh-hk"?"IoT 煙霧監測與法定消防警報系統分開運作。":"IoT 烟雾监测与法定消防报警系统分开运行。"}</p>}</div></section>
<section class="lp-cta"><div class="shell cta"><div><h2>{ui.cta}</h2><p>{ui.ctaB}</p></div><a class="button" href={`${prefix}/contact?project=${project.slug}`}>{ui.talk}</a></div></section>
</BaseLayout>
<style>
.lp-hero{padding:38px 0 0;background:#fff}.lp-title{display:grid;grid-template-columns:1.1fr .9fr;gap:65px;align-items:end;padding:28px 0 36px}.lp-title h1{font-size:clamp(44px,5vw,68px);line-height:1;letter-spacing:-.05em;margin:10px 0 16px}.lp-title p{font-size:18px;color:var(--muted)}.outcome{border-inline-start:2px solid var(--brand);padding-inline-start:20px}.outcome span{font-size:10px;color:var(--brand-2);font-weight:900}.outcome b{display:block;font-size:17px;line-height:1.5;margin-top:8px}.lp-hero img{width:100%;height:min(56vw,620px);object-fit:cover}.lp-proof{padding:0}.kpis{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-top:0}.kpis div{padding:21px}.kpis div+div{border-inline-start:1px solid var(--line)}.kpis b,.kpis span{display:block}.kpis b{font-size:27px}.kpis span{font-size:11px;color:var(--muted)}.scope{display:grid;grid-template-columns:.9fr 1.1fr;gap:80px}.scope h2{font-size:clamp(34px,3.7vw,48px);line-height:1.03;letter-spacing:-.04em}.scope p{color:var(--muted)}.scope ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}.scope li{padding:14px 0;border-bottom:1px solid var(--line)}.value{background:#eef0ed}.values{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:22px}.values article{background:#fff;padding:26px}.values span{font-size:10px;color:var(--brand-2);font-weight:900}.values h2{font-size:22px;margin:24px 0 9px}.values p{font-size:13px;color:var(--muted)}.note{font-size:11px;color:var(--muted);border-inline-start:2px solid #d71920;padding-inline-start:12px}.lp-cta{background:#151718;color:#fff}.cta{display:flex;justify-content:space-between;align-items:end;gap:50px}.cta h2{font-size:clamp(34px,3.8vw,50px);line-height:1.03;margin:0}.cta p{color:#b9c1c3}.cta .button{background:#fff;color:#111;border-color:#fff}
@media(max-width:800px){.lp-title,.scope{grid-template-columns:1fr;gap:28px}.kpis,.values{grid-template-columns:1fr}.kpis div+div{border-inline-start:0;border-top:1px solid var(--line)}.cta{display:block}.cta .button{margin-top:18px}}
</style>
