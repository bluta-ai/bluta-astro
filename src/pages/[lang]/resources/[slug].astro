---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { resources } from "../../../data/resources";
export function getStaticPaths(){return ["zh-hk","zh-cn","ar"].flatMap((lang)=>resources.map((resource)=>({params:{lang,slug:resource.slug},props:{lang,resource}})))}
const {lang,resource}=Astro.props;
const ar=lang==="ar";const prefix=`/${lang}`;
const copy:any={
"zh-hk":{
"fall-detection-without-cameras":["指南","無攝影機跌倒偵測：樓宇團隊應評估甚麼","在洗手間、醫院及其他私隱敏感空間設計跌倒、靜止及長時間逗留感測的實用指南",[["先定義回應流程","跌倒偵測不只是選擇感測器。先確定誰接收警報、多久內確認、需要甚麼位置資料、如何確認，以及通訊中斷時如何處理。"],["按私隱與空間幾何選擇感測","熱感陣列、雷達及感測融合可提供非攝影機方案，但覆蓋會受安裝高度、間隔、門、遮擋物及目標行為影響。現場勘察及受控測試不可省略。"],["分開本地與中央功能","需要即時處理的本地警報或控制不應不必要地依賴互聯網。中央軟件更適合監測、歷史、用戶權限、報告及整合。"],["測試完整警報鏈","驗收應測試感測事件、網關與網絡、軟件警報、位置對應、通知、確認及恢復，而不只看感測器是否改變狀態。"]]],
"lorawan-building-monitoring-retrofit":["技術說明","LoRaWAN 樓宇監測：在改造項目中的角色","了解 LoRaWAN、Bluetooth、4G、Wi‑Fi、RS485 及接點如何互相配合，而不是爭奪同一架構",[["LoRaWAN 是傳輸選擇，不是完整方案","它適合長距離、低功耗樓宇數據，但本地控制、配置及第三方設備介面可能需要 Bluetooth、接點、RS485、Ethernet、Wi‑Fi 或 4G。"],["即時互動使用本地無線","Bluetooth 可把鄰近感測器及控制器連接作快速本地動作；LoRaWAN 另行把狀態與設定傳送到中央平台。"],["規劃覆蓋，不只計算網關數量","混凝土核心、機房、豎井、防火門及樓面佈局都影響射頻表現。最終位置及數量應按勘察與測試決定。"],["保持整合開放","業主應清楚數據如何進入 BMS 或其他系統。詳細設計須記錄 payload、API、MQTT topic、責任邊界及復原行為。"]]],
"smart-washroom-system-design":["採購指南","智慧洗手間系統設計：不只空置顯示燈","智慧洗手間可整合使用狀態、安全、IAQ、清潔、垃圾監測、顯示及樓宇系統",[["先定義每類用戶","訪客需要清晰空置資訊；清潔團隊需要可執行的服務數據；FM 團隊需要健康、警報及歷史；保安或臨床團隊可能需要另一套安全流程。"],["不要用一個訊號推斷所有狀況","門鎖狀態適合空置顯示，但安全或有人存在的用途可能需要獨立人體感測。感測方法必須配合要作出的決定。"],["設計資訊層","本地指示燈、入口顯示、大型資訊站及營運儀表板可展示不同詳細程度。項目需定義哪些資訊屬本地、公開及營運用途。"],["讓維護狀態可見","設備 heartbeat、電池、最後通訊、警報及配置記錄，是系統在安裝後多年持續運作的必要資料。"]]],
"water-leakage-point-vs-cable":["應用說明","點式與感應線漏水偵測","甚麼情況使用小型點式感測器，甚麼情況更適合使用感應線",[["點式偵測","當可能漏水位置已知，或外觀要求較高時，小型點式感測器可安裝於閥門、設備或局部低點附近。"],["感應線偵測","當水可能出現在較大周邊或設備區任何位置時，感應線可沿整段提供分佈式偵測；除非產品明確支援，否則不應假設可定位至精確位置。"],["安裝決定偵測質素","走線、與保護面的接觸、排水方向、清潔方式及可能水路都很重要。點式感測器最重要的是位於真正低點。"],["把警報接入營運","漏水事件應包括位置、設備健康及清晰回應流程，而不是成為另一個孤立的本地警報。"]]]},
"zh-cn":{
"fall-detection-without-cameras":["指南","无摄像头跌倒检测：楼宇团队应评估什么","在洗手间、医院及其他隐私敏感空间设计跌倒、静止及长时间停留传感的实用指南",[["先定义响应流程","跌倒检测不只是选择传感器。先确定谁接收报警、多久内确认、需要什么位置资料、如何确认，以及通信中断时如何处理。"],["根据隐私与空间几何选择传感","热感阵列、雷达及传感融合可提供非摄像头方案，但覆盖会受安装高度、隔断、门、遮挡物及目标行为影响。现场勘察及受控测试不可省略。"],["分开本地与中央功能","需要即时处理的本地报警或控制不应不必要地依赖互联网。中央软件更适合监测、历史、用户权限、报告及集成。"],["测试完整报警链","验收应测试传感事件、网关与网络、软件报警、位置对应、通知、确认及恢复，而不只是看传感器是否改变状态。"]]],
"lorawan-building-monitoring-retrofit":["技术说明","LoRaWAN 楼宇监测：在改造项目中的角色","了解 LoRaWAN、Bluetooth、4G、Wi‑Fi、RS485 及接点如何相互配合，而不是争夺同一架构",[["LoRaWAN 是传输选择，不是完整方案","它适合长距离、低功耗楼宇数据，但本地控制、配置及第三方设备接口可能需要 Bluetooth、接点、RS485、Ethernet、Wi‑Fi 或 4G。"],["即时互动使用本地无线","Bluetooth 可把邻近传感器及控制器连接作快速本地动作；LoRaWAN 另行把状态与设置传送到中央平台。"],["规划覆盖，不只计算网关数量","混凝土核心、机房、竖井、防火门及楼面布局都会影响射频表现。最终位置及数量应根据勘察与测试决定。"],["保持集成开放","业主应清楚数据如何进入 BMS 或其他系统。详细设计须记录 payload、API、MQTT topic、责任边界及恢复行为。"]]],
"smart-washroom-system-design":["采购指南","智能洗手间系统设计：不只是空置显示灯","智能洗手间可集成使用状态、安全、IAQ、清洁、垃圾监测、显示及楼宇系统",[["先定义每类用户","访客需要清晰空置信息；清洁团队需要可执行的服务数据；FM 团队需要健康、报警及历史；安保或临床团队可能需要另一套安全流程。"],["不要用一个信号推断所有状况","门锁状态适合空置显示，但安全或有人存在的用途可能需要独立人体传感。传感方法必须配合要作出的决定。"],["设计信息层","本地指示灯、入口显示、大型信息站及运营仪表板可展示不同详细程度。项目需定义哪些信息属本地、公开及运营用途。"],["让维护状态可见","设备 heartbeat、电池、最后通信、报警及配置记录，是系统在安装后多年持续运行的必要资料。"]]],
"water-leakage-point-vs-cable":["应用说明","点式与感应线漏水检测","什么情况使用小型点式传感器，什么情况更适合使用感应线",[["点式检测","当可能漏水位置已知，或外观要求较高时，小型点式传感器可安装在阀门、设备或局部低点附近。"],["感应线检测","当水可能出现在较大周边或设备区任何位置时，感应线可沿整段提供分布式检测；除非产品明确支持，否则不应假设可定位到精确位置。"],["安装决定检测质量","走线、与保护面的接触、排水方向、清洁方式及可能水路都很重要。点式传感器最重要的是位于真正低点。"],["把报警接入运营","漏水事件应包括位置、设备健康及清晰响应流程，而不是成为另一个孤立的本地报警。"]]]},
ar:{
"fall-detection-without-cameras":["دليل","كشف السقوط من دون كاميرات: ما الذي يجب أن يقيّمه فريق المبنى","دليل عملي لاستشعار السقوط والسكون والبقاء الطويل في المرافق والمستشفيات والمساحات الحساسة للخصوصية",[["ابدأ بسير الاستجابة","المشروع ليس اختيار حساس فقط. حدد من يستقبل التنبيه وزمن التأكيد وتفاصيل الموقع المطلوبة وطريقة الإقرار وما يحدث عند انقطاع الاتصال."],["اختر الاستشعار وفق الخصوصية والهندسة","توفر المصفوفات الحرارية والرادار ودمج الحساسات بدائل من دون كاميرا، لكن التغطية تعتمد على الارتفاع والحواجز والأبواب والسلوك المطلوب. المسح والاختبار المنضبط أساسيان."],["افصل الوظائف المحلية والمركزية","يجب ألا تعتمد الإنذارات أو الضوابط الفورية بلا داعٍ على الإنترنت. البرمجيات المركزية أنسب للمراقبة والسجل والأدوار والتقارير والتكامل."],["اختبر سلسلة الإنذار كاملة","يجب اختبار الحدث والبوابة والشبكة وإنذار البرنامج وربط الموقع والإشعار والإقرار والتعافي، وليس تغير حالة الحساس فقط."]]],
"lorawan-building-monitoring-retrofit":["ملاحظة تقنية","LoRaWAN لمراقبة المباني: دوره في التحديث","كيف تعمل LoRaWAN وBluetooth و4G وWi‑Fi وRS485 والتلامسات معاً بدلاً من التنافس على بنية واحدة",[["LoRaWAN وسيلة نقل وليست الحل كله","تفيد في القياس بعيد المدى ومنخفض الطاقة، لكن التحكم المحلي والإعداد وواجهات المعدات قد تحتاج Bluetooth أو تلامسات أو RS485 أو Ethernet أو Wi‑Fi أو 4G."],["استخدم اللاسلكي المحلي للتفاعل الفوري","يربط Bluetooth الحساسات ووحدات التحكم القريبة لإجراءات سريعة، بينما يحمل LoRaWAN الحالة والإعدادات إلى المنصة المركزية."],["خطط للتغطية لا لعدد البوابات فقط","تؤثر النوى الخرسانية وغرف المعدات والممرات والأبواب المقاومة للحريق والمخطط. يجب أن تتبع المواقع والأعداد نتائج المسح والاختبار."],["حافظ على انفتاح التكامل","يجب أن يعرف المالك كيف تصل البيانات إلى BMS. وثّق payload وAPI وMQTT وحدود الملكية وسلوك التعافي في التصميم التفصيلي."]]],
"smart-washroom-system-design":["دليل مشتري","تصميم المرافق الذكية: أبعد من ضوء الشاغر","يمكن للمرافق الذكية جمع الإشغال والسلامة وجودة الهواء والتنظيف والنفايات والشاشات وتكامل أنظمة المبنى",[["حدد كل مستخدم","يحتاج الزائر إلى معلومات واضحة، وفريق التنظيف إلى بيانات قابلة للتنفيذ، وفريق المرافق إلى الصحة والتنبيهات والسجل، وقد يحتاج الأمن أو الفريق السريري إلى سير سلامة مختلف."],["لا تستنتج كل شيء من إشارة واحدة","تفيد حالة قفل الباب في بيان الشغور، لكن السلامة أو الوجود قد يحتاجان استشعاراً مستقلاً للأشخاص. يجب أن تطابق الوسيلة القرار المطلوب."],["صمم طبقة المعلومات","يمكن للمؤشرات المحلية وشاشات المداخل ومحطات المعلومات ولوحات التشغيل عرض مستويات مختلفة. يجب تحديد ما هو محلي وعام وتشغيلي."],["اجعل الصيانة مرئية","نبض الجهاز والبطارية وآخر اتصال والتنبيهات وسجل الإعداد ضرورية لنظام يعمل لسنوات بعد التركيب."]]],
"water-leakage-point-vs-cable":["ملاحظة تطبيق","الكشف النقطي مقابل كابل تسرب المياه","متى يستخدم حساس نقطي مدمج ومتى يكون كابل الاستشعار أنسب في المبنى",[["الكشف النقطي","يفيد عندما يكون موقع التسرب المحتمل معروفاً أو عندما تهم جودة المظهر، بالقرب من صمام أو معدة أو نقطة منخفضة محلية."],["الكشف بالكابل","يفيد عندما قد يظهر الماء في أي مكان حول محيط أو منطقة معدات، ويوفر كشفاً موزعاً بطوله؛ لا تفترض تحديد الموضع الدقيق ما لم يدعم المنتج ذلك صراحة."],["التركيب جزء من جودة الكشف","يهم مسار الكابل وملامسته للسطح واتجاه التصريف والتنظيف ومسار الماء المحتمل. وفي الحساس النقطي أهم ما في الأمر وضعه عند النقطة المنخفضة الحقيقية."],["اربط الإنذار بالتشغيل","يجب أن يشمل الحدث الموقع وصحة الجهاز ومسار استجابة واضحاً في المنصة بدلاً من أن يصبح إنذاراً محلياً منفصلاً."]]]}}
const c=copy[lang][resource.slug];
const ui:any={"zh-hk":{home:"首頁",resources:"資源",notice:"本文為一般設計指引，不能取代現場勘察、產品規格、法規要求或項目驗收準則。",talk:"討論項目",more:"更多資源"},"zh-cn":{home:"首页",resources:"资源",notice:"本文为一般设计指引，不能取代现场勘察、产品规格、法规要求或项目验收标准。",talk:"讨论项目",more:"更多资源"},ar:{home:"الرئيسية",resources:"المصادر",notice:"هذه إرشادات تصميم عامة ولا تحل محل مسح الموقع أو مواصفات المنتج أو المتطلبات النظامية أو معايير القبول.",talk:"ناقش مشروعاً",more:"مصادر أخرى"}}[lang];
const schema={"@context":"https://schema.org","@type":"Article",headline:c[1],description:c[2],author:{"@type":"Organization",name:"Blutech IoT Limited"},publisher:{"@type":"Organization",name:"Blutech IoT Limited"},inLanguage:lang,mainEntityOfPage:`https://blutech.io${prefix}/resources/${resource.slug}`};
---
<BaseLayout title={`${c[1]} | Blutech`} description={c[2]} lang={lang} dir={ar?"rtl":"ltr"} canonicalPath={`${prefix}/resources/${resource.slug}`} hasLocalizedVersions={true} schema={schema}>
<section class="page-hero"><div class="shell"><div class="breadcrumb"><a href={prefix}>{ui.home}</a><span>›</span><a href={`${prefix}/resources`}>{ui.resources}</a><span>›</span><span>{c[0]}</span></div><div class="kicker">{c[0]}</div><h1>{c[1]}</h1><p>{c[2]}</p></div></section>
<section><article class="shell article">{c[3].map((s:any)=><section class="article-section"><h2>{s[0]}</h2><p>{s[1]}</p></section>)}<p class="notice">{ui.notice}</p><div class="actions"><a class="button" href={`${prefix}/contact`}>{ui.talk}</a><a class="button secondary" href={`${prefix}/resources`}>{ui.more}</a></div></article></section>
</BaseLayout>
<style>
.article{max-width:900px}.article-section{padding:0}.article-section h2{font-size:clamp(28px,3vw,40px);line-height:1.08;letter-spacing:-.035em;margin-top:58px}.article-section p{font-size:16px;line-height:1.8;color:var(--muted)}.notice{margin-top:48px;border-inline-start:2px solid var(--brand);padding:15px 18px;background:#eef7f7;color:#405055}.actions{margin-top:28px}
</style>
