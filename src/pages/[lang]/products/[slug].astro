---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { products } from "../../../data/site";
import { getProductImage } from "../../../data/productMedia";

export function getStaticPaths(){ return ["zh-hk","zh-cn","ar"].flatMap((lang)=>products.map((product)=>({params:{lang,slug:product.slug},props:{lang,product}}))); }
const { lang, product } = Astro.props;
const ar = lang === "ar";
const prefix = `/${lang}`;
const image = getProductImage(product.model, product.image);
const ui:any = {
  "zh-hk": {home:"首頁",products:"產品",talk:"聯絡 Blutech",overview:"技術概覽",enables:"主要價值",fit:"適用環境",technical:"技術資料",model:"型號",connectivity:"連接方式",power:"供電",role:"系統角色",note:"最終規格、安裝、通訊及整合方式會按項目需要與現場條件確認。",related:"相關產品",all:"所有產品",cta:"有樓面圖、控制要求或設備表？",ctaBody:"我們可以按空間、網絡限制及樓宇系統接口，確定合適的感測、控制及整合方案。",discuss:"討論項目",award:"iF 設計獎 · 獲獎方案"},
  "zh-cn": {home:"首页",products:"产品",talk:"联系 Blutech",overview:"技术概览",enables:"主要价值",fit:"适用环境",technical:"技术资料",model:"型号",connectivity:"连接方式",power:"供电",role:"系统角色",note:"最终规格、安装、通信及集成方式会按项目需求与现场条件确认。",related:"相关产品",all:"所有产品",cta:"有楼层图、控制要求或设备表？",ctaBody:"我们可以根据空间、网络限制及楼宇系统接口，确定合适的传感、控制及集成方案。",discuss:"讨论项目",award:"iF 设计奖 · 获奖方案"},
  ar: {home:"الرئيسية",products:"المنتجات",talk:"تواصل مع Blutech",overview:"نظرة تقنية",enables:"القيمة العملية",fit:"بيئات الاستخدام",technical:"البيانات التقنية",model:"الطراز",connectivity:"الاتصال",power:"الطاقة",role:"الدور في النظام",note:"يتم تأكيد المواصفات والتركيب والاتصال والتكامل النهائي وفق متطلبات المشروع وظروف الموقع.",related:"منتجات مرتبطة",all:"كل المنتجات",cta:"هل لديك مخطط أو تسلسل تحكم أو جدول أجهزة؟",ctaBody:"نحدد الاستشعار والتحكم والتكامل وفق المساحة وحدود الشبكة وواجهات أنظمة المبنى.",discuss:"ناقش المشروع",award:"جائزة iF للتصميم · ضمن الحل الفائز"}
}[lang];
const familyMap:any = {
  "zh-hk":{"Display & Interface":"顯示與介面","Occupancy & Spatial":"空間使用與感知","Environmental":"環境感測","Facility Operations":"物業營運","Water & Environment":"漏水與環境","Access & Status":"門狀態與空間狀態","Connectivity":"網絡連接","Smart Lighting":"智慧照明"},
  "zh-cn":{"Display & Interface":"显示与界面","Occupancy & Spatial":"空间使用与感知","Environmental":"环境传感","Facility Operations":"物业运营","Water & Environment":"漏水与环境","Access & Status":"门状态与空间状态","Connectivity":"网络连接","Smart Lighting":"智能照明"},
  ar:{"Display & Interface":"العرض والواجهة","Occupancy & Spatial":"الإشغال وفهم المساحة","Environmental":"الاستشعار البيئي","Facility Operations":"تشغيل المرافق","Water & Environment":"المياه والبيئة","Access & Status":"الدخول والحالة","Connectivity":"الاتصال","Smart Lighting":"الإضاءة الذكية"}
};
const family = familyMap[lang][product.family] || product.family;
const specific:any = {
  "zh-hk": {BT102:"把空間使用、室內空氣質素、排隊及設施資訊整合到一個按項目設計的公共介面。",BT107:"43 吋智慧顯示器，用於設施狀態、排隊資訊及由物業管理的內容。",BT338:"結合熱感陣列、毫米波及本地 AI，在不產生傳統可辨識影像下理解佔用、跌倒及異常活動。",BT337:"以 16×12 熱感陣列提供私隱友善的空間使用與安全訊號。",BT306:"監測溫度、濕度及 PM2.5，支援報告、顯示及與 HVAC／BMS 的項目整合。",BT802:"把分布於樓宇內的 LoRaWAN 感測器連接到 4G、乙太網或 Wi‑Fi 回傳網絡。",BT803:"為戶外及園區環境提供商用 LoRaWAN 覆蓋與回傳連接。",SYSTEM:"以 Bluetooth 處理即時本地照明反應，LoRaWAN 傳送數據與設定，再經 4G 或 IP 連接 Blutech Core。"},
  "zh-cn": {BT102:"将空间使用、室内空气质量、排队及设施信息整合到一个按项目设计的公共界面。",BT107:"43 英寸智能显示器，用于设施状态、排队信息及由物业管理的内容。",BT338:"结合热感阵列、毫米波及本地 AI，在不产生传统可识别图像的情况下理解占用、跌倒及异常活动。",BT337:"以 16×12 热感阵列提供隐私友好的空间使用与安全信号。",BT306:"监测温度、湿度及 PM2.5，支持报告、显示及与 HVAC／BMS 的项目集成。",BT802:"把分布于楼宇内的 LoRaWAN 传感器连接到 4G、以太网或 Wi‑Fi 回传网络。",BT803:"为户外及园区环境提供商用 LoRaWAN 覆盖与回传连接。",SYSTEM:"以 Bluetooth 处理即时本地照明响应，LoRaWAN 传送数据与设置，再经 4G 或 IP 连接 Blutech Core。"},
  ar:{BT102:"يجمع الإشغال وجودة الهواء والطوابير ومعلومات المرافق في واجهة عامة مصممة للمشروع.",BT107:"شاشة ذكية مقاس 43 بوصة لحالة المرافق والطوابير والمحتوى المُدار من فريق العقار.",BT338:"يجمع الاستشعار الحراري والرادار المليمترِي والذكاء المحلي لفهم الإشغال والسقوط والنشاط غير المعتاد من دون فيديو تعريفي تقليدي.",BT337:"مصفوفة حرارية 16×12 لإشارات الإشغال والسلامة مع الحفاظ على الخصوصية.",BT306:"يراقب الحرارة والرطوبة وPM2.5 ويدعم التقارير والعرض والتكامل مع HVAC وBMS.",BT802:"يربط حساسات LoRaWAN الموزعة في المبنى بشبكات 4G أو Ethernet أو Wi‑Fi.",BT803:"يوفر تغطية LoRaWAN تجارية للبيئات الخارجية والمجمعات.",SYSTEM:"يستخدم Bluetooth للاستجابة المحلية الفورية وLoRaWAN للبيانات والإعدادات ثم 4G أو IP للاتصال بمنصة Blutech Core."}
};
const fallback = ar ? `منتج تجاري من Blutech ضمن فئة ${family}، صُمم لدور واضح في نظام المبنى المتصل.` : lang === "zh-hk" ? `Blutech 的${family}商用產品，為連接式樓宇系統提供清晰、可管理的現場功能。` : `Blutech 的${family}商用产品，为连接式楼宇系统提供清晰、可管理的现场功能。`;
const intro = specific[lang][product.model] || fallback;
const benefits = ar ? [
  ["دور واضح",`يقدم ${product.name} إشارة أو وظيفة محددة يمكن لفريق العقار فهمها وإدارتها.`],
  ["اتصال مناسب للموقع","يُختار مسار الاتصال وفق زمن الاستجابة والتغطية والطاقة وسياسة شبكة العميل."],
  ["جزء من نظام كامل","يمكن ربط النتيجة مع Blutech Core وHalo والأنظمة المعتمدة في المبنى."]
] : lang === "zh-hk" ? [
  ["清晰的系統角色",`${product.name} 提供物業團隊能理解和管理的現場訊號或功能。`],
  ["按現場選擇連接","連接方式會按反應速度、覆蓋、供電及客戶網絡政策確定。"],
  ["可整合的完整系統","結果可連接 Blutech Core、Halo 及獲批准的樓宇系統。"]
] : [
  ["清晰的系统角色",`${product.name} 提供物业团队能理解和管理的现场信号或功能。`],
  ["按现场选择连接","连接方式会根据响应速度、覆盖、供电及客户网络政策确定。"],
  ["可集成的完整系统","结果可连接 Blutech Core、Halo 及获批准的楼宇系统。"]
];
const related = products.filter((p)=>p.family===product.family && p.slug!==product.slug).slice(0,3);
---
<BaseLayout title={`${product.model} ${product.name} | Blutech`} description={intro} lang={lang} dir={ar?"rtl":"ltr"} canonicalPath={`${prefix}/products/${product.slug}`} hasLocalizedVersions={true} image={image}>
  <section class="lpd-hero"><div class="shell"><div class="breadcrumb"><a href={prefix}>{ui.home}</a><span>›</span><a href={`${prefix}/products`}>{ui.products}</a><span>›</span><span>{product.model}</span></div><div class="lpd-grid"><div><div class="kicker">{family} · {product.model}</div>{product.award && <div class="award-mark">{ui.award}</div>}<h1>{product.name}</h1><p>{intro}</p><a class="button" href={`${prefix}/contact?product=${product.model}`}>{ui.talk}</a></div><div class="lpd-image"><img src={image} alt={`${product.model} ${product.name}`} /></div></div></div></section>
  <section class="lpd-benefits"><div class="shell"><div class="section-title">{ui.enables}</div><div class="benefit-grid">{benefits.map((b:any,i:number)=><article><span>0{i+1}</span><h2>{b[0]}</h2><p>{b[1]}</p></article>)}</div></div></section>
  <section id="details"><div class="shell details-grid"><div><div class="kicker">{ui.fit}</div><h2>{ar?"مصمم حول بيئة التشغيل.":lang==="zh-hk"?"按實際營運環境設計。":"按实际运营环境设计。"}</h2><p>{intro}</p></div><div class="spec-panel"><div class="kicker">{ui.technical}</div><table><tbody><tr><th>{ui.model}</th><td>{product.model}</td></tr><tr><th>{ui.role}</th><td>{family}</td></tr>{product.connectivity?.length && <tr><th>{ui.connectivity}</th><td>{product.connectivity.join(" · ")}</td></tr>}{product.power && <tr><th>{ui.power}</th><td>{product.power}</td></tr>}</tbody></table><p>{ui.note}</p></div></div></section>
  {related.length>0 && <section class="related"><div class="shell"><div class="related-head"><h2>{ui.related}</h2><a href={`${prefix}/products`}>{ui.all} →</a></div><div class="related-grid">{related.map((p)=>{const img=getProductImage(p.model,p.image);return <a href={`${prefix}/products/${p.slug}`}><img src={img} alt="" loading="lazy"/><span>{p.model}</span><h3>{p.name}</h3></a>})}</div></div></section>}
  <section class="lpd-cta"><div class="shell cta"><div><h2>{ui.cta}</h2><p>{ui.ctaBody}</p></div><a class="button" href={`${prefix}/contact?product=${product.model}`}>{ui.discuss}</a></div></section>
</BaseLayout>
<style>
.lpd-hero{background:#fff;padding:38px 0 70px}.lpd-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;min-height:500px}.lpd-grid h1{font-size:clamp(44px,4.8vw,66px);line-height:1;letter-spacing:-.05em;margin:12px 0 18px}.lpd-grid p{font-size:18px;color:var(--muted);max-width:620px}.lpd-grid .button{margin-top:18px}.lpd-image{height:470px;background:#eef0ed;display:grid;place-items:center}.lpd-image img{width:100%;height:100%;object-fit:contain;padding:8%;mix-blend-mode:multiply}.award-mark{display:inline-block;color:#d71920;border:1px solid rgba(215,25,32,.4);padding:5px 7px;font-size:9px;font-weight:900;margin-top:12px}.lpd-benefits{background:#f0f1ee}.section-title{font-size:12px;color:var(--brand-2);font-weight:850;margin-bottom:20px}.benefit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.benefit-grid article{background:#fff;padding:26px}.benefit-grid span{font-size:10px;color:var(--brand-2);font-weight:900}.benefit-grid h2{font-size:22px;margin:25px 0 10px}.benefit-grid p{font-size:13px;color:var(--muted)}.details-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px}.details-grid h2{font-size:clamp(34px,3.6vw,48px);line-height:1.03;letter-spacing:-.04em}.details-grid>div:first-child p{color:var(--muted)}.spec-panel{background:#f0f1ee;padding:30px}.spec-panel table{width:100%;border-collapse:collapse;margin-top:15px}.spec-panel th,.spec-panel td{text-align:start;padding:13px 0;border-bottom:1px solid var(--line);font-size:12px}.spec-panel th{color:var(--muted);width:120px}.spec-panel p{font-size:11px;color:var(--muted)}.related{background:#eef0ed}.related-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:25px}.related-head h2{font-size:34px;margin:0}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.related-grid a{background:#fff;padding-bottom:18px}.related-grid img{width:100%;height:210px;object-fit:contain;padding:8%}.related-grid span,.related-grid h3{display:block;margin-left:18px;margin-right:18px}.related-grid span{font-size:10px;color:var(--brand-2)}.related-grid h3{font-size:20px}.lpd-cta{background:#151718;color:#fff}.cta{display:flex;justify-content:space-between;align-items:end;gap:50px}.cta h2{font-size:clamp(34px,3.8vw,50px);line-height:1.03;margin:0}.cta p{color:#b9c1c3}.cta .button{background:#fff;color:#111;border-color:#fff}
@media(max-width:850px){.lpd-grid,.details-grid{grid-template-columns:1fr}.lpd-image{height:390px}.benefit-grid{grid-template-columns:1fr}.related-grid{grid-template-columns:1fr 1fr}.cta{display:block}.cta .button{margin-top:18px}}@media(max-width:520px){.related-grid{grid-template-columns:1fr}}
</style>
