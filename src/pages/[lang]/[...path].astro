---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products, projects } from "../../data/site";

export function getStaticPaths(){
  const langs = ["zh-hk","zh-cn","ar"];
  const pages = ["home","solutions","products","software","projects","technology","company","resources","contact"];
  return langs.flatMap((lang)=>pages.map((page)=>({params:{lang,path:page==="home"?undefined:page},props:{lang,page}})));
}

const { lang, page } = Astro.props;
const isAr = lang === "ar";
const copy:any = {
  "zh-hk": {
    home:["Blutech｜Building IoT & AIoT","連接樓宇，理解正在發生的事。","Blutech 從感測器到軟件建立完整的 Building IoT & AIoT 系統：私隱友善感知、無線連接、邊緣自動化、Halo、Core 及樓宇系統整合。"],
    solutions:["解決方案｜Blutech","由營運問題出發，而不是由感測器出發。","按空間、私隱要求、反應速度、現有系統及安裝限制，組合合適的感知、連接、本地邏輯和軟件。"],
    products:["產品｜Blutech","真正部署及支援的 Building IoT 產品。","只展示目前支援或已有商業部署的產品；停產、項目專用型號及消防產品不混在一般 Blutech 目錄內。"],
    software:["Blutech Halo & Core｜軟件","Core 在底層，Halo 在外圍。","Halo 面向樓宇營運人員；Core 面向 IoT 設備、網關、配置、連接及整合管理。"],
    projects:["項目｜Blutech","真實樓宇，真實現場條件。","精選商業樓宇、醫院、政府設施及交通基建的實際部署；只陳述可確認的項目範圍。"],
    technology:["技術｜Blutech","不是單一感測器，也不是單一協議。","Blutech 把私隱友善感知、LoRaWAN、Bluetooth、4G、Wi‑Fi、RS485、邊緣控制及 API 整合成實際可運作的系統。"],
    company:["公司｜Blutech IoT Limited","讓 Building IoT 真正在現場長期運作。","Blutech 於 2019 年在香港成立，研發連接式樓宇硬件、軟件及系統整合方案。"],
    resources:["資源｜Blutech","在招標、試點或改造前先把問題弄清楚。","為 FM、顧問及系統整合商整理私隱感知、LoRaWAN、智慧洗手間及漏水監測等實用設計重點。"],
    contact:["聯絡 Blutech","告訴我們樓宇需要理解或自動化甚麼。","產品、項目、招標、Halo、Core、API 或 BLUTA Fire 查詢均可聯絡 Blutech 團隊。"],
    contactUs:"聯絡我們", more:"了解更多", bluta:"BLUTA Fire 是由 Blutech 團隊發展的專用消防及生命安全品牌。"
  },
  "zh-cn": {
    home:["Blutech｜Building IoT & AIoT","连接楼宇，理解正在发生的事。","Blutech 从传感器到软件建立完整的 Building IoT & AIoT 系统：隐私友好感知、无线连接、边缘自动化、Halo、Core 及楼宇系统集成。"],
    solutions:["解决方案｜Blutech","从运营问题出发，而不是从传感器出发。","根据空间、隐私要求、响应速度、现有系统及安装限制，组合合适的感知、连接、本地逻辑和软件。"],
    products:["产品｜Blutech","真正部署及支持的 Building IoT 产品。","只展示目前支持或已有商业部署的产品；停产、项目专用型号及消防产品不混在一般 Blutech 目录内。"],
    software:["Blutech Halo & Core｜软件","Core 在底层，Halo 在外围。","Halo 面向楼宇运营人员；Core 面向 IoT 设备、网关、配置、连接及集成管理。"],
    projects:["项目｜Blutech","真实楼宇，真实现场条件。","精选商业楼宇、医院、政府设施及交通基础设施的实际部署；只陈述可确认的项目范围。"],
    technology:["技术｜Blutech","不是单一传感器，也不是单一协议。","Blutech 将隐私友好感知、LoRaWAN、Bluetooth、4G、Wi‑Fi、RS485、边缘控制及 API 集成为实际可运行的系统。"],
    company:["公司｜Blutech IoT Limited","让 Building IoT 真正在现场长期运行。","Blutech 于 2019 年在香港成立，研发连接式楼宇硬件、软件及系统集成方案。"],
    resources:["资源｜Blutech","在招标、试点或改造前先把问题弄清楚。","为 FM、顾问及系统集成商整理隐私感知、LoRaWAN、智慧洗手间及漏水监测等实用设计重点。"],
    contact:["联系 Blutech","告诉我们楼宇需要理解或自动化什么。","产品、项目、招标、Halo、Core、API 或 BLUTA Fire 咨询均可联系 Blutech 团队。"],
    contactUs:"联系我们", more:"了解更多", bluta:"BLUTA Fire 是由 Blutech 团队发展的专用消防及生命安全品牌。"
  },
  ar: {
    home:["Blutech | إنترنت الأشياء والذكاء الاصطناعي للمباني","اربط المبنى. وافهم ما يحدث داخله.","تبني Blutech أنظمة المباني المتصلة من الحساس إلى البرمجيات: استشعار يحترم الخصوصية، شبكات لاسلكية، أتمتة طرفية، Halo وCore وتكامل مع أنظمة المبنى."],
    solutions:["الحلول | Blutech","ابدأ بالمشكلة التشغيلية، لا بالحساس.","نختار الاستشعار والاتصال والمنطق المحلي والبرمجيات وفق المساحة والخصوصية وسرعة الاستجابة والأنظمة القائمة وقيود الموقع."],
    products:["المنتجات | Blutech","منتجات إنترنت أشياء للمباني مثبتة ومستخدمة فعلياً.","نعرض المنتجات التي تدعمها Blutech حالياً أو التي تم نشرها تجارياً، مع إبقاء منتجات الحريق تحت BLUTA Fire بشكل منفصل."],
    software:["Blutech Halo & Core | البرمجيات","Core في الداخل. Halo حوله.","Halo لفرق تشغيل المباني؛ Core لإدارة أجهزة إنترنت الأشياء والبوابات والإعداد والاتصال والتكامل."],
    projects:["المشاريع | Blutech","مبانٍ حقيقية. ظروف تشغيل حقيقية.","نماذج من عمليات نشر في مبانٍ تجارية ومستشفيات ومرافق حكومية وبنية تحتية للنقل، مع وصف محافظ للنطاق المؤكد."],
    technology:["التقنية | Blutech","ليس حساساً واحداً ولا بروتوكولاً واحداً.","تجمع Blutech الاستشعار المحافظ على الخصوصية وLoRaWAN وBluetooth و4G وWi‑Fi وRS485 والتحكم الطرفي وواجهات API في نظام عملي واحد."],
    company:["الشركة | Blutech IoT Limited","تقنية مبانٍ مصممة للعمل في الموقع الحقيقي.","تأسست Blutech في هونغ كونغ عام 2019 وتطور أجهزة وبرمجيات وتكاملات للمباني المتصلة."],
    resources:["المصادر | Blutech","افهم التصميم قبل المناقصة أو التجربة أو التحديث.","ملاحظات عملية لفرق المرافق والاستشاريين حول الاستشعار المحافظ على الخصوصية وLoRaWAN ودورات المياه الذكية وتسرب المياه."],
    contact:["تواصل مع Blutech","أخبرنا بما يحتاج المبنى إلى فهمه أو أتمتته.","للاستفسارات حول المنتجات والمشاريع وHalo وCore والتكامل وBLUTA Fire تواصل مع فريق Blutech."],
    contactUs:"تواصل معنا", more:"اعرف المزيد", bluta:"BLUTA Fire هي العلامة المتخصصة في أنظمة الحريق وسلامة الأرواح التي يطورها فريق Blutech."
  }
};
const t = copy[lang];
const [title,heading,intro] = t[page];
const prefix = `/${lang}`;
const solutionNames = lang==="ar" ? ["دورات مياه ذكية","إشغال يحترم الخصوصية","كشف السقوط والبقاء الطويل","إضاءة ذكية لاسلكية","جودة الهواء الداخلي وHVAC","مراقبة تسرب المياه","مراقبة النفايات","تحديث IoT للمباني"] : lang==="zh-hk" ? ["智慧洗手間","私隱友善空間使用偵測","跌倒、長時間逗留及靜止偵測","無線智慧照明","室內空氣質素及 HVAC 互動","漏水監測","智慧垃圾桶監測","Building IoT 改造"] : ["智慧洗手间","隐私友好空间使用检测","跌倒、长时间逗留及静止检测","无线智慧照明","室内空气质量及 HVAC 互动","漏水监测","智慧垃圾桶监测","Building IoT 改造"];
---
<BaseLayout title={title} description={intro} lang={lang} dir={isAr?"rtl":"ltr"} canonicalPath={`${prefix}${page==="home"?"/":`/${page}`}`} hasLocalizedVersions={true}>
  <section class="page-hero"><div class="shell"><div class="kicker">Blutech · Building IoT & AIoT</div><h1>{heading}</h1><p>{intro}</p><div class="actions" style="margin-top:24px"><a class="button" href={`${prefix}/contact`}>{t.contactUs}</a></div></div></section>

  {page==="home" && <><section><div class="shell grid grid-3"><div class="card"><div class="meta">Sense</div><h3>{isAr?"استشعار يحترم الخصوصية":lang==="zh-hk"?"私隱友善感知":"隐私友好感知"}</h3><p>Thermal · PIR · mmWave · sensor fusion</p></div><div class="card"><div class="meta">Connect</div><h3>LoRaWAN · Bluetooth · 4G</h3><p>{isAr?"اختيار الاتصال وفق ظروف الموقع.":lang==="zh-hk"?"按現場條件選擇連接方式。":"按现场条件选择连接方式。"}</p></div><div class="card"><div class="meta">Integrate</div><h3>API · MQTT · BMS</h3><p>{isAr?"ربط بيانات IoT بأنظمة المبنى.":lang==="zh-hk"?"把 IoT 數據連接至樓宇系統。":"把 IoT 数据连接至楼宇系统。"}</p></div></div></section><section style="background:var(--bg-2)"><div class="shell software-pair"><div class="card software-card"><div class="software-role">Building Intelligence</div><h3>Blutech Halo</h3><p>{isAr?"الحالة الحية والمخططات والتنبيهات والتقارير.":lang==="zh-hk"?"即時狀態、樓層圖、警報及報告。":"实时状态、楼层图、警报及报告。"}</p></div><div class="card software-card core"><div class="software-role">IoT Infrastructure</div><h3>Blutech Core</h3><p>{isAr?"الأجهزة والبوابات والإعداد وصحة الاتصال والتكامل.":lang==="zh-hk"?"設備、網關、配置、連接健康及整合。":"设备、网关、配置、连接健康及集成。"}</p></div></div></section><section><div class="shell panel brand-callout"><h2>BLUTA Fire</h2><p>{t.bluta}</p><a class="button" href="https://bluta.io" target="_blank" rel="noopener">bluta.io ↗</a></div></section></>}

  {page==="solutions" && <section><div class="shell grid grid-2">{solutionNames.map((name,i)=><div class="card"><div class="meta">0{i+1}</div><h3>{name}</h3><p>{isAr?"الاستشعار والاتصال والبرمجيات والتكامل حسب الموقع.":lang==="zh-hk"?"按現場需求組合感知、連接、軟件及整合。":"按现场需求组合感知、连接、软件及集成。"}</p></div>)}</div></section>}

  {page==="products" && <section><div class="shell product-grid">{products.map((p)=><a class="card product-card" href={`/products/${p.slug}`}><div class="model">{p.model} · {p.family}</div><h3>{p.name}</h3><p>{isAr?"الوظائف والمواصفات المؤكدة متاحة في صفحة المنتج.":lang==="zh-hk"?"查看產品已確認的功能及規格。":"查看产品已确认的功能及规格。"}</p><span class="card-link">{t.more} →</span></a>)}</div></section>}

  {page==="software" && <section><div class="shell software-pair"><article class="card software-card"><div class="software-role">Building Intelligence & Management</div><h3>Blutech Halo</h3><p>{isAr?"منصة التشغيل: الحالة الحية والمخططات والتنبيهات والسجل والتقارير.":lang==="zh-hk"?"營運平台：即時狀態、樓層圖、警報、歷史及報告。":"运营平台：实时状态、楼层图、警报、历史及报告。"}</p></article><article class="card software-card core"><div class="software-role">IoT Device & Integration</div><h3>Blutech Core</h3><p>{isAr?"الطبقة التقنية للأجهزة والبوابات والإعداد والاتصال وواجهات API.":lang==="zh-hk"?"設備、網關、配置、連接及 API 的技術層。":"设备、网关、配置、连接及 API 的技术层。"}</p></article></div></section>}

  {page==="projects" && <section><div class="shell project-grid">{projects.map((p)=><article class="card project-card"><img src={p.image} alt={p.title} loading="lazy"/><div class="card-body"><div class="meta">{p.category}</div><h3>{p.title}</h3></div></article>)}</div></section>}

  {page==="technology" && <section><div class="shell grid grid-3"><div class="card"><h3>Thermal · PIR · mmWave</h3><p>{isAr?"استشعار يحترم الخصوصية.":lang==="zh-hk"?"私隱友善感知。":"隐私友好感知。"}</p></div><div class="card"><h3>LoRaWAN · Bluetooth · 4G</h3><p>{isAr?"اتصال حسب الغرض.":lang==="zh-hk"?"按用途選擇連接。":"按用途选择连接。"}</p></div><div class="card"><h3>Edge · API · MQTT</h3><p>{isAr?"تحكم محلي وتكامل مفتوح.":lang==="zh-hk"?"本地控制及開放整合。":"本地控制及开放集成。"}</p></div></div></section>}

  {page==="company" && <><section><div class="shell split"><div><div class="kicker">Since 2019 · Hong Kong</div><h2>Blutech IoT Limited</h2><p class="hero-copy" style="font-size:19px">{intro}</p></div><div class="panel"><h3>Building IoT & AIoT</h3><p>Hardware · Connectivity · Edge · Halo · Core · Integration</p></div></div></section><section style="background:var(--bg-2)"><div class="shell panel brand-callout"><h2>BLUTA Fire</h2><p>{t.bluta}</p><a class="button" href="https://bluta.io" target="_blank" rel="noopener">bluta.io ↗</a></div></section></>}

  {page==="resources" && <section><div class="shell grid grid-2"><div class="card"><h3>Fall detection without cameras</h3><p>{isAr?"تصميم الاستشعار والتنبيه في المساحات الحساسة للخصوصية.":lang==="zh-hk"?"私隱敏感空間的感知及警報設計。":"隐私敏感空间的感知及警报设计。"}</p></div><div class="card"><h3>LoRaWAN building retrofit</h3><p>{isAr?"اختيار الشبكات في تحديث المباني.":lang==="zh-hk"?"樓宇改造中的網絡選擇。":"楼宇改造中的网络选择。"}</p></div><div class="card"><h3>Smart washroom system design</h3><p>{isAr?"الإشغال والسلامة وجودة الهواء والتشغيل.":lang==="zh-hk"?"佔用、安全、IAQ 及營運。":"占用、安全、IAQ 及运营。"}</p></div><div class="card"><h3>Point vs cable water leakage</h3><p>{isAr?"اختيار طريقة كشف التسرب المناسبة.":lang==="zh-hk"?"選擇合適的漏水偵測方式。":"选择合适的漏水检测方式。"}</p></div></div></section>}

  {page==="contact" && <section><div class="shell split"><div><h2>enquiry@blutech.io</h2><p class="hero-copy" style="font-size:19px">{intro}</p></div><div class="panel"><h3>{isAr?"أرسل لنا":lang==="zh-hk"?"建議提供":"建议提供"}</h3><ul class="feature-list"><li>{isAr?"نوع المبنى والموقع":lang==="zh-hk"?"樓宇類型及位置":"楼宇类型及位置"}</li><li>{isAr?"الوظيفة المطلوبة":lang==="zh-hk"?"希望做到的功能":"希望实现的功能"}</li><li>{isAr?"النظام أو الشبكة الحالية":lang==="zh-hk"?"現有系統或網絡":"现有系统或网络"}</li></ul><a class="button" href="mailto:enquiry@blutech.io">enquiry@blutech.io</a></div></div></section>}
</BaseLayout>
