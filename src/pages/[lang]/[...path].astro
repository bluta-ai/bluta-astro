---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products, solutions } from "../../data/site";
import { projects, deploymentSites } from "../../data/projects";
import { getProductImage } from "../../data/productMedia";
import hero from "../../assets/bluta-hero-city.webp";
import hk from "../../assets/office-hong-kong.webp";
import dg from "../../assets/office-dongguan.webp";
import qa from "../../assets/office-qatar.webp";

export function getStaticPaths(){const langs=["zh-hk","zh-cn","ar"];const pages=["home","solutions","products","software","projects","technology","company","resources","contact"];return langs.flatMap((lang)=>pages.map((page)=>({params:{lang,path:page==="home"?undefined:page},props:{lang,page}})))}
const {lang,page}=Astro.props;const ar=lang==="ar";const prefix=`/${lang}`;
const L:any={
"zh-hk":{titles:{home:"Blutech｜建築人工智能與物聯網",solutions:"解決方案｜Blutech",products:"產品｜Blutech",software:"Halo 與 Core｜Blutech 軟件",projects:"項目｜Blutech",technology:"技術｜Blutech",company:"公司｜Blutech IoT Limited",resources:"資源｜Blutech",contact:"聯絡 Blutech"},hero:"讓樓宇更容易理解。",intro:"Blutech 連接精準感測、本地控制、無線網絡及樓宇軟件，讓業主以更清晰的資訊管理物業，也讓設計團隊能指定一套完整系統。",kicker:"建築人工智能與物聯網",owners:"給業主",ownersB:"從物業層面理解風險、使用情況與表現，支援 ESG、資產規劃及長期改善。",ops:"給營運團隊",opsB:"透過即時狀態、樓層圖、警報及報告，清楚知道哪裏需要處理及下一步工作。",viewProjects:"查看已落成項目",viewProducts:"瀏覽產品",softwareH:"Halo 負責營運，Core 負責底層設備。",softwareB:"兩個互相連接的軟件層，各自處理清晰的工作。",halo:"即時狀態、樓層圖、警報、工作單、歷史、報告、權限及獲授權控制。",core:"設備、網關、配置、連接健康、規則、數據格式、API 及整合。",allSoftware:"了解軟件",productH:"在商用項目中真正運作的硬件。",productB:"每個產品頁都解釋用途、連接方式、適用環境及需要按項目確認的資料。",allProducts:"所有產品",projectH:"清楚說明交付內容及物業價值。",projectB:"每個案例只包括已確認範圍，並以具體 KPI、操作流程及實際成效說明。",allProjects:"所有項目",solutionsH:"由營運問題出發。",solutionsB:"按空間、私隱、反應速度、網絡及整合要求組合感測、控制與軟件。",techH:"邊緣負責即時反應，雲端負責可視性與管理。",techB:"Bluetooth 用於本地控制，LoRaWAN 傳送數據與設定，4G 或 IP 把網關連接到 Blutech Core。",companyH:"由香港出發，連接產品、項目與客戶。",companyB:"Blutech 於 2019 年成立，在香港設總部、東莞設研發辦公室，並由卡塔爾辦公室支援中東項目。",deploy:"部署網絡",awards:"獎項與認可",resourcesH:"先理解設計，再進行招標、試點或改造。",contactH:"告訴我們樓宇需要理解或自動化甚麼。",contactB:"請提供樓宇類型、位置、希望做到的功能、現有網絡或系統，以及時間要求。",talk:"聯絡 Blutech",ctaH:"有一個不適合套用標準目錄的樓宇問題？",ctaB:"這通常就是我們工程工作的起點。"},
"zh-cn":{titles:{home:"Blutech｜建筑人工智能与物联网",solutions:"解决方案｜Blutech",products:"产品｜Blutech",software:"Halo 与 Core｜Blutech 软件",projects:"项目｜Blutech",technology:"技术｜Blutech",company:"公司｜Blutech IoT Limited",resources:"资源｜Blutech",contact:"联系 Blutech"},hero:"让楼宇更容易理解。",intro:"Blutech 连接精准传感、本地控制、无线网络及楼宇软件，让业主以更清晰的信息管理物业，也让设计团队能指定一套完整系统。",kicker:"建筑人工智能与物联网",owners:"给业主",ownersB:"从物业层面理解风险、使用情况与表现，支持 ESG、资产规划及长期改善。",ops:"给运营团队",opsB:"通过实时状态、楼层图、报警及报告，清楚知道哪里需要处理及下一步工作。",viewProjects:"查看已落成项目",viewProducts:"浏览产品",softwareH:"Halo 负责运营，Core 负责底层设备。",softwareB:"两个互相连接的软件层，各自处理清晰的工作。",halo:"实时状态、楼层图、报警、工单、历史、报告、权限及获授权控制。",core:"设备、网关、配置、连接健康、规则、数据格式、API 及集成。",allSoftware:"了解软件",productH:"在商业项目中真正运行的硬件。",productB:"每个产品页都解释用途、连接方式、适用环境及需要按项目确认的资料。",allProducts:"所有产品",projectH:"清楚说明交付内容及物业价值。",projectB:"每个案例只包括已确认范围，并以具体 KPI、操作流程及实际成效说明。",allProjects:"所有项目",solutionsH:"从运营问题出发。",solutionsB:"根据空间、隐私、响应速度、网络及集成要求组合传感、控制与软件。",techH:"边缘负责即时响应，云端负责可视性与管理。",techB:"Bluetooth 用于本地控制，LoRaWAN 传送数据与设置，4G 或 IP 把网关连接到 Blutech Core。",companyH:"从香港出发，连接产品、项目与客户。",companyB:"Blutech 于 2019 年成立，在香港设总部、东莞设研发办公室，并由卡塔尔办公室支持中东项目。",deploy:"部署网络",awards:"奖项与认可",resourcesH:"先理解设计，再进行招标、试点或改造。",contactH:"告诉我们楼宇需要理解或自动化什么。",contactB:"请提供楼宇类型、位置、希望实现的功能、现有网络或系统，以及时间要求。",talk:"联系 Blutech",ctaH:"有一个不适合套用标准目录的楼宇问题？",ctaB:"这通常就是我们工程工作的起点。"},
ar:{titles:{home:"Blutech | الذكاء الاصطناعي وإنترنت الأشياء للمباني",solutions:"الحلول | Blutech",products:"المنتجات | Blutech",software:"Halo وCore | برمجيات Blutech",projects:"المشاريع | Blutech",technology:"التقنية | Blutech",company:"الشركة | Blutech IoT Limited",resources:"المصادر | Blutech",contact:"تواصل مع Blutech"},hero:"اجعل المبنى أسهل فهماً.",intro:"تربط Blutech الاستشعار الدقيق والتحكم المحلي والشبكات اللاسلكية وبرمجيات المبنى حتى يعمل المالك بمعلومات أوضح ويحدد فريق التصميم نظاماً متكاملاً.",kicker:"الذكاء الاصطناعي وإنترنت الأشياء للمباني",owners:"للمالكين",ownersB:"فهم المخاطر والاستخدام والأداء على مستوى العقار ودعم ESG وتخطيط الأصول والتحسين طويل الأجل.",ops:"لفرق التشغيل",opsB:"معرفة ما يحتاج إلى معالجة ومكانه والخطوة التالية عبر الحالة الحية والمخططات والتنبيهات والتقارير.",viewProjects:"عرض المشاريع المنفذة",viewProducts:"استكشف المنتجات",softwareH:"Halo للتشغيل. Core للبنية التحتية.",softwareB:"طبقتان مترابطتان، لكل منهما وظيفة واضحة.",halo:"الحالة الحية والمخططات والتنبيهات وأوامر العمل والسجل والتقارير والصلاحيات والتحكم المصرح.",core:"الأجهزة والبوابات والإعداد وصحة الاتصال والقواعد والبيانات وواجهات API والتكامل.",allSoftware:"استكشف البرمجيات",productH:"أجهزة تجارية تعمل في مشاريع حقيقية.",productB:"توضح كل صفحة وظيفة المنتج واتصاله وبيئة استخدامه وما يجب تأكيده للمشروع.",allProducts:"كل المنتجات",projectH:"ما تم تسليمه والقيمة للعقار.",projectB:"يقتصر كل مشروع على النطاق المؤكد ويشرح مؤشرات واضحة وسير التشغيل والنتيجة العملية.",allProjects:"كل المشاريع",solutionsH:"ابدأ بالمشكلة التشغيلية.",solutionsB:"نجمع الاستشعار والتحكم والبرمجيات وفق المساحة والخصوصية والاستجابة والشبكة والتكامل.",techH:"الطرف للاستجابة الفورية. السحابة للرؤية والإدارة.",techB:"يستخدم Bluetooth للتحكم المحلي وLoRaWAN للبيانات والإعدادات و4G أو IP لربط البوابات بمنصة Core.",companyH:"من هونغ كونغ إلى المنتج والمشروع والعميل.",companyB:"تأسست Blutech في 2019، بمقر في هونغ كونغ ومكتب بحث وتطوير في دونغقوان ومكتب في قطر لدعم الشرق الأوسط.",deploy:"شبكة المواقع",awards:"الجوائز والتقدير",resourcesH:"افهم التصميم قبل المناقصة أو التجربة أو التحديث.",contactH:"أخبرنا بما يحتاج المبنى إلى فهمه أو أتمتته.",contactB:"أرسل نوع المبنى والموقع والوظيفة المطلوبة والشبكة أو النظام الحالي والبرنامج الزمني.",talk:"تواصل مع Blutech",ctaH:"هل لديك مشكلة مبنى لا تناسب كتالوجاً جاهزاً؟",ctaB:"هنا يبدأ عملنا الهندسي غالباً."}}
const t=L[lang];
const projectText:any={"zh-hk":["1,000+ 設備、HVAC 聯動及 ESG 數據。","全機場旅客安全監測、樓層圖、警報及報告。","230 個廁格，覆蓋 B1 至 6 樓並對接 GWIN。","300+ 設備、180 個廁格、通風與 HVAC 聯動。","無障礙洗手間跌倒及意外偵測。","將軍澳服務機器排隊狀況及 Smart Display。","物資、漏水、HeatMap、IAQ、照明及 BT107。","覆蓋奧海城一期、二期及三期並對接 BMS。","智慧洗手間與公共設施資訊。"],"zh-cn":["1,000+ 设备、HVAC 联动及 ESG 数据。","全机场旅客安全监测、楼层图、报警及报告。","230 个厕格，覆盖 B1 至 6 楼并对接 GWIN。","300+ 设备、180 个厕格、通风与 HVAC 联动。","无障碍洗手间跌倒及意外检测。","将军澳服务机器排队状况及 Smart Display。","物资、漏水、HeatMap、IAQ、照明及 BT107。","覆盖奥海城一期、二期及三期并对接 BMS。","智能洗手间与公共设施信息。"],ar:["أكثر من 1,000 جهاز وتنسيق HVAC وبيانات ESG.","مراقبة سلامة عبر المطار مع مخططات وتنبيهات وتقارير.","230 مقصورة من B1 إلى الطابق السادس مع GWIN.","أكثر من 300 جهاز و180 مقصورة وتهوية وHVAC.","كشف السقوط والحوادث في المرافق الميسرة.","حالة طوابير أجهزة الخدمة وشاشة Smart Display.","مواد وتسرب مياه وHeatMap وجودة هواء وإضاءة وBT107.","تغطية المراحل 1 و2 و3 مع تكامل BMS.","مرافق ذكية ومعلومات عامة للزوار."]};
const solutionNames:any={"zh-hk":["智慧洗手間","私隱友善空間使用感測","跌倒與長時間逗留偵測","無線智慧照明","室內空氣質素與 HVAC","漏水監測","智慧垃圾桶","樓宇物聯網改造"],"zh-cn":["智能洗手间","隐私友好空间使用传感","跌倒与长时间停留检测","无线智能照明","室内空气质量与 HVAC","漏水监测","智能垃圾桶","楼宇物联网改造"],ar:["المرافق الذكية","استشعار الإشغال مع الخصوصية","كشف السقوط والبقاء الطويل","الإضاءة الذكية اللاسلكية","جودة الهواء وHVAC","مراقبة تسرب المياه","مراقبة النفايات","تحديث إنترنت الأشياء للمباني"]};
const groupLabels:any={"zh-hk":{"Commercial offices":"商業辦公樓","Retail & mixed-use":"商場與綜合用途","Healthcare":"醫療","Government, education & public":"政府、教育與公共設施","Transport & venues":"交通與場地","Hospitality & residential":"酒店與住宅"},"zh-cn":{"Commercial offices":"商业办公楼","Retail & mixed-use":"商场与综合用途","Healthcare":"医疗","Government, education & public":"政府、教育与公共设施","Transport & venues":"交通与场地","Hospitality & residential":"酒店与住宅"},ar:{"Commercial offices":"المكاتب التجارية","Retail & mixed-use":"التجزئة والاستخدام المختلط","Healthcare":"الرعاية الصحية","Government, education & public":"الحكومة والتعليم والمرافق العامة","Transport & venues":"النقل والمنشآت","Hospitality & residential":"الضيافة والسكن"}};
const desc=t.intro;
---
<BaseLayout title={t.titles[page]} description={desc} lang={lang} dir={ar?"rtl":"ltr"} canonicalPath={`${prefix}${page==="home"?"/":`/${page}`}`} hasLocalizedVersions={true}>
{page==="home"&&<><section class="lh"><img src={hero.src} alt=""/><div></div><div class="shell"><div class="eyebrow">{t.kicker}</div><h1>{t.hero}</h1><p>{t.intro}</p><div class="actions"><a class="button light" href={`${prefix}/projects`}>{t.viewProjects}</a><a class="text-link" href={`${prefix}/products`}>{t.viewProducts} →</a></div></div></section><section class="aud"><div class="shell aud-grid"><article><span>01</span><h2>{t.owners}</h2><p>{t.ownersB}</p></article><article><span>02</span><h2>{t.ops}</h2><p>{t.opsB}</p></article></div></section><section class="soft"><div class="shell"><div class="head"><h2>{t.softwareH}</h2><p>{t.softwareB}</p></div><div class="software-pair"><a class="software-card" href={`${prefix}/software#halo`}><div class="software-role">Blutech Halo</div><h3>Halo</h3><p>{t.halo}</p></a><a class="software-card core" href={`${prefix}/software#core`}><div class="software-role">Blutech Core</div><h3>Core</h3><p>{t.core}</p></a></div></div></section><section><div class="shell"><div class="head"><h2>{t.projectH}</h2><p>{t.projectB}</p></div><div class="lprojects">{projects.slice(0,3).map((p,i)=><a href={`${prefix}/projects/${p.slug}`}><img src={p.image} alt={p.title}/><div><h3>{p.title}</h3><p>{projectText[lang][i]}</p></div></a>)}</div></div></section><section class="final"><div class="shell cta"><div><h2>{t.ctaH}</h2><p>{t.ctaB}</p></div><a class="button" href={`${prefix}/contact`}>{t.talk}</a></div></section></>}
{page==="solutions"&&<><section class="lhero"><div class="shell"><div class="kicker">{t.titles.solutions}</div><h1>{t.solutionsH}</h1><p>{t.solutionsB}</p></div></section><section><div class="shell solution-grid">{solutionNames[lang].map((name:string,i:number)=><article><span>0{i+1}</span><h2>{name}</h2><p>{ar?"حل يجمع الإشارة والاتصال والمنطق المحلي والبرمجيات حسب الموقع.":lang==="zh-hk"?"按現場需要組合訊號、連接、本地邏輯及軟件。":"按现场需求组合信号、连接、本地逻辑及软件。"}</p></article>)}</div></section></>}
{page==="products"&&<><section class="lhero"><div class="shell"><div class="kicker">{t.titles.products}</div><h1>{t.productH}</h1><p>{t.productB}</p></div></section><section class="grey"><div class="shell lproducts">{products.map((p)=>{const img=getProductImage(p.model,p.image);return <a href={`${prefix}/products/${p.slug}`}><img src={img} alt={`${p.model} ${p.name}`}/><div><span>{p.model}</span>{p.award&&<b>iF DESIGN AWARD</b>}<h2>{p.name}</h2><p>{ar?"منتج بدور واضح ضمن نظام المبنى المتصل.":lang==="zh-hk"?"在連接式樓宇系統中具有清晰用途的商用產品。":"在连接式楼宇系统中具有清晰用途的商用产品。"}</p></div></a>})}</div></section></>}
{page==="software"&&<><section class="lhero"><div class="shell"><div class="kicker">{t.titles.software}</div><h1>{t.softwareH}</h1><p>{t.softwareB}</p></div></section><section id="halo"><div class="shell lsoft"><div><span>01</span><h2>Blutech Halo</h2><p>{t.halo}</p></div><ul>{(ar?["الحالة الحية والمخططات","التنبيهات وأوامر العمل","الاتجاهات والتقارير","الأدوار والتحكم المصرح"]:lang==="zh-hk"?["即時狀態與樓層圖","警報與工作單","趨勢與報告","角色與獲授權控制"]:["实时状态与楼层图","报警与工单","趋势与报告","角色与获授权控制"]).map(x=><li>{x}</li>)}</ul></div></section><section id="core" class="grey"><div class="shell lsoft"><div><span>02</span><h2>Blutech Core</h2><p>{t.core}</p></div><ul>{(ar?["سجل الأجهزة والبوابات","التسجيل والإعداد","صحة الاتصال والقواعد","البيانات وواجهات API والتدقيق"]:lang==="zh-hk"?["設備與網關清單","配置與項目結構","連接健康與規則","數據、API 與審計"]:["设备与网关清单","配置与项目结构","连接健康与规则","数据、API 与审计"]).map(x=><li>{x}</li>)}</ul></div></section></>}
{page==="projects"&&<><section class="lhero"><div class="shell"><div class="kicker">{t.titles.projects}</div><h1>{t.projectH}</h1><p>{t.projectB}</p></div></section><section class="grey"><div class="shell lprojects all">{projects.map((p,i)=><a href={`${prefix}/projects/${p.slug}`}><img src={p.image} alt={p.title}/><div><h2>{p.title}</h2><p>{projectText[lang][i]}</p><span>{ar?"دراسة المشروع":lang==="zh-hk"?"查看案例":"查看案例"} →</span></div></a>)}</div></section></>}
{page==="technology"&&<><section class="lhero"><div class="shell"><div class="kicker">{t.titles.technology}</div><h1>{t.techH}</h1><p>{t.techB}</p></div></section><section><div class="shell protocol"><article><span>01</span><h2>Bluetooth</h2><p>{ar?"تحكم محلي فوري ومنطق يعمل من دون رحلة إلى السحابة.":lang==="zh-hk"?"即時本地控制，關鍵反應不需來回雲端。":"即时本地控制，关键响应无需往返云端。"}</p></article><article><span>02</span><h2>LoRaWAN</h2><p>{ar?"بيانات بعيدة المدى ومنخفضة الطاقة وإعدادات للأجهزة الموزعة.":lang==="zh-hk"?"為分布於樓宇內的設備傳送長距離、低功耗數據與設定。":"为分布于楼宇内的设备传送长距离、低功耗数据与设置。"}</p></article><article><span>03</span><h2>4G / IP</h2><p>{ar?"يربط البوابة بمنصة Core ضمن حدود شبكة العميل.":lang==="zh-hk"?"在客戶網絡邊界內把網關連接至 Core。":"在客户网络边界内把网关连接至 Core。"}</p></article></div></section></>}
{page==="company"&&<><section class="lhero"><div class="shell"><div class="kicker">{t.titles.company}</div><h1>{t.companyH}</h1><p>{t.companyB}</p></div></section><section class="grey"><div class="shell offices">{[[hk,"Hong Kong"],[dg,"Dongguan"],[qa,"Qatar"]].map(([img,name]:any)=><article><img src={img.src} alt={name}/><h2>{name}</h2></article>)}</div></section><section><div class="shell"><div class="head"><h2>{t.awards}</h2></div><div class="awards"><article><b>2020</b><h3>Hong Kong ICT Awards</h3></article><article><b>2021</b><h3>APICTA</h3></article><article class="if"><b>2024</b><h3>iF DESIGN AWARD</h3></article><article><b>2023/24</b><h3>Smart Living Partnership Awards</h3></article></div></div></section><section id="deployments" class="grey"><div class="shell"><div class="head"><h2>{t.deploy}</h2></div><div class="deploy">{Object.entries(deploymentSites).map(([group,sites])=><article><h3>{groupLabels[lang][group]}</h3><ul>{sites.map(s=><li>{s}</li>)}</ul></article>)}</div></div></section></>}
{page==="resources"&&<><section class="lhero"><div class="shell"><div class="kicker">{t.titles.resources}</div><h1>{t.resourcesH}</h1><p>{t.solutionsB}</p></div></section><section><div class="shell resource-grid">{(ar?["كشف السقوط من دون كاميرات","تحديث المباني باستخدام LoRaWAN","تصميم المرافق الذكية","مقارنة كشف التسرب النقطي والكابلات"]:lang==="zh-hk"?["無攝影機跌倒偵測","LoRaWAN 樓宇改造","智慧洗手間系統設計","點式與感應線漏水偵測"]:["无摄像头跌倒检测","LoRaWAN 楼宇改造","智能洗手间系统设计","点式与感应线漏水检测"]).map((x,i)=><article><span>0{i+1}</span><h2>{x}</h2><p>{ar?"ملاحظات عملية للمالكين وفرق التشغيل والاستشاريين.":lang==="zh-hk"?"為業主、營運團隊及顧問整理的實用設計重點。":"为业主、运营团队及顾问整理的实用设计重点。"}</p></article>)}</div></section></>}
{page==="contact"&&<><section class="lhero"><div class="shell"><div class="kicker">{t.titles.contact}</div><h1>{t.contactH}</h1><p>{t.contactB}</p></div></section><section><div class="shell contact"><div><h2>enquiry@blutech.io</h2><p>{t.contactB}</p><a class="button" href="mailto:enquiry@blutech.io">{t.talk}</a></div><div><b>{ar?"المكاتب":lang==="zh-hk"?"辦公室":"办公室"}</b><p>Hong Kong · Dongguan · Qatar</p><b>{ar?"نطاق العمل":lang==="zh-hk"?"工作範圍":"工作范围"}</b><p>Hardware · Halo · Core · Integration · BLUTA</p></div></div></section></>}
</BaseLayout>
