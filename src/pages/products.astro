---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products } from "../data/site";
import { getProductImage } from "../data/productMedia";
const families = [...new Set(products.map((p)=>p.family))];
const heroImages = ["BT338","BT306","BT102"].map((model)=>getProductImage(model));
---
<BaseLayout title="Building IoT Hardware Products | Blutech" description="Blutech building IoT products for smart washrooms, occupancy, safety, IAQ, water leakage, displays, lighting, controls and LoRaWAN connectivity." canonicalPath="/products">
  <section class="page-hero product-intro"><div class="shell"><div class="product-hero-copy"><div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Products</span></div><div class="kicker">Verified product catalogue</div><h1>Built for the realities of a live building.</h1><p>Purpose-built sensors, gateways, displays and controls designed around property outcomes—not novelty. Every model shown is part of Blutech's current catalogue.</p></div><div class="product-hero-stack" aria-hidden="true">{heroImages.map((src)=><img src={src} alt="" />)}</div></div></section>
  <section class="catalogue"><div class="shell">
    <div class="catalogue-filter" aria-label="Product families"><a href="#all">All products</a>{families.map((family)=><a href={`#${family.toLowerCase().replaceAll(" ","-").replaceAll("&","and")}`}>{family}</a>)}</div>
    <div id="all" class="product-grid product-four">{products.map((p)=>{const image=getProductImage(p.model,p.image);return <a class="product-card" id={p.family.toLowerCase().replaceAll(" ","-").replaceAll("&","and")} href={`/products/${p.slug}`}><div class="product-image"><img src={image} alt={`${p.model} ${p.name}`} loading="lazy" /></div><div class="product-copy"><div class="model">{p.model} · {p.family}</div>{p.award && <span class="award-badge">iF DESIGN AWARD</span>}<h2>{p.name}</h2><p>{p.summary}</p><div class="protocols">{p.connectivity?.slice(0,3).map((c)=><span>{c}</span>)}</div><b>View product →</b></div></a>})}</div>
  </div></section>
  <section class="product-guidance"><div class="shell guidance-grid"><div><div class="kicker">Specification support</div><h2>Choose by outcome and site condition.</h2></div><div><p>Product selection depends on the room geometry, privacy requirement, response time, power, wireless coverage, network policy and integration boundary.</p><p>Blutech confirms mounting, communications, environmental rating and integration against the exact model and project configuration.</p><a class="button" href="/contact">Discuss a product schedule</a></div></div></section>
</BaseLayout>
<style>
.product-intro{min-height:650px}.product-intro>.shell{position:relative;display:flex;align-items:center;min-height:470px}.product-hero-copy{position:relative;z-index:2;width:min(720px,58%)}.product-intro h1{font-size:clamp(48px,5.6vw,78px);max-width:760px}.product-hero-stack{position:absolute;right:0;top:8%;width:47%;height:84%}.product-hero-stack img{position:absolute;width:58%;height:72%;object-fit:cover;border:1px solid rgba(255,255,255,.18);border-radius:11px;box-shadow:0 34px 80px rgba(0,0,0,.35)}.product-hero-stack img:nth-child(1){right:0;top:0}.product-hero-stack img:nth-child(2){left:0;top:22%;width:46%;height:63%}.product-hero-stack img:nth-child(3){right:17%;bottom:0;width:38%;height:52%}.catalogue{background:#f1f2ef}.catalogue-filter{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:26px}.catalogue-filter a{font-size:11px;border:1px solid var(--line);background:#fff;padding:8px 10px}.product-grid.product-four{grid-template-columns:repeat(4,minmax(0,1fr));gap:1px}.product-card{background:#fff;display:flex;flex-direction:column;min-height:100%}.product-image{aspect-ratio:4/3}.product-image img{padding:6%;object-fit:contain}.product-copy{padding:18px 19px 22px;display:flex;flex-direction:column;flex:1}.product-copy .model{margin:0}.product-copy h2{font-size:21px;line-height:1.08;letter-spacing:-.025em;margin:7px 0 9px}.product-copy p{font-size:12px;color:var(--muted);margin:0}.product-copy>b{font-size:12px;margin-top:auto;padding-top:22px}.award-badge{align-self:flex-start;color:#fff;background:#d71920;font-size:8px;font-weight:900;letter-spacing:.08em;padding:5px 6px;margin-top:8px}.protocols{display:flex;flex-wrap:wrap;gap:5px;margin-top:14px}.protocols span{font-size:9px;background:#f1f2ef;padding:5px 6px}.product-guidance{background:#fff}.guidance-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px}.guidance-grid h2{font-size:clamp(36px,4vw,54px);line-height:1.03;letter-spacing:-.045em;margin:9px 0}.guidance-grid p{color:var(--muted)}.guidance-grid .button{margin-top:12px}
@media(max-width:1100px){.product-grid.product-four{grid-template-columns:repeat(3,1fr)}}@media(max-width:820px){.product-hero-stack{opacity:.35;width:60%}.product-hero-copy{width:78%}.product-grid.product-four{grid-template-columns:repeat(2,1fr)}.guidance-grid{grid-template-columns:1fr;gap:28px}}@media(max-width:520px){.product-intro{min-height:auto}.product-intro>.shell{min-height:auto}.product-hero-stack{display:none}.product-hero-copy{width:100%}.product-grid.product-four{grid-template-columns:1fr}}
</style>
