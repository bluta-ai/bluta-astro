---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products, comparisonGroups } from "../data/site";
import { getProductImage } from "../data/productMedia";

const byModel = Object.fromEntries(products.map((p) => [p.model, p]));
const featuredModels = ["BT338","BT337","BT303","BT102","BT306","BT336","BT333","BT339","BT353","BT2035"];
const featured = featuredModels.map((m)=>byModel[m]).filter(Boolean);
const groups = [
  { title:"Sensing", note:"Understand occupancy, activity, environmental conditions and physical events without adding visual clutter to the space.", models:["BT303","BT306","BT321","BT333","BT336","BT337","BT338","BT339","BT353","BT3022","BT3023"] },
  { title:"Control & response", note:"Turn sensor events into local actions, service calls, alarms and visible status.", models:["BT311","BT315","BT316","BT317","BT2035"] },
  { title:"Display & guidance", note:"Make live facility information useful to visitors and building operators at the point of need.", models:["BT101","BT102","BT103","BT107"] },
  { title:"Connectivity", note:"Connect distributed field devices to the building's IP and cloud integration layer.", models:["BT802","BT803"] },
];
const familyTiles = [
  { title:"Sensing", models:["BT338","BT303"] },
  { title:"Control & response", models:["BT317","BT311"] },
  { title:"Display & guidance", models:["BT102","BT2035"] },
  { title:"Connectivity", models:["BT315","BT306"] },
];
---
<BaseLayout title="Products | Blutech Building IoT & AIoT" description="Blutech sensing, control, display and connectivity technology for premium commercial buildings, public facilities, healthcare and smart-building retrofits." canonicalPath="/products">
  <section class="product-hero">
    <div class="shell product-hero-grid">
      <div class="product-hero-copy">
        <div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Products</span></div>
        <div class="kicker">Products</div>
        <h1>Technology designed for real buildings.</h1>
        <p>Purpose-built sensing, control, display and connectivity systems for smarter operations, better experiences and more adaptable buildings.</p>
        <div class="hero-actions"><a class="button" href="#featured">Explore products</a><a class="quiet-link" href="/contact">Discuss a building →</a></div>
      </div>
      <div class="showroom" aria-label="Selected Blutech products">
        {featured.slice(0,5).map((p,i)=><a class={`showroom-product p${i+1}`} href={`/products/${p.slug}`}>
          <img src={getProductImage(p.model,p.image)} alt={`${p.model} ${p.name}`} width="640" height="520" loading={i<2?"eager":"lazy"}/>
          <span><b>{p.model}</b>{p.name}</span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="featured" id="featured">
    <div class="shell">
      <div class="compact-heading"><div><div class="kicker">Featured products</div><h2>Designed to disappear into the architecture — and make the building work better.</h2></div><a class="quiet-link" href="#catalogue">View all products ↓</a></div>
      <div class="featured-grid">
        {featured.map((p)=><a class="featured-card" href={`/products/${p.slug}`}>
          <div class="featured-image"><img src={getProductImage(p.model,p.image)} alt={`${p.model} ${p.name}`} loading="lazy" width="720" height="560"/></div>
          <div class="featured-copy"><span class="model">{p.model}</span><h3>{p.name}</h3><p>{p.headline || p.summary}</p><b>Explore →</b></div>
        </a>)}
      </div>
    </div>
  </section>

  <section class="family-band">
    <div class="shell family-grid">
      {familyTiles.map((family)=><div class="family-tile">
        <div class="family-art">{family.models.map((m,i)=>{ const p=byModel[m]; const img=p && getProductImage(p.model,p.image); return img ? <img class={`family-img fi${i+1}`} src={img} alt="" loading="lazy"/> : null })}</div>
        <div class="family-copy"><h3>{family.title}</h3><span>Explore below ↓</span></div>
      </div>)}
    </div>
  </section>

  <section class="lighting-feature">
    <div class="shell lighting-feature-grid">
      <div class="lighting-copy">
        <div class="kicker">New lighting solution</div>
        <h2>Smarter lighting.<br/>Less retrofit friction.</h2>
        <p>Blutech's wireless smart-lighting system combines local BLE sensing and control with 0–10V dimming, locally stored schedules, central monitoring and BMS/API integration.</p>
        <div class="lighting-benefits"><span>Occupancy response</span><span>Daylight logic</span><span>0–10V dimming</span><span>Schedules & override</span><span>BMS integration</span></div>
        <a class="button light" href="/products/wireless-smart-lighting">Discover the lighting solution</a>
      </div>
      <div class="lighting-visual" aria-hidden="true">
        <div class="ceiling-lines"><i></i><i></i><i></i><i></i><i></i></div>
        <div class="lighting-diagram"><div><b>PIR / Lux</b><small>Sense</small></div><em>→</em><div><b>BLE</b><small>Local control</small></div><em>→</em><div><b>0–10V</b><small>Dim</small></div><em>→</em><div><b>Gateway</b><small>Manage</small></div><em>→</em><div><b>BMS / API</b><small>Integrate</small></div></div>
      </div>
    </div>
  </section>

  <section class="catalogue" id="catalogue">
    <div class="shell">
      <div class="compact-heading"><div><div class="kicker">Complete catalogue</div><h2>Choose by the job the building needs done.</h2></div></div>
      {groups.map((group)=><div class="catalogue-group">
        <div class="group-intro"><h3>{group.title}</h3><p>{group.note}</p></div>
        <div class="catalogue-list">
          {group.models.map((model)=>byModel[model]).filter(Boolean).map((p)=>{ const img=getProductImage(p.model,p.image); return <a class="catalogue-row" href={`/products/${p.slug}`}>
            <div class={`thumb ${img?"":"no-thumb"}`}>{img ? <img src={img} alt="" loading="lazy"/> : <span>{p.model}</span>}</div>
            <div class="row-name"><span>{p.model}</span><strong>{p.name}</strong></div>
            <p>{p.summary}</p>
            <div class="row-connect">{p.connectivity?.slice(0,3).join(" · ") || "Project-specific"}</div><b class="arrow">→</b>
          </a>})}
        </div>
      </div>)}
    </div>
  </section>

  <section class="compare-block">
    <div class="shell">
      <div class="compact-heading"><div><div class="kicker">Compare</div><h2>Similar role. Different fit.</h2></div><a class="button secondary" href="/products/compare">Open comparisons</a></div>
      <div class="compare-grid">{comparisonGroups.map((g)=><a href={`/products/compare#${g.models.join("-").toLowerCase()}`}><span>{g.title}</span><strong>{g.models.join(" / ")}</strong><p>{g.note}</p><b>→</b></a>)}</div>
    </div>
  </section>

  <section class="bluta-strip"><div class="shell bluta-strip-grid"><div><div class="kicker">From Blutech</div><h2>Fire & life-safety products live under BLUTA Fire.</h2><p>BLUTA Fire is the dedicated fire-related brand developed by the Blutech team, kept separate from the building-IoT catalogue above.</p></div><a class="button" href="https://bluta.io" target="_blank" rel="noopener">Discover BLUTA Fire ↗</a></div></section>
</BaseLayout>

<style>
.product-hero{background:#fff;border-bottom:1px solid var(--line);padding:0}.product-hero-grid{display:grid;grid-template-columns:.76fr 1.24fr;min-height:650px}.product-hero-copy{display:flex;flex-direction:column;justify-content:center;padding:70px 70px 70px 0}.product-hero-copy h1{font-size:clamp(54px,5.7vw,82px);line-height:.96;letter-spacing:-.055em;margin:12px 0 24px;max-width:650px}.product-hero-copy>p{font-size:19px;color:var(--muted);max-width:590px;margin:0}.hero-actions{display:flex;align-items:center;gap:24px;margin-top:30px}.quiet-link{font-size:13px;font-weight:800;border-bottom:1px solid currentColor}.showroom{position:relative;min-height:650px;background:linear-gradient(135deg,#e9e8e3,#f7f6f2);overflow:hidden;border-left:1px solid var(--line)}.showroom:before{content:"";position:absolute;inset:auto 7% 7% 7%;height:22%;background:linear-gradient(180deg,#d8d5cd,#eceae4);box-shadow:0 18px 45px rgba(35,31,25,.08)}.showroom-product{position:absolute;display:flex;align-items:center;justify-content:center;transition:transform .25s ease}.showroom-product:hover{transform:translateY(-5px)}.showroom-product img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 18px 20px rgba(30,30,27,.14))}.showroom-product span{position:absolute;left:5%;bottom:-4px;font-size:10px;color:#61676a}.showroom-product span b{display:block;color:#111}.p1{left:5%;top:12%;width:34%;height:42%}.p2{left:39%;top:20%;width:28%;height:34%}.p3{right:4%;top:10%;width:26%;height:39%}.p4{left:15%;bottom:7%;width:25%;height:28%}.p5{right:13%;bottom:5%;width:32%;height:31%}
.featured{background:#f7f7f4}.compact-heading{display:flex;justify-content:space-between;align-items:end;gap:45px;margin-bottom:32px}.compact-heading h2{font-size:clamp(34px,3.7vw,54px);line-height:1.02;letter-spacing:-.045em;margin:9px 0 0;max-width:900px}.featured-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.featured-card{background:#fff;border:1px solid var(--line);transition:transform .2s ease,box-shadow .2s ease}.featured-card:hover{transform:translateY(-4px);box-shadow:0 20px 45px rgba(0,0,0,.07)}.featured-image{aspect-ratio:1.12;background:#ecebe7;display:flex;align-items:center;justify-content:center;overflow:hidden}.featured-image img{width:100%;height:100%;object-fit:contain;padding:10%;mix-blend-mode:multiply}.featured-copy{padding:17px 17px 20px}.featured-copy .model{font-size:9px;color:var(--brand-2);font-weight:900;letter-spacing:.12em}.featured-copy h3{font-size:18px;line-height:1.08;letter-spacing:-.025em;margin:6px 0 8px}.featured-copy p{font-size:12px;line-height:1.45;color:var(--muted);margin:0;min-height:52px}.featured-copy b{display:block;font-size:12px;margin-top:15px}
.family-band{background:#fff;padding-top:30px}.family-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#34383a}.family-tile{position:relative;min-height:240px;background:#151718;color:#fff;overflow:hidden}.family-art{position:absolute;inset:0;background:radial-gradient(circle at 70% 35%,rgba(28,154,168,.16),transparent 48%)}.family-img{position:absolute;object-fit:contain;filter:drop-shadow(0 15px 20px rgba(0,0,0,.35));opacity:.9}.fi1{right:2%;bottom:3%;width:56%;height:74%}.fi2{left:10%;top:14%;width:38%;height:50%;opacity:.55}.family-copy{position:absolute;left:22px;bottom:20px;z-index:2}.family-copy h3{font-size:22px;margin:0 0 6px}.family-copy span{font-size:11px;color:#b8c0c3}
.lighting-feature{background:#101213;color:#fff;padding:0}.lighting-feature-grid{display:grid;grid-template-columns:.88fr 1.12fr;min-height:580px}.lighting-copy{padding:76px 70px 70px 0;align-self:center}.lighting-copy .kicker{color:#78d7df}.lighting-copy h2{font-size:clamp(48px,5.3vw,72px);line-height:.96;letter-spacing:-.055em;margin:10px 0 24px}.lighting-copy p{font-size:18px;color:#c2c8ca;max-width:620px}.lighting-benefits{display:flex;flex-wrap:wrap;gap:8px;margin:30px 0}.lighting-benefits span{border:1px solid rgba(255,255,255,.2);padding:8px 10px;font-size:11px}.button.light{background:#fff;color:#111;border-color:#fff}.lighting-visual{position:relative;background:linear-gradient(135deg,#292926,#171a1b);overflow:hidden;border-left:1px solid rgba(255,255,255,.12)}.ceiling-lines{position:absolute;inset:10% 9% 32% 9%;perspective:600px}.ceiling-lines i{display:block;height:5px;background:#f7e6c3;box-shadow:0 0 16px rgba(255,231,184,.35);margin:10% 0;transform:rotate(-4deg)}.lighting-diagram{position:absolute;left:7%;right:7%;bottom:8%;display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr auto 1fr;align-items:center;gap:9px}.lighting-diagram div{background:rgba(255,255,255,.94);color:#111;padding:14px 10px;min-height:78px;display:flex;flex-direction:column;justify-content:center;text-align:center}.lighting-diagram b{font-size:12px}.lighting-diagram small{font-size:9px;color:#6c7274}.lighting-diagram em{font-style:normal;color:#7ddce3}
.catalogue{background:#fff}.catalogue-group{display:grid;grid-template-columns:260px 1fr;border-top:1px solid var(--line);padding:32px 0}.group-intro{padding-right:38px}.group-intro h3{font-size:27px;letter-spacing:-.035em;margin:0 0 9px}.group-intro p{font-size:12px;color:var(--muted);margin:0}.catalogue-list{border-top:1px solid var(--line)}.catalogue-row{display:grid;grid-template-columns:68px 210px 1fr 190px 24px;align-items:center;gap:15px;padding:11px 4px;border-bottom:1px solid var(--line);transition:background .16s ease}.catalogue-row:hover{background:#f4f4f0}.thumb{width:58px;height:58px;background:#edede9;display:grid;place-items:center}.thumb img{width:100%;height:100%;object-fit:contain;padding:7px;mix-blend-mode:multiply}.no-thumb span{font-size:9px;font-weight:900;color:#777}.row-name span{display:block;font-size:9px;color:var(--brand-2);font-weight:900;letter-spacing:.1em}.row-name strong{font-size:13px}.catalogue-row>p,.row-connect{font-size:11px;color:var(--muted);margin:0}.arrow{font-size:16px}.compare-block{background:#efefeb}.compare-grid{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line)}.compare-grid>a{padding:22px 20px 24px 0;border-bottom:1px solid var(--line)}.compare-grid>a+ a{padding-left:20px;border-left:1px solid var(--line)}.compare-grid span{font-size:9px;color:var(--brand-2);font-weight:900;text-transform:uppercase;letter-spacing:.11em}.compare-grid strong{display:block;font-size:15px;margin:7px 0}.compare-grid p{font-size:11px;color:var(--muted);min-height:50px}.compare-grid b{font-size:13px}.bluta-strip{background:#e6e6e1}.bluta-strip-grid{display:flex;justify-content:space-between;align-items:end;gap:60px}.bluta-strip h2{font-size:clamp(34px,4vw,52px);letter-spacing:-.045em;margin:8px 0 10px;max-width:800px}.bluta-strip p{color:var(--muted);max-width:760px}
@media(max-width:1100px){.product-hero-grid,.lighting-feature-grid{grid-template-columns:1fr}.product-hero-copy,.lighting-copy{padding-right:0}.showroom{border-left:0;border-top:1px solid var(--line);min-height:520px}.featured-grid{grid-template-columns:repeat(3,1fr)}.family-grid{grid-template-columns:repeat(2,1fr)}.lighting-visual{border-left:0;min-height:430px}.catalogue-group{grid-template-columns:1fr}.group-intro{padding:0 0 20px}.catalogue-row{grid-template-columns:64px 190px 1fr 22px}.row-connect{display:none}.compare-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:680px){.product-hero-copy{padding:52px 0}.product-hero-copy h1{font-size:49px}.showroom{min-height:390px}.showroom-product span{display:none}.featured-grid{grid-template-columns:1fr 1fr}.featured-copy p{min-height:0}.family-grid{grid-template-columns:1fr}.lighting-copy{padding:58px 0}.lighting-visual{min-height:370px}.lighting-diagram{grid-template-columns:1fr 1fr;bottom:5%}.lighting-diagram em{display:none}.catalogue-row{grid-template-columns:54px 1fr 20px}.catalogue-row>p,.row-connect{display:none}.compare-grid{grid-template-columns:1fr}.bluta-strip-grid,.compact-heading{align-items:flex-start;flex-direction:column}.shell{width:min(var(--max),calc(100% - 36px))}}
</style>