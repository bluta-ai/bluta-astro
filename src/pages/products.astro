---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products, comparisonGroups } from "../data/site";
const families = [...new Set(products.map((p) => p.family))];
const byFamily = families.map((family) => ({ family, items:products.filter((p)=>p.family===family) }));
---
<BaseLayout title="Products | Blutech Building IoT & AIoT" description="Explore Blutech connected-building hardware for privacy-preserving occupancy, environmental monitoring, water leakage, facility operations, gateways and smart building interfaces." canonicalPath="/products">
  <section class="page-hero product-catalogue-hero">
    <div class="shell">
      <div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Products</span></div>
      <div class="kicker">Blutech hardware</div>
      <h1>Products engineered<br/>for real buildings.</h1>
      <p>From a sensor hidden above a ceiling to a display used by thousands of visitors, each product has one job: make building information useful where it matters.</p>
      <nav class="family-jump" aria-label="Product families">
        {families.map((family)=><a href={`#${family.toLowerCase().replace(/[^a-z0-9]+/g,"-")}`}>{family}</a>)}
      </nav>
    </div>
  </section>

  {byFamily.map(({family,items},familyIndex)=><section class={familyIndex % 2 ? "catalogue-family catalogue-family-alt" : "catalogue-family"} id={family.toLowerCase().replace(/[^a-z0-9]+/g,"-")}>
    <div class="shell">
      <div class="catalogue-family-head">
        <div><div class="kicker">{String(familyIndex+1).padStart(2,"0")}</div><h2>{family}</h2></div>
        <p>{family === "Occupancy & Spatial" ? "Understand presence and activity while keeping privacy central to the sensing design." : family === "Display & Interface" ? "Put live building information in front of the people who need it." : family === "Facility Operations" ? "Connect physical events, service workflows and local control." : family === "Water & Environment" ? "Make water-risk conditions visible before they become larger operational problems." : family === "Environmental" ? "Turn environmental conditions into measurable building data and alerts." : family === "Connectivity" ? "Move field data reliably between distributed devices and the IP network." : "Simple sensing designed around the geometry of the door or lock."}</p>
      </div>
      <div class="product-grid product-grid-premium">
        {items.map((p)=><a class="product-card-premium" href={`/products/${p.slug}`}>
          <div class={`product-visual ${p.image ? "" : "product-visual-unresolved"}`}>
            {p.image ? <img src={p.image} alt={`${p.model} ${p.name}`} loading="lazy" width="800" height="600" /> : <div class="product-model-art" aria-hidden="true"><span>{p.model}</span></div>}
          </div>
          <div class="product-copy">
            <div class="model">{p.model}</div>
            <h3>{p.name}</h3>
            <p class="product-headline">{p.headline || p.summary}</p>
            <div class="product-meta-line">{p.connectivity?.slice(0,3).join(" · ")}</div>
            <span class="card-link">Explore {p.model} →</span>
          </div>
        </a>)}
      </div>
    </div>
  </section>)}

  <section class="comparison-section">
    <div class="shell">
      <div class="section-head"><div><div class="kicker">Compare</div><h2>Similar job. Different fit.</h2><p>Compare products that are commonly considered together before choosing around the actual site and workflow.</p></div><a class="button secondary" href="/products/compare">Open product comparisons</a></div>
      <div class="comparison-list">
        {comparisonGroups.map((group)=><a href={`/products/compare#${group.models.join("-").toLowerCase()}`} class="comparison-row"><span>{group.title}</span><strong>{group.models.join(" / ")}</strong><p>{group.note}</p><b>→</b></a>)}
      </div>
    </div>
  </section>

  <section class="bluta-minimal">
    <div class="shell split">
      <div><div class="kicker">From Blutech</div><h2>Meet BLUTA Fire.</h2><p class="hero-copy" style="font-size:19px">From Blutech comes BLUTA Fire — our dedicated fire & life-safety brand for connected fire-related products and systems.</p></div>
      <div class="bluta-link-wrap"><a class="button" href="https://bluta.io" target="_blank" rel="noopener">Discover BLUTA Fire ↗</a></div>
    </div>
  </section>
</BaseLayout>