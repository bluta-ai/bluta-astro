---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products, comparisonGroups } from "../data/site";

const byModel = Object.fromEntries(products.map((p) => [p.model, p]));
const featuredModels = ["BT338","BT337","BT306","BT102","BT339","BT2035","BT321","BT3022","BT3023"];
const featured = featuredModels.map((m)=>byModel[m]).filter((p)=>p?.image);
const groups = [
  { title:"Sense", note:"Occupancy, activity, environment, leakage and physical-state sensing.", models:["BT303","BT306","BT321","BT333","BT336","BT337","BT338","BT339","BT353"] },
  { title:"Control & respond", note:"Local inputs, outputs, alarms and visible status for building workflows.", models:["BT311","BT315","BT316","BT317","BT2035","BT3022","BT3023"] },
  { title:"Inform", note:"Turn live building data into information people can understand immediately.", models:["BT101","BT102","BT103","BT107"] },
  { title:"Connect", note:"Move field data between building devices and IP networks.", models:["BT802","BT803"] },
];
---
<BaseLayout title="Products | Blutech Building IoT & AIoT" description="Explore Blutech connected-building hardware and systems for occupancy, environmental monitoring, facility operations, smart lighting, displays and connectivity." canonicalPath="/products">
  <section class="products-hero">
    <div class="shell products-hero-grid">
      <div class="products-hero-copy">
        <div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Products</span></div>
        <div class="kicker">Blutech hardware & systems</div>
        <h1>Technology you can actually put in a building.</h1>
        <p>Purpose-built sensing, control, display and connectivity products — organised around what they do on site, not around a long catalogue of boxes.</p>
        <a class="text-link" href="#all-products">View all hardware ↓</a>
      </div>
      <div class="products-hero-stage" aria-label="Selected Blutech products">
        {featured.slice(0,4).map((p, i)=><a class={`hero-product hero-product-${i+1}`} href={`/products/${p.slug}`}>
          <img src={p.image} alt={`${p.model} ${p.name}`} width="700" height="560" loading={i<2?"eager":"lazy"}/>
          <span><b>{p.model}</b>{p.name}</span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="featured-products">
    <div class="shell">
      <div class="section-head"><div><div class="kicker">Selected hardware</div><h2>A few products worth seeing first.</h2><p>Large visuals for the products that best explain the Blutech approach. The complete hardware index is farther down the page.</p></div></div>
      <div class="feature-product-grid">
        {featured.map((p, i)=><a class={`feature-product ${i===0 ? "feature-product-lead" : ""}`} href={`/products/${p.slug}`}>
          <div class="feature-product-visual"><img src={p.image} alt={`${p.model} ${p.name}`} loading="lazy" width="1000" height="750"/></div>
          <div class="feature-product-copy"><div class="model">{p.model}</div><h3>{p.name}</h3><p>{p.headline || p.summary}</p><span>Explore →</span></div>
        </a>)}
      </div>
    </div>
  </section>

  <section class="lighting-system" id="smart-lighting">
    <div class="shell lighting-grid">
      <div class="lighting-copy">
        <div class="kicker">Building system</div>
        <h2>Wireless Smart Lighting Control</h2>
        <p class="lighting-lead">A retrofit-oriented control system that keeps immediate lighting response local while giving FM teams central schedules, parameters, monitoring and BMS integration.</p>
        <div class="lighting-points">
          <div><b>Local response</b><span>PIR and lux events can trigger assigned lighting logic over BLE without waiting for the cloud.</span></div>
          <div><b>0–10V output</b><span>Controllers drive compatible dimmable LED drivers for simple scene-based operation.</span></div>
          <div><b>Schedules & override</b><span>Daily/weekly schedules, time-outs, lux thresholds and manual override are centrally configurable.</span></div>
          <div><b>Resilient retrofit</b><span>Local sensor control continues during a network outage; gateway-stored schedules continue to execute locally.</span></div>
        </div>
        <div class="lighting-actions"><a class="button" href="/solutions/smart-lighting">Explore smart lighting</a><a class="text-link" href="/projects#three-garden-road">See Three Garden Road →</a></div>
      </div>
      <div class="lighting-architecture" aria-label="Wireless smart lighting architecture">
        <div class="arch-label">LOCAL CONTROL</div>
        <div class="arch-flow">
          <div class="arch-node"><b>PIR / Lux</b><span>Sense</span></div><i>→</i>
          <div class="arch-node"><b>BLE network</b><span>Communicate</span></div><i>→</i>
          <div class="arch-node"><b>Lighting controller</b><span>Decide</span></div><i>→</i>
          <div class="arch-node arch-dark"><b>0–10V driver</b><span>Act</span></div>
        </div>
        <div class="arch-divider"></div>
        <div class="arch-label">MANAGEMENT & INTEGRATION</div>
        <div class="arch-flow arch-flow-secondary">
          <div class="arch-node"><b>Gateway</b><span>Local schedules</span></div><i>→</i>
          <div class="arch-node"><b>4G uplink</b><span>Dedicated backhaul</span></div><i>→</i>
          <div class="arch-node"><b>Blutech platform</b><span>Monitor & configure</span></div><i>→</i>
          <div class="arch-node"><b>BMS / API</b><span>Integrate</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="all-products" id="all-products">
    <div class="shell">
      <div class="section-head"><div><div class="kicker">All hardware</div><h2>The complete current catalogue.</h2><p>The index stays intentionally compact: model, role and connectivity first. Open a product when you need the detail.</p></div></div>
      <div class="product-index">
        {groups.map((group)=><div class="product-index-group">
          <div class="product-index-heading"><h3>{group.title}</h3><p>{group.note}</p></div>
          <div class="product-index-list">
            {group.models.map((model)=>byModel[model]).filter(Boolean).map((p)=><a class="product-index-row" href={`/products/${p.slug}`}>
              <span class="index-model">{p.model}</span><strong>{p.name}</strong><span class="index-role">{p.summary}</span><span class="index-connect">{p.connectivity?.slice(0,3).join(" · ") || "Project-specific"}</span><b aria-hidden="true">→</b>
            </a>)}
          </div>
        </div>)}
      </div>
    </div>
  </section>

  <section class="comparison-section products-compare">
    <div class="shell">
      <div class="section-head"><div><div class="kicker">Compare</div><h2>Similar job. Different fit.</h2><p>Compare products that are commonly considered together before choosing around the actual site and workflow.</p></div><a class="button secondary" href="/products/compare">Open comparisons</a></div>
      <div class="comparison-list">
        {comparisonGroups.map((group)=><a href={`/products/compare#${group.models.join("-").toLowerCase()}`} class="comparison-row"><span>{group.title}</span><strong>{group.models.join(" / ")}</strong><p>{group.note}</p><b>→</b></a>)}
      </div>
    </div>
  </section>

  <section class="bluta-minimal">
    <div class="shell split"><div><div class="kicker">From Blutech</div><h2>Looking for fire products?</h2><p class="hero-copy" style="font-size:19px">BLUTA Fire is the dedicated fire & life-safety brand developed by the Blutech team. Fire-related products are kept in the BLUTA catalogue rather than mixed into the building-IoT hardware above.</p></div><div class="bluta-link-wrap"><a class="button" href="https://bluta.io" target="_blank" rel="noopener">Discover BLUTA Fire ↗</a></div></div>
  </section>
</BaseLayout>

<style>
  .products-hero{background:#fff;border-bottom:1px solid var(--line);padding:70px 0 0}.products-hero-grid{display:grid;grid-template-columns:.82fr 1.18fr;min-height:650px;align-items:stretch}.products-hero-copy{padding:36px 70px 80px 0;display:flex;flex-direction:column;justify-content:center}.products-hero h1{font-size:clamp(55px,6vw,88px);line-height:.94;letter-spacing:-.06em;margin:10px 0 25px;font-weight:750}.products-hero-copy>p{font-size:20px;color:var(--muted);max-width:650px}.text-link{font-size:14px;font-weight:800;border-bottom:1px solid currentColor;width:max-content;margin-top:18px}.products-hero-stage{position:relative;background:#f0f0ec;min-height:650px;overflow:hidden;border-left:1px solid var(--line)}.hero-product{position:absolute;background:#fff;border:1px solid rgba(17,19,21,.09);display:flex;align-items:center;justify-content:center;box-shadow:0 25px 70px rgba(0,0,0,.06);transition:transform .35s ease}.hero-product:hover{transform:translateY(-7px)}.hero-product img{width:100%;height:100%;object-fit:contain;padding:8%;mix-blend-mode:multiply}.hero-product span{position:absolute;left:16px;bottom:13px;font-size:11px;color:#4d555a}.hero-product span b{display:block;color:#111;margin-bottom:2px}.hero-product-1{width:42%;height:43%;left:8%;top:9%}.hero-product-2{width:37%;height:34%;right:6%;top:17%}.hero-product-3{width:34%;height:32%;left:16%;bottom:7%}.hero-product-4{width:41%;height:38%;right:7%;bottom:5%}
  .featured-products{background:var(--bg)}.feature-product-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:24px}.feature-product{grid-column:span 4;background:#fff;border:1px solid var(--line);display:flex;flex-direction:column}.feature-product-lead{grid-column:span 8}.feature-product-visual{aspect-ratio:1.25/1;background:#f0f0ec;overflow:hidden}.feature-product-lead .feature-product-visual{aspect-ratio:1.8/1}.feature-product-visual img{width:100%;height:100%;object-fit:contain;padding:7%;mix-blend-mode:multiply;transition:transform .45s ease}.feature-product:hover img{transform:scale(1.025)}.feature-product-copy{padding:22px 24px 26px}.feature-product-copy .model{font-size:10px;color:var(--brand-2);font-weight:900;letter-spacing:.14em}.feature-product-copy h3{font-size:26px;margin:7px 0 8px;letter-spacing:-.035em}.feature-product-copy p{margin:0;color:var(--muted)}.feature-product-copy span{display:inline-block;margin-top:16px;font-weight:800;font-size:13px;border-bottom:1px solid currentColor}
  .lighting-system{background:#111315;color:#fff}.lighting-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:75px;align-items:center}.lighting-system .kicker{color:#83dbe3}.lighting-copy h2{font-size:clamp(44px,5vw,70px);line-height:.98;letter-spacing:-.055em;margin:10px 0 22px}.lighting-lead{font-size:20px;color:#cbd0d2;max-width:650px}.lighting-points{display:grid;grid-template-columns:1fr 1fr;gap:22px 28px;margin-top:36px}.lighting-points div{border-top:1px solid rgba(255,255,255,.17);padding-top:14px}.lighting-points b,.lighting-points span{display:block}.lighting-points span{font-size:13px;color:#aeb5b8;margin-top:5px}.lighting-actions{display:flex;gap:22px;align-items:center;margin-top:34px;flex-wrap:wrap}.lighting-system .button{background:#fff;color:#111;border-color:#fff}.lighting-system .text-link{color:#fff;margin:0}.lighting-architecture{background:#1a1d20;border:1px solid rgba(255,255,255,.14);padding:34px}.arch-label{font-size:10px;letter-spacing:.16em;color:#87dbe3;font-weight:850}.arch-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:10px;align-items:center;margin:14px 0 0}.arch-flow i{font-style:normal;color:#667074}.arch-node{min-height:115px;padding:18px;border:1px solid rgba(255,255,255,.16);display:flex;flex-direction:column;justify-content:space-between}.arch-node b{font-size:16px}.arch-node span{font-size:11px;color:#9ea6aa}.arch-node.arch-dark{background:#fff;color:#111}.arch-node.arch-dark span{color:#555}.arch-divider{height:1px;background:rgba(255,255,255,.14);margin:34px 0}.arch-flow-secondary .arch-node{min-height:105px}
  .all-products{background:#fff}.product-index{border-top:1px solid var(--line)}.product-index-group{display:grid;grid-template-columns:270px 1fr;border-bottom:1px solid var(--line);padding:34px 0}.product-index-heading{padding-right:40px}.product-index-heading h3{font-size:30px;letter-spacing:-.04em;margin:0 0 8px}.product-index-heading p{color:var(--muted);font-size:13px}.product-index-list{border-top:1px solid var(--line)}.product-index-row{display:grid;grid-template-columns:76px 220px 1fr 190px 24px;gap:18px;align-items:center;border-bottom:1px solid var(--line);padding:16px 4px;transition:background .18s ease}.product-index-row:hover{background:#f5f5f1}.index-model{font-size:11px;color:var(--brand-2);font-weight:900;letter-spacing:.1em}.product-index-row strong{font-size:14px}.index-role,.index-connect{font-size:12px;color:var(--muted)}.products-compare{background:var(--bg-2)}
  @media(max-width:1000px){.products-hero-grid,.lighting-grid{grid-template-columns:1fr}.products-hero-copy{padding-right:0}.products-hero-stage{border-left:0;border-top:1px solid var(--line);min-height:520px}.feature-product,.feature-product-lead{grid-column:span 6}.product-index-group{grid-template-columns:1fr}.product-index-heading{padding:0 0 20px}.product-index-row{grid-template-columns:70px 190px 1fr 22px}.index-connect{display:none}.arch-flow{grid-template-columns:1fr 1fr}.arch-flow i{display:none}}
  @media(max-width:680px){.products-hero{padding-top:30px}.products-hero-grid{min-height:auto}.products-hero h1{font-size:50px}.products-hero-copy{padding:25px 0 50px}.products-hero-stage{min-height:430px}.feature-product,.feature-product-lead{grid-column:1/-1}.lighting-points{grid-template-columns:1fr}.arch-flow{grid-template-columns:1fr}.product-index-row{grid-template-columns:62px 1fr 22px}.index-role{display:none}.feature-product-grid{gap:14px}}
</style>