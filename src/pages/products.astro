---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products } from "../data/site";
import { getProductImage } from "../data/productMedia";
const families = [...new Set(products.map((p)=>p.family))];
---
<BaseLayout title="Building IoT Hardware Products | Blutech" description="Blutech building IoT products for smart washrooms, occupancy, safety, IAQ, water leakage, displays, lighting, controls and LoRaWAN connectivity." canonicalPath="/products">
  <section class="page-hero product-intro"><div class="shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Products</span></div><div class="kicker">Blutech hardware</div><h1>Commercial hardware with a clear job in the system.</h1><p>Every product page explains what the device enables, where it fits, how it connects and which details must be confirmed for the project.</p></div></section>
  <section class="catalogue"><div class="shell">
    <div class="catalogue-filter" aria-label="Product families"><a href="#all">All products</a>{families.map((family)=><a href={`#${family.toLowerCase().replaceAll(" ","-").replaceAll("&","and")}`}>{family}</a>)}</div>
    <div id="all" class="product-grid product-four">{products.map((p)=>{const image=getProductImage(p.model,p.image);return <a class="product-card" id={p.family.toLowerCase().replaceAll(" ","-").replaceAll("&","and")} href={`/products/${p.slug}`}><div class="product-image"><img src={image} alt={`${p.model} ${p.name}`} loading="lazy" /></div><div class="product-copy"><div class="model">{p.model} · {p.family}</div>{p.award && <span class="award-badge">iF DESIGN AWARD</span>}<h2>{p.name}</h2><p>{p.summary}</p><div class="protocols">{p.connectivity?.slice(0,3).map((c)=><span>{c}</span>)}</div><b>View product →</b></div></a>})}</div>
  </div></section>
  <section class="product-guidance"><div class="shell guidance-grid"><div><div class="kicker">Specification support</div><h2>Choose by outcome and site condition.</h2></div><div><p>Product selection depends on the room geometry, privacy requirement, response time, power, wireless coverage, network policy and integration boundary.</p><p>Blutech confirms mounting, communications, environmental rating and integration against the exact model and project configuration.</p><a class="button" href="/contact">Discuss a product schedule</a></div></div></section>
</BaseLayout>
<style>
.product-intro h1{font-size:clamp(46px,5vw,70px);max-width:980px}.catalogue{background:#f1f2ef}.catalogue-filter{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:26px}.catalogue-filter a{font-size:11px;border:1px solid var(--line);background:#fff;padding:8px 10px}.product-grid.product-four{grid-template-columns:repeat(4,minmax(0,1fr));gap:1px}.product-card{background:#fff;display:flex;flex-direction:column;min-height:100%}.product-image{aspect-ratio:4/3}.product-image img{padding:9%;object-fit:contain}.product-copy{padding:18px 19px 22px;display:flex;flex-direction:column;flex:1}.product-copy .model{margin:0}.product-copy h2{font-size:21px;line-height:1.08;letter-spacing:-.025em;margin:7px 0 9px}.product-copy p{font-size:12px;color:var(--muted);margin:0}.product-copy>b{font-size:12px;margin-top:auto;padding-top:22px}.award-badge{align-self:flex-start;color:#d71920;border:1px solid rgba(215,25,32,.35);font-size:8px;font-weight:900;letter-spacing:.08em;padding:4px 5px;margin-top:8px}.protocols{display:flex;flex-wrap:wrap;gap:5px;margin-top:14px}.protocols span{font-size:9px;background:#f1f2ef;padding:5px 6px}.product-guidance{background:#fff}.guidance-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px}.guidance-grid h2{font-size:clamp(36px,4vw,54px);line-height:1.03;letter-spacing:-.045em;margin:9px 0}.guidance-grid p{color:var(--muted)}.guidance-grid .button{margin-top:12px}
@media(max-width:1100px){.product-grid.product-four{grid-template-columns:repeat(3,1fr)}}@media(max-width:820px){.product-grid.product-four{grid-template-columns:repeat(2,1fr)}.guidance-grid{grid-template-columns:1fr;gap:28px}}@media(max-width:520px){.product-grid.product-four{grid-template-columns:1fr}}
</style>
