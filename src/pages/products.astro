---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products } from "../data/site";
const families = [...new Set(products.map((p) => p.family))];
---
<BaseLayout title="Products | Blutech Building IoT & AIoT" description="Explore Blutech connected-building hardware: privacy-preserving occupancy sensors, IAQ, water leakage, smart bin, edge I/O, gateways, signage and status devices." canonicalPath="/products">
  <section class="page-hero"><div class="shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Products</span></div><div class="kicker">Hardware</div><h1>Connected building products.</h1><p>Only products that Blutech currently supports or has commercially deployed are presented here. Project-specific revisions, discontinued concepts and BLUTA fire products are kept separate.</p></div></section>
  <section><div class="shell"><div class="section-head"><div><div class="kicker">Catalogue</div><h2>From sensing to action.</h2><p>{products.length} current or proven products across {families.length} product families.</p></div></div><div class="tag-row" style="margin-bottom:26px">{families.map((f) => <span class="tag">{f}</span>)}</div><div class="product-grid">{products.map((p) => <a class="card product-card" href={`/products/${p.slug}`}>{p.image && <div class="product-image"><img src={p.image} alt={`${p.model} ${p.name}`} loading="lazy" width="720" height="540" /></div>}<div class="model">{p.model} · {p.family}</div><h3>{p.name}</h3><p>{p.summary}</p><div class="tag-row">{p.connectivity?.slice(0,3).map((c) => <span class="tag">{c}</span>)}</div><span class="card-link">View product →</span></a>)}</div></div></section>
  <section style="background:var(--bg-2)"><div class="shell split"><div><div class="kicker">Fire products</div><h2>Looking for BLUTA Fire?</h2><p class="hero-copy" style="font-size:19px">Fire-related detection and life-safety products are intentionally separated from the general Blutech catalogue. BLUTA Fire is the dedicated fire & life-safety brand developed by Blutech.</p><a class="button" href="https://bluta.io" target="_blank" rel="noopener">Visit BLUTA Fire ↗</a></div><div class="panel"><h3>Why separate the catalogues?</h3><p class="muted">Fire products carry their own certification, approval and responsibility requirements. Separating them keeps product scope and evidence clear for customers, consultants and regulators.</p></div></div></section>
</BaseLayout>
