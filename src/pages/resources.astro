---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resources } from "../data/resources";
---
<BaseLayout title="Resources | Blutech Building IoT Guides" description="Practical Blutech guides on privacy-preserving fall detection, smart washrooms, LoRaWAN building monitoring and water leakage detection." canonicalPath="/resources">
  <section class="page-hero"><div class="shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Resources</span></div><div class="kicker">Knowledge</div><h1>Useful answers before a tender, pilot or retrofit.</h1><p>Practical notes for FM teams, consultants and integrators. The goal is to explain design choices and limitations clearly—not to manufacture keyword pages.</p></div></section>
  <section><div class="shell"><div class="resource-list">{resources.map((r)=><a class="resource-row" href={`/resources/${r.slug}`}><div class="type">{r.type}</div><div><h2 style="font-size:25px;margin:0 0 4px">{r.title}</h2><p class="muted" style="margin:0">{r.description}</p></div><strong>Read →</strong></a>)}</div></div></section>
  <section style="background:var(--bg-2)"><div class="shell split"><div><div class="kicker">For consultants & clients</div><h2>Need a technical answer that is not here?</h2><p class="hero-copy" style="font-size:19px">Ask us for product specifications, architecture input, RF/site-survey planning or integration information. Where a claim depends on a project-specific certificate or test, we will say so.</p></div><div class="panel"><h3>Planned resource library</h3><ul class="feature-list"><li>Product datasheets and verified downloads</li><li>Installation and coverage guides</li><li>Integration and API notes</li><li>Case studies with confirmed scope</li><li>Consultant-ready architecture references</li></ul></div></div></section>
</BaseLayout>
