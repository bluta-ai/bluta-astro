---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/site";
const tgr = projects.find((p)=>p.slug === "three-garden-road");
const otherProjects = projects.filter((p)=>p.slug !== "three-garden-road");
---
<BaseLayout title="Projects | Blutech IoT Deployments" description="Selected Blutech building IoT and AIoT deployments across premium commercial buildings, hospitals, government facilities and transport infrastructure." canonicalPath="/projects">
  <section class="projects-hero"><div class="shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Projects</span></div><div class="kicker">Selected deployments</div><h1>Built for the places where details matter.</h1><p>Blutech technology operating across commercial property, transport, government and healthcare — designed around the building, the people using it and the realities of installation.</p></div></section>

  {tgr && <section class="featured-project" id="three-garden-road"><div class="shell">
    <div class="feature-title"><div><div class="kicker">Featured deployment · Commercial</div><h2>Three Garden Road</h2></div><p>A large phased smart-washroom deployment using privacy-preserving sensing, connected facility data and analytics across a premium Grade A commercial property.</p></div>
    <div class="feature-image"><img src={tgr.image} alt="Three Garden Road" width="1600" height="900" loading="eager"/><div class="image-caption"><span>Three Garden Road · Central, Hong Kong</span><b>Technology integrated around the building, not imposed on it.</b></div></div>
    <div class="proof-strip"><div><strong>≈300</strong><span>Cubicles in the referenced phased deployment</span></div><div><strong>≈300</strong><span>Sensors across the deployment</span></div><div><strong>Multi-area</strong><span>Long-term commercial building operation</span></div><div><strong>Privacy-first</strong><span>Sensing selected for sensitive spaces</span></div></div>
    <div class="feature-story"><div><div class="kicker">The building context</div><h3>A discreet technology layer for a premium workplace.</h3></div><div class="story-copy"><p>Smart-building hardware in a finished commercial property has to work without making the space feel like a laboratory. Blutech's role combines sensing, wireless connectivity, data handling and operational visibility while respecting privacy-sensitive washroom environments.</p><p>The deployment demonstrates the kind of work that matters to landlords and facility teams: phased rollout, many distributed endpoints, practical commissioning and a system that remains useful after installation day.</p></div></div>
    <div class="feature-capabilities"><div><span>01</span><h4>Privacy-preserving sensing</h4><p>Occupancy and safety information without relying on conventional identifiable video inside sensitive spaces.</p></div><div><span>02</span><h4>Connected operations</h4><p>Distributed devices and building information brought into a manageable operational layer.</p></div><div><span>03</span><h4>Phased deployment</h4><p>Technology introduced across a live commercial environment rather than treated as a one-room demonstration.</p></div><div><span>04</span><h4>Analytics & visibility</h4><p>Facility data made available for operational review and ongoing management.</p></div></div>
  </div></section>}

  <section class="project-portfolio"><div class="shell"><div class="portfolio-heading"><div><div class="kicker">Selected portfolio</div><h2>Different buildings demand different technology.</h2><p>Network constraints, privacy, ceiling conditions, public traffic, operational workflow and integration boundaries all change the right solution.</p></div></div><div class="project-grid">{otherProjects.map((p,i)=><article class={`project-card ${i===0?"project-wide":""}`} id={p.slug}><div class="project-image"><img src={p.image} alt={`${p.title} Blutech deployment`} loading="lazy" width="1200" height="800"/></div><div class="project-copy"><div class="meta">{p.category}</div><h3>{p.title}</h3><p>{p.summary}</p></div></article>)}</div></div></section>

  <section class="project-principles"><div class="shell principle-grid"><div><div class="kicker">For architects & asset owners</div><h2>Good building technology should feel intentional.</h2></div><div class="principles"><div><b>Discreet hardware</b><p>Device selection and positioning considered alongside the architecture and user experience.</p></div><div><b>Retrofit aware</b><p>Wireless and edge-control options reduce unnecessary disruption where the building is already finished.</p></div><div><b>Integration ready</b><p>Gateways, APIs and building-system interfaces planned as part of the system rather than added at the end.</p></div><div><b>Operationally useful</b><p>The final output has to help FM teams monitor, respond and manage — not simply create more data.</p></div></div></div></section>

  <section class="project-cta"><div class="shell cta-grid"><div><div class="kicker">Planning a project?</div><h2>Start with the building constraints.</h2><p>Send us the floorplan, operational requirement, network boundary and installation conditions. We can work backwards to the right sensing, control and software architecture.</p></div><a class="button" href="/contact">Discuss a building</a></div></section>
</BaseLayout>

<style>
.projects-hero{background:#fff;padding:86px 0 76px;border-bottom:1px solid var(--line)}.projects-hero h1{font-size:clamp(54px,6vw,86px);max-width:990px;line-height:.95;letter-spacing:-.06em;margin:11px 0 25px}.projects-hero p{font-size:20px;max-width:800px;color:var(--muted);margin:0}.featured-project{background:#f7f7f4;padding-top:92px}.feature-title{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:end;margin-bottom:38px}.feature-title h2{font-size:clamp(50px,6vw,82px);line-height:.95;letter-spacing:-.055em;margin:9px 0 0}.feature-title p{font-size:18px;color:var(--muted);margin:0}.feature-image{height:min(62vw,720px);position:relative;overflow:hidden;background:#ddd}.feature-image>img{width:100%;height:100%;object-fit:cover}.image-caption{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(transparent,rgba(12,14,15,.82));color:#fff;padding:80px 28px 25px}.image-caption span,.image-caption b{display:block}.image-caption span{font-size:10px;letter-spacing:.12em;color:#c5cbcd;text-transform:uppercase}.image-caption b{font-size:18px;margin-top:5px}.proof-strip{display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border:1px solid var(--line);border-top:0}.proof-strip>div{padding:24px 23px}.proof-strip>div+div{border-left:1px solid var(--line)}.proof-strip strong,.proof-strip span{display:block}.proof-strip strong{font-size:29px;letter-spacing:-.04em}.proof-strip span{font-size:11px;color:var(--muted);margin-top:4px}.feature-story{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px;padding:90px 0 65px}.feature-story h3{font-size:clamp(40px,4.8vw,62px);line-height:1;letter-spacing:-.05em;margin:9px 0}.story-copy{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:start}.story-copy p{font-size:15px;color:var(--muted);margin:0}.feature-capabilities{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.feature-capabilities>div{padding:25px 24px 25px 0;border-bottom:1px solid var(--line)}.feature-capabilities>div+div{padding-left:24px;border-left:1px solid var(--line)}.feature-capabilities span{font-size:9px;color:var(--brand-2);font-weight:900}.feature-capabilities h4{font-size:20px;margin:8px 0}.feature-capabilities p{font-size:12px;color:var(--muted);margin:0}.project-portfolio{background:#fff}.portfolio-heading h2{font-size:clamp(41px,5vw,66px);line-height:1;letter-spacing:-.05em;margin:9px 0 14px;max-width:900px}.portfolio-heading p{font-size:16px;color:var(--muted);max-width:730px}.project-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:55px 28px;margin-top:42px}.project-card{border-top:1px solid var(--line);padding-top:14px}.project-wide{grid-column:1/-1;display:grid;grid-template-columns:1.35fr .65fr;gap:32px;align-items:end}.project-image{overflow:hidden;background:#e9e9e5}.project-image img{width:100%;aspect-ratio:16/10;object-fit:cover;transition:transform .35s ease}.project-card:hover img{transform:scale(1.015)}.project-wide .project-image img{aspect-ratio:16/8}.project-copy{padding-top:16px}.project-wide .project-copy{padding-bottom:8px}.meta{font-size:9px;color:var(--brand-2);text-transform:uppercase;letter-spacing:.13em;font-weight:900}.project-copy h3{font-size:29px;letter-spacing:-.04em;margin:7px 0 9px}.project-copy p{font-size:13px;color:var(--muted);margin:0}.project-principles{background:#efefeb}.principle-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px}.principle-grid h2{font-size:clamp(40px,4.8vw,62px);line-height:1;letter-spacing:-.05em;margin:9px 0}.principles{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}.principles>div{padding:22px 22px 15px 0;border-bottom:1px solid var(--line)}.principles>div:nth-child(even){padding-left:22px;border-left:1px solid var(--line)}.principles b{font-size:16px}.principles p{font-size:12px;color:var(--muted)}.project-cta{background:#151718;color:#fff}.cta-grid{display:flex;justify-content:space-between;align-items:end;gap:60px}.project-cta .kicker{color:#78d7df}.project-cta h2{font-size:clamp(40px,5vw,66px);line-height:1;letter-spacing:-.05em;margin:9px 0 13px}.project-cta p{color:#b9c0c2;max-width:700px}.project-cta .button{background:#fff;color:#111;border-color:#fff}
@media(max-width:900px){.feature-title,.feature-story,.principle-grid{grid-template-columns:1fr}.story-copy{grid-template-columns:1fr}.proof-strip,.feature-capabilities{grid-template-columns:1fr 1fr}.project-wide{grid-template-columns:1fr}.cta-grid{align-items:flex-start;flex-direction:column}}
@media(max-width:600px){.projects-hero{padding:58px 0 52px}.projects-hero h1{font-size:49px}.featured-project{padding-top:62px}.feature-image{min-height:340px}.proof-strip,.feature-capabilities,.project-grid,.principles{grid-template-columns:1fr}.proof-strip>div+div,.feature-capabilities>div+div,.principles>div:nth-child(even){border-left:0;padding-left:23px}.project-wide{grid-column:auto}.feature-story{padding:60px 0 45px}.shell{width:min(var(--max),calc(100% - 36px))}}
</style>