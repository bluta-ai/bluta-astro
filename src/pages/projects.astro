---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---
<BaseLayout title="Building IoT Projects | Blutech" description="Blutech case studies across commercial buildings, airports, government facilities, hospitals, rail and retail — with confirmed scope and practical outcomes." canonicalPath="/projects">
  <section class="page-hero projects-intro"><div class="shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Projects</span></div><div class="kicker">Selected deployments</div><h1>What Blutech delivered — and why it matters.</h1><p>Real projects explained through confirmed scope, operational benefits and the evidence a property owner, operator, architect or consultant needs to evaluate.</p></div></section>
  <section class="project-index"><div class="shell project-grid project-three">
    {projects.map((p)=><a class="project-card" href={`/projects/${p.slug}`}><div class="project-image"><img src={p.image} alt={`${p.title} exterior`} loading="lazy" /></div><div class="project-copy"><div class="meta">{p.category} · {p.location}</div><h2>{p.title}</h2><p>{p.outcome}</p><div class="project-kpis">{p.kpis.map((k)=><span><b>{k.value}</b>{k.label}</span>)}</div><i>View case study →</i></div></a>)}
  </div></section>
  <section class="project-directory-cta"><div class="shell cta-panel"><div><div class="kicker">Wider deployment network</div><h2>More than a set of featured stories.</h2><p>Explore the wider list of commercial, healthcare, public, transport and hospitality sites where Blutech technology has been deployed.</p></div><a class="button" href="/company#deployments">View deployment sites</a></div></section>
</BaseLayout>
<style>
.projects-intro h1{font-size:clamp(46px,5vw,70px);max-width:1000px}.project-index{background:#f2f3f0}.project-grid.project-three{grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.project-card{background:#fff;border:1px solid var(--line);display:flex;flex-direction:column}.project-image img{aspect-ratio:16/10}.project-copy{padding:20px;display:flex;flex-direction:column;flex:1}.project-copy h2{font-size:clamp(25px,2vw,34px);line-height:1.05;letter-spacing:-.035em;margin:8px 0 11px}.project-copy p{font-size:13px;color:var(--muted);margin:0}.project-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;border-top:1px solid var(--line);padding-top:15px;margin-top:20px}.project-kpis span{font-size:9px;line-height:1.3;color:var(--muted)}.project-kpis b{display:block;font-size:14px;color:var(--ink);margin-bottom:3px}.project-copy i{font-style:normal;font-size:12px;font-weight:850;margin-top:22px}.project-directory-cta{background:#fff}.cta-panel{border:1px solid var(--line);padding:40px;display:flex;align-items:end;justify-content:space-between;gap:50px}.cta-panel h2{font-size:clamp(34px,3.8vw,52px);line-height:1;letter-spacing:-.04em;margin:9px 0}.cta-panel p{color:var(--muted);max-width:760px}
@media(max-width:1050px){.project-grid.project-three{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.project-grid.project-three{grid-template-columns:1fr}.cta-panel{display:block;padding:26px}.cta-panel .button{margin-top:18px}}
</style>
