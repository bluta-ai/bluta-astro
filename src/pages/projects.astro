astro
---
import "../styles/global.css";
import { Image } from "astro:assets";

// Import images
import project1 from "../assets/bluta-project1.webp";
import project2 from "../assets/bluta-project2.webp";
---

<!doctype html>
<html lang="en">
<head>
  <title>Our Projects | BLUTA</title>
  <meta name="description" content="Successful BLUTA projects across Qatar and GCC - building automation and smart energy control case studies." />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b1020" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700;800&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0b1020; --panel:#121a2e; --ink:#e5e7eb; --muted:#9aa3b2;
      --line:#1f2a44; --brand:#00C3D8; --brand2:#a78bfa; --nav-h:68px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:linear-gradient(180deg,#0a0f1f 0%,#0b1020 18%,#0b1020 100%);color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial}
    a{color:var(--ink);text-decoration:none}
    .container{max-width:1200px;margin:0 auto;padding:0 20px}

    /* NAV */
    .nav{position:sticky;top:0;z-index:50;height:var(--nav-h);backdrop-filter:saturate(1.2) blur(8px);background:rgba(10,14,28,.7);border-bottom:1px solid var(--line)}
    .nav-inner{display:flex;gap:16px;align-items:center;justify-content:space-between;height:100%}
    .brand{display:flex;gap:10px;align-items:center;font-weight:800;font-family:'Comfortaa', ui-sans-serif, system-ui}
    .wordmark{font-weight:800;font-size:24px;letter-spacing:.2px;text-transform:lowercase}
    .wordmark .blu{color:var(--brand)}
    .wordmark .ta{color:#fff}
    .nav-links{display:flex;align-items:center;gap:10px}
    .nav-links a{display:inline-block;padding:10px 12px;border-radius:10px;font-weight:700;color:#dbe3f3}
    .nav-links a:hover{background:rgba(255,255,255,.06)}
    .nav-links a.active{background:rgba(255,255,255,.1)}

    /* Language Switcher */
    .language-switcher {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-left: 20px;
      padding-left: 20px;
      border-left: 1px solid var(--line);
    }
    .language-switcher a {
      text-decoration: none;
      color: #9aa3b2;
      font-weight: 600;
      font-size: 14px;
      padding: 4px 8px;
      border-radius: 6px;
    }
    .language-switcher a:hover {
      color: #00C3D8;
      background: rgba(255,255,255,0.05);
    }

    /* LAYOUT */
    section{padding:80px 0}
    .grid{display:grid;gap:30px}
    .col-2{grid-template-columns:1fr 1fr}
    .col-3{grid-template-columns:repeat(3,1fr)}
    @media(max-width:980px){.col-2,.col-3{grid-template-columns:1fr}}
    .card{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));border:1px solid var(--line);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.25);transition:transform 0.3s ease}
    .card:hover{transform:translateY(-5px)}
    .p-6{padding:24px}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:12px;font-weight:800;border:1px solid var(--line);background:rgba(255,255,255,.04);cursor:pointer;transition:all 0.3s ease}
    .btn.primary{background:linear-gradient(120deg,var(--brand),var(--brand2));color:#0b1020;border-color:transparent}
    .btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(0,195,216,0.3)}
    .subtitle{color:var(--muted);font-size:20px;text-align:center;max-width:900px;margin:0px auto 0;line-height:1.6}
    .h1{font-size:clamp(32px,4vw,56px);line-height:1.1;margin:10px 0;text-align:center;font-weight:900}
    .h2{font-size:36px;margin:0 0 16px;font-weight:800}
    .h3{font-size:24px;margin:0 0 12px;font-weight:700}
    .pill{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;background:rgba(96,165,250,.12);color:#c7d2fe;font-weight:800;font-size:14px;border:1px solid var(--line)}
    .muted{color:var(--muted);line-height:1.6}

    .image{overflow:hidden;border-radius:16px;border:1px solid var(--line);background:#050814}
    .image img, .image picture{display:block;width:100%;height:100%;object-fit:cover;transition:transform 0.3s ease}
    .image:hover img{transform:scale(1.05)}

    .project-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin:40px 0}
    @media(max-width:768px){.project-stats{grid-template-columns:repeat(2,1fr)}}
    .stat-box{text-align:center;padding:20px}
    .stat-number{font-size:36px;font-weight:900;color:var(--brand);margin-bottom:8px}
    .stat-label{color:var(--muted);font-size:14px;font-weight:600}
  </style>
</head>

<body>
  <!-- NAV -->
  <div class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand" aria-label="bluta home">
        <span class="wordmark"><span class="blu">blu</span><span class="ta">ta</span></span>
      </a>
      <div class="nav-links">
        <a href="/" data-nav="home">Home</a>
        <a href="/solutions" data-nav="solutions">Solutions</a>
        <a href="/hardware" data-nav="hardware">Hardware</a>
        <a href="/projects" data-nav="projects" class="active">Projects</a>
        <a href="/#contact" data-nav="contact">Contact</a>
        <div class="language-switcher">
          <a href="/">EN</a>
          <span>|</span>
          <a href="/ar/projects">AR</a>
        </div>
      </div>
    </div>
  </div>

  <!-- HERO SECTION -->
  <section>
    <div class="container">
      <div style="text-align:center">
        <span class="pill">Our Success in the Gulf Region</span>
        <h1 class="h1">BLUTA Success Stories<br>Across the Region</h1>
        <p class="subtitle">
          Discover how BLUTA solutions have transformed building operations and achieved significant cost savings across the GCC
        </p>
      </div>
    </div>
  </section>

  <!-- PROJECT STATS -->
  <section>
    <div class="container">
      <div class="project-stats">
        <div class="stat-box">
          <div class="stat-number">50+</div>
          <div class="stat-label">Projects Completed</div>
        </div>
        <div class="stat-box">
          <div class="stat-number">35%</div>
          <div class="stat-label">Average Energy Savings</div>
        </div>
        <div class="stat-box">
          <div class="stat-number">98%</div>
          <div class="stat-label">Client Satisfaction</div>
        </div>
        <div class="stat-box">
          <div class="stat-number">24/7</div>
          <div class="stat-label">Arabic Technical Support</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section>
    <div class="container">
      <div class="h2" style="text-align:center">Featured Projects</div>
      
      <div class="grid col-2" style="margin-top:40px">
        <!-- Project 1 -->
        <div class="card" style="overflow:hidden">
          <div class="image" style="height:300px">
            <div style="display:flex;align-items:center;justify-content:center;height:100%;background:linear-gradient(135deg,#121a2e,#1f2a44);color:var(--muted);font-size:18px">
              Doha Shopping Mall Project
            </div>
          </div>
          <div class="p-6">
            <span class="pill">Shopping Mall - Doha</span>
            <h3>Modern Shopping Complex</h3>
            <p class="muted">Comprehensive automation for an 85,000 sqm shopping mall in the heart of Doha.</p>
            <div style="margin-top:20px">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:15px">
                <div><strong>Achieved Savings:</strong></div>
                <div>28% in energy consumption</div>
                <div><strong>Implementation Time:</strong></div>
                <div>6 weeks</div>
                <div><strong>Integrations:</strong></div>
                <div>HVAC systems, CCTV, parking</div>
              </div>
              <p class="muted">Installed 120 sensors for air quality and occupancy monitoring, improving shopper experience and reducing operational costs.</p>
            </div>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="card" style="overflow:hidden">
          <div class="image" style="height:300px">
            <div style="display:flex;align-items:center;justify-content:center;height:100%;background:linear-gradient(135deg,#1f2a44,#121a2e);color:var(--muted);font-size:18px">
              Abu Dhabi Office Tower Project
            </div>
          </div>
          <div class="p-6">
            <span class="pill">Office Tower - Abu Dhabi</span>
            <h3>International Business Tower</h3>
            <p class="muted">Smart building management system for a 40-story office tower in Abu Dhabi.</p>
            <div style="margin-top:20px">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:15px">
                <div><strong>Achieved Savings:</strong></div>
                <div>32% in operational costs</div>
                <div><strong>Implementation Time:</strong></div>
                <div>8 weeks</div>
                <div><strong>Integrations:</strong></div>
                <div>Elevators, access control, energy</div>
              </div>
              <p class="muted">Improved energy efficiency and tenant experience through smart control of HVAC and lighting based on occupancy patterns.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- MORE PROJECTS -->
      <div class="grid col-3" style="margin-top:40px">
        <div class="card p-6">
          <span class="pill">Hospital - Riyadh</span>
          <h4>Specialized Medical Complex</h4>
          <p class="muted">Air quality and occupancy monitoring system for critical areas in the hospital.</p>
          <div style="margin-top:15px">
            <div style="color:var(--brand);font-weight:700">22% energy savings</div>
            <div class="muted" style="font-size:12px;margin-top:5px">Improved air quality in operating rooms and ICUs</div>
          </div>
        </div>

        <div class="card p-6">
          <span class="pill">Hotel - Dubai</span>
          <h4>Five-Star Resort</h4>
          <p class="muted">Room and public area automation to enhance guest experience and reduce waste.</p>
          <div style="margin-top:15px">
            <div style="color:var(--brand);font-weight:700">40% labor reduction</div>
            <div class="muted" style="font-size:12px;margin-top:5px">Automated maintenance and cleaning operations</div>
          </div>
        </div>

        <div class="card p-6">
          <span class="pill">University - Muscat</span>
          <h4>Smart Campus</h4>
          <p class="muted">Energy and occupancy management across 15 buildings in the university campus.</p>
          <div style="margin-top:15px">
            <div style="color:var(--brand);font-weight:700">25% energy savings</div>
            <div class="muted" style="font-size:12px;margin-top:5px">Improved comfort for students and staff</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SUCCESS STORIES -->
  <section style="background:linear-gradient(135deg,rgba(0,195,216,0.05),rgba(167,139,250,0.05))">
    <div class="container">
      <div class="h2" style="text-align:center">Client Success Stories</div>
      <div class="grid col-2" style="margin-top:40px">
        <div class="card p-6">
          <div style="display:flex;align-items:center;gap:15px;margin-bottom:20px">
            <div style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,var(--brand),var(--brand2));display:flex;align-items:center;justify-content:center;color:white;font-weight:800">A.S</div>
            <div>
              <div style="font-weight:800">Engineer Ahmed Al-Sayed</div>
              <div class="muted">Facilities Manager - Real Estate Group</div>
            </div>
          </div>
          <p class="muted">"BLUTA transformed how we manage buildings. It saved us over 30% in energy costs and reduced tenant complaints by 60%. The Arabic support was crucial for our team."</p>
        </div>

        <div class="card p-6">
          <div style="display:flex;align-items:center;gap:15px;margin-bottom:20px">
            <div style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,var(--brand2),var(--brand));display:flex;align-items:center;justify-content:center;color:white;font-weight:800">M.K</div>
            <div>
              <div style="font-weight:800">Dr. Mona Al-Khalifi</div>
              <div class="muted">Hospital Director - Healthcare Sector</div>
            </div>
          </div>
          <p class="muted">"The solution maintained patient and staff privacy while providing accurate data that helped us improve resource allocation. The Arabic interface made training quick and effective."</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section>
    <div class="container">
      <div class="card p-6" style="background:linear-gradient(135deg,rgba(167,139,250,.15),rgba(0,195,216,.15));text-align:center">
        <h2>Make Your Next Project a Success Story</h2>
        <p class="muted" style="max-width:600px;margin:20px auto">Join our list of satisfied clients in the GCC region. Let's discuss how BLUTA can transform your building.</p>
        <div style="margin-top:30px;display:flex;gap:15px;flex-wrap:wrap;justify-content:center">
          <a class="btn primary" href="/#contact">Start Your Project</a>
          <a class="btn" href="/solutions">Explore Solutions</a>
        </div>
      </div>
    </div>
  </section>

</body>
</html>