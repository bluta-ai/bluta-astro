---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/site";
---
<BaseLayout title="Projects | Blutech IoT Deployments" description="Selected Blutech building IoT and AIoT deployments across commercial buildings, hospitals, government facilities and transport infrastructure." canonicalPath="/projects">
  <section class="page-hero"><div class="shell"><div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Projects</span></div><div class="kicker">Selected deployments</div><h1>Real buildings. Real operating conditions.</h1><p>We publish project references conservatively: what was actually deployed, where disclosure is appropriate, without inventing performance figures or expanding a project beyond the verified scope.</p></div></section>
  <section><div class="shell"><div class="project-grid">{projects.map((p)=><article class="card project-card" id={p.slug}><img src={p.image} alt={`${p.title} Blutech deployment`} loading="lazy" width="1100" height="619"/><div class="card-body"><div class="meta">{p.category}</div><h2 style="font-size:32px;margin:8px 0 12px">{p.title}</h2><p>{p.summary}</p><div class="tag-row"><span class="tag">Connected sensing</span><span class="tag">Software / monitoring</span><span class="tag">Site commissioning</span></div></div></article>)}</div></div></section>
  <section style="background:var(--bg-2)"><div class="shell split"><div><div class="kicker">Evidence-first references</div><h2>What we will not do.</h2><p class="hero-copy" style="font-size:19px">We do not publish a savings percentage, device quantity, certification claim or customer outcome simply because it sounds good. Project pages are expanded only when the supporting source and disclosure position are clear.</p></div><div class="panel"><h3>Case-study publication standard</h3><ul class="feature-list"><li>Confirmed customer/site name</li><li>Confirmed Blutech scope and products</li><li>Real project photography where permitted</li><li>Verified scale or quantity before publishing</li><li>Outcome statements only when evidence supports them</li></ul></div></div></section>
  <section><div class="shell panel"><div class="section-head" style="margin-bottom:0"><div><div class="kicker">Planning a deployment?</div><h2>Bring us the building constraints.</h2><p>Existing network, ceiling height, privacy requirements, installation windows and integration boundaries matter as much as the sensor specification.</p></div><a class="button" href="/contact">Discuss a site</a></div></div></section>
</BaseLayout>
